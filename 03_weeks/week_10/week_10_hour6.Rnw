%  Java 10 · Ora 6 — Rast studimi: garancia në një kontratë unit-linked
% ============================================================
\section{Rast studimi}

\begin{frame}{Ora 6 · Rast studimi}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

<<w10h6-setup, include=FALSE>>=
hld6 <- read.csv(file.path(DATA, "albania_lifetables_HLD_1950_2011.csv"), check.names = FALSE)
h11  <- subset(hld6, Year1 == 2011)
mt6  <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
@

% ------------------------------------------------------------
\subsection{Kontrata}
% ------------------------------------------------------------

\begin{frame}{Kontrata ``Fondi Jetë''}
  \begin{itemize}
    \item<1-> Një burrë 45 vjeç paguan një prim të vetëm $P=1\,000\,000$ lekë.
    \item<2-> Primi investohet në një fond aksionesh (aksioni sintetik i Javëve 8--10).
    \item<3-> Kompania mban një tarifë administrimi $m=1\%$ në vit nga fondi.
    \item<4-> Në $T=10$ vjet, nëse klienti është gjallë: merr $\max(F_T,\,P)$.
  \end{itemize}
  \onslide<5->{
  \begin{Shembull}[(pyetja e rastit)]
    ``Sa vlen sot garancia që kompania i ka dhënë klientit? Dhe sa i ndjeshëm është ky numër?''
  \end{Shembull}}
  \onslide<6->{\small Kontratë ilustruese, kompani fiktive. Vdekshmëria: tabela reale HLD 2011 (M) dhe tabela sintetike.}
\end{frame}

\begin{frame}{Struktura e pagesës}
  \[
    \max(F_T,P)=F_T+\underbrace{(P-F_T)^+}_{\text{garancia}},\qquad
    F_T=P\,e^{-mT}\,\frac{S_T}{S_0}
  \]
  \pause
  \begin{itemize}
    \item Garancia = një put mbi fondin, me $K=P$, që paguhet \textbf{vetëm nëse klienti është gjallë}.
    \item Tarifa $m$ vepron si dividend i vazhdueshëm: \texttt{d = m} në \texttt{bsput()} (Ora 2).
  \end{itemize}
  \pause
  \begin{Teoreme}[(GMMB)]
    Nëse vdekshmëria është e pavarur nga tregu:
    \quad $V_{\text{GMMB}}={}_Tp_x\cdot P^{\text{put}}(F_0=P,\,K=P,\,\sigma,\,r,\,T,\,\delta=m)$.
  \end{Teoreme}
\end{frame}

\begin{frame}{Plani në katër hapa}
  \centering
  \begin{tikzpicture}[>=Stealth,
      b/.style={draw=uptblue,fill=uptlight,rounded corners=3pt,minimum width=2.4cm,
                minimum height=1cm,align=center,font=\footnotesize}]
    \node[b] (a) at (0,0) {\textbf{1. $\hat\sigma$}\\nga të dhënat};
    \node[b] (b) at (3.2,0) {\textbf{2. Put-i}\\Black--Scholes};
    \node[b] (c) at (6.4,0) {\textbf{3. $_Tp_x$}\\HLD / sintetike};
    \node[b,fill=accent!15,draw=accent] (d) at (9.6,0) {\textbf{4. $V$}\\ndjeshmëria};
    \draw[->,thick,uptmid] (a) -- (b); \draw[->,thick,uptmid] (b) -- (c); \draw[->,thick,uptmid] (c) -- (d);
  \end{tikzpicture}
  \vspace{8pt}
  \begin{itemize}
    \item Çdo hap përdor një javë të mëparshme: 8 ($\sigma$), 10 (BS), 5 ($_tp_x$).
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 1--2: $\sigma$ dhe put-i}
% ------------------------------------------------------------

\begin{frame}[fragile]{Hapi 1: $\hat\sigma$ me interval besimi}
<<w10h6-sig>>=
rv6 <- diff(log(st$close)); n6 <- length(rv6)
sig6 <- sd(rv6) * sqrt(252)
ci6  <- sig6 + c(-1, 1) * 1.96 * sig6 / sqrt(2 * n6)          # SE(sigma) = sigma / sqrt(2n)
round(c(n = n6, sigma_hat = sig6, lower = ci6[1], upper = ci6[2], truth = 0.25), 4)
@
  \small \textbf{Sintetike}: e vërteta $\sigma=25\%$ është brenda intervalit. Në praktikë e vërteta nuk dihet.
\end{frame}

\begin{frame}[fragile]{Hapi 2: put-i pa vdekshmëri}
<<w10h6-put>>=
P6 <- 1e6; U6 <- P6 / 100; m6 <- 0.01; r6 <- 0.03; T6 <- 10      # units of S0 = 100
put6 <- U6 * bsput(100, 100, sig6, r6, T6, m6)                   # d = fee
round(c(put_lek = put6, pct_premium = 100 * put6 / P6,
        put_no_fee = U6 * bsput(100, 100, sig6, r6, T6, 0)))
@
  \pause
  \small Tarifa 1\% e bën garancinë më të shtrenjtë: fondi rritet më ngadalë, put-i bie më shpesh në para.
\end{frame}

\begin{frame}[label=w10par6]{Parashiko}
  \begin{Parashiko}
    Tani shtojmë vdekshmërinë: garancia paguhet vetëm nëse klienti mbijeton 10 vjet.
    \begin{enumerate}
      \item Vlera e garancisë rritet apo ulet?
      \item Me sa përqind afërsisht? (Ndihmë: sa është $_{10}p_{45}$ për një burrë?)
      \item A ka rëndësi nëse përdorim tabelën shqiptare apo atë sintetike?
    \end{enumerate}
  \end{Parashiko}
  \vfill\shkoTe{w10zgjPar6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 3--4: vdekshmëria dhe vlera}
% ------------------------------------------------------------

\begin{frame}[fragile]{Hapi 3: $_{10}p_{45}$}
<<w10h6-tpx>>=
tp_hld <- function(x, t, sex = 1) {                       # HLD 2011, abridged (5-year ages)
  l <- function(a) h11[["l(x)"]][h11$Sex == sex & h11$Age == a]; l(x + t) / l(x)
}
tp_syn <- function(x, t, col = "lx_male") mt6[[col]][mt6$age == x + t] / mt6[[col]][mt6$age == x]
round(c(HLD_2011_M = tp_hld(45, 10), synthetic_M = tp_syn(45, 10),
        HLD_2011_F = tp_hld(45, 10, 2), synthetic_F = tp_syn(45, 10, "lx_female")), 5)
@
  \small HLD 2011 është tabelë e shkurtuar (mosha 45, 50, 55, \ldots): mjafton, sepse $x$ dhe $x+T$ bien në rrjetë.
\end{frame}

\begin{frame}[fragile]{Hapi 4: vlera e garancisë}
<<w10h6-val>>=
V6 <- c(HLD_2011 = tp_hld(45, 10) * put6, synthetic = tp_syn(45, 10) * put6)
round(rbind(value_lek = V6, pct_premium = 100 * V6 / P6), 2)
@
  \pause
  \begin{itemize}
    \item Garancia vlen rreth \textbf{\Sexpr{fmt(V6["HLD_2011"])} lekë}: \Sexpr{fmt(100 * V6["HLD_2011"] / P6, 1)}\% e primit.
    \item Dy tabelat japin pothuajse të njëjtin $_{10}p_{45}$: diferenca \Sexpr{fmt(abs(diff(V6)))} lekë.
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vdekshmëria ul vlerën vetëm rreth \Sexpr{fmt(100 * (1 - tp_hld(45, 10)), 1)}\%: për moshën 45, mbijetesa 10-vjeçare është e lartë.
    \item<2-> Faktori dominues është \textbf{tregu}: $\sigma$, $m$, $T$.
    \item<3-> Për një klient 65 vjeç, vdekshmëria do të kishte shumë më shumë peshë.
  \end{itemize}
\end{frame}

\begin{frame}[fragile,label=w10gab6]{Gjej gabimin}
<<w10h6-bug>>=
E_10_45 <- tp_hld(45, 10) * exp(-r6 * T6)          # pure endowment factor 10E45
V_bad <- E_10_45 * put6
c(V_bad = V_bad, V_correct = unname(V6["HLD_2011"]))
@
  \small Studenti thotë: ``garancia paguhet në $T$ nëse është gjallë, pra shumëzoj me $_{10}E_{45}$''. Ku gabon?
  \hfill\shkoTe{w10zgjGab6}{Zgjidhja}
\end{frame}

\begin{frame}[fragile]{Kontroll me Monte Carlo}
<<w10h6-mc>>=
set.seed(2026); M6 <- 1e5
FT6 <- 100 * exp((r6 - m6 - sig6^2 / 2) * T6 + sig6 * sqrt(T6) * rnorm(M6))   # fund under Q
alive6 <- runif(M6) < tp_hld(45, 10)                                       # survival, independent
Y6 <- exp(-r6 * T6) * U6 * pmax(100 - FT6, 0) * alive6
round(c(mc = mean(Y6), se = sd(Y6) / sqrt(M6), formula = unname(V6["HLD_2011"])))
@
  \small Formula $_Tp_x\times$put $=$ simulimi i përbashkët tregu + mbijetesa, brenda $\pm2\,\text{se}$. \textcolor{okgreen}{$\checkmark$}
\end{frame}

\begin{frame}[label=w10ush6]{Radha jote!}
  \begin{Ushtrim}[(6 minuta)]
    \begin{enumerate}
      \item Llogarit vlerën e garancisë për një \textbf{grua} 45 vjeçe (HLD 2011, \texttt{sex = 2}).
      \item Po për një burrë 55 vjeç me $T=10$?
      \item Cili ndryshim ka më shumë efekt mbi vlerën: gjinia apo 10 vjet moshë?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w10zgjUsh6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Ndjeshmëria}
% ------------------------------------------------------------

\begin{frame}[fragile]{Pasiguria e $\hat\sigma$}
<<w10h6-sens>>=
sg6 <- c(lower = ci6[1], estimate = sig6, upper = ci6[2])
V_sig <- tp_hld(45, 10) * U6 * bsput(100, 100, sg6, r6, T6, m6)
round(rbind(sigma_pct = 100 * sg6, value_lek = V_sig), 1)
@
  \pause
  \small Vetëm nga pasiguria statistike e $\hat\sigma$ (3 vjet të dhëna), vlera lëviz rreth
  $\pm\Sexpr{fmt((V_sig[3] - V_sig[1]) / 2)}$ lekë për kontratë: $\pm\Sexpr{fmt(100 * (V_sig[3] - V_sig[1]) / 2 / V_sig[2], 1)}\%$.
\end{frame}

\begin{frame}[fragile]{Vlera sipas maturimit}
<<w10h6-T, echo=FALSE, fig.height=2.8>>=
Tg6 <- c(5, 10, 15, 20, 25, 30)
dT6 <- data.frame(T = rep(Tg6, 2),
  V = c(sapply(Tg6, function(t) U6 * bsput(100, 100, sig6, r6, t, m6)),
        sapply(Tg6, function(t) tp_hld(45, t) * U6 * bsput(100, 100, sig6, r6, t, m6))) / 1e3,
  what = rep(c("pa vdekshmeri", "me 10p45 (HLD 2011, M)"), each = length(Tg6)))
ggplot(dT6, aes(T, V, colour = what)) + geom_line(linewidth = 1) + geom_point() +
  scale_colour_manual(values = c("#2C5AA0", "#E67E22")) +
  labs(x = "maturimi T (vite)", y = "vlera (mije leke)", colour = NULL) + th + theme(legend.position = "top")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Vlera \textbf{nuk} rritet pafundësisht me $T$: arrin maksimumin dhe pastaj bie.
    \item<2-> Dy forca: më shumë kohë $=$ më shumë pasiguri (rritje); por $Ke^{-rT}$ dhe mbijetesa bien (ulje).
    \item<3-> Me $T$ të gjatë, vdekshmëria ka peshë më të madhe: kurbat ndahen.
  \end{itemize}
  \onslide<4->{\small Kujdes: $r$ dhe $\sigma$ konstante për 30 vjet janë supozime të forta (Ora 2).}
\end{frame}

\begin{frame}[fragile,label=w10ndr6]{Ndrysho parametrin: tarifa dhe niveli i garancisë}
<<w10h6-grid>>=
gr6 <- expand.grid(fee = c(0, 0.01, 0.02), g = c(0, 0.02))        # g: guaranteed growth rate
gr6$K <- 100 * (1 + gr6$g)^T6
gr6$value <- tp_hld(45, 10) * U6 * bsput(100, gr6$K, sig6, r6, T6, gr6$fee)
gr6$pct <- 100 * gr6$value / P6
round(gr6, 2)
@
  \hfill\shkoTe{w10zgjNdr6}{Interpretimi}
\end{frame}

\begin{frame}[fragile]{Greeks e portofolit}
<<w10h6-greeks>>=
n_pol <- 500                                            # 500 identical contracts
gk6 <- greeks(bsput(100, 100, sig6, r6, T6, m6))[c("Delta", "Vega", "Rho"), 1]
round(-n_pol * tp_hld(45, 10) * U6 * gk6)               # insurer is short the guarantee
@
  \begin{itemize}
    \item Delta pozitive: kompania humbet kur fondi bie. Për mbrojtje: shit rreth \Sexpr{fmt(-n_pol * tp_hld(45, 10) * U6 * gk6["Delta"])} njësi të fondit (çmimi i njësisë 100), pra rreth \Sexpr{fmt(-n_pol * tp_hld(45, 10) * U6 * gk6["Delta"] * 100 / 1e6)} milionë lekë.
    \item Vega: $\Sexpr{fmt(-n_pol * tp_hld(45, 10) * U6 * gk6["Vega"])}$ lekë për çdo pikë përqindjeje të $\sigma$.
    \item Rho negative: kompania humbet kur normat bien.
  \end{itemize}
\end{frame}

\begin{frame}[label=w10tps6]{Mendo -- diskuto me shokun -- ndaj}
  \begin{Ushtrim}[(4 minuta)]
    Kompania ka 500 kontrata të njëjta.
    \begin{enumerate}
      \item A diversifikohet rreziku i vdekshmërisë me 500 klientë? Po rreziku i tregut?
      \item Pse supozimi ``vdekshmëria e pavarur nga tregu'' mund të dështojë (p.sh.\ në një pandemi)?
      \item Kush duhet ta mbajë rrezikun e $\sigma$: klienti, kompania, apo një risigurues?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w10zgjTps6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Garancia në rast vdekjeje\Zgj}
% ------------------------------------------------------------

\begin{frame}{GMDB\Zgj}
  \begin{itemize}
    \item Nëse klienti vdes në vitin $k$, trashëgimtarët marrin $\max(F_k,P)$ në fund të vitit.
    \item Garancia në vitin $k$: një put me maturim $k$, me peshë $_{k-1|}q_x$.
  \end{itemize}
  \[ V_{\text{GMDB}}=\sum_{k=1}^{T}{}_{k-1|}q_x\cdot P^{\text{put}}(T=k),\qquad {}_{k-1|}q_x=\frac{l_{x+k-1}-l_{x+k}}{l_x} \]
  \small Kërkon $l_x$ për çdo moshë: përdorim tabelën \textbf{sintetike} (e plotë).
\end{frame}

\begin{frame}[fragile]{GMDB në R\Zgj}
<<w10h6-gmdb>>=
k6 <- 1:T6
lx6 <- mt6$lx_male[match(45 + 0:T6, mt6$age)]
dq6 <- (lx6[k6] - lx6[k6 + 1]) / lx6[1]                  # deferred death probabilities
gmdb6 <- sum(dq6 * U6 * bsput(100, 100, sig6, r6, k6, m6))
round(sum(dq6), 4)                                       # P(death within 10 years)
round(c(GMDB = gmdb6, GMMB = tp_syn(45, 10) * put6, total = gmdb6 + tp_syn(45, 10) * put6))
@
  \small GMDB është i vogël: vetëm $\approx\Sexpr{fmt(100 * sum(dq6), 1)}\%$ e klientëve vdesin brenda 10 vjetëve, dhe put-et e shkurtra vlejnë më pak.
\end{frame}

% ------------------------------------------------------------
\subsection{Rregullimi dhe projekti}
% ------------------------------------------------------------

\begin{frame}{Lidhja me rregullimin}
  \begin{itemize}
    \item<1-> \textbf{IFRS 17}: garancia është pjesë e flukseve të kontratës; vlerësohet në mënyrë konsistente me tregun, si këtu.
    \item<2-> \textbf{Solvency II}: Best Estimate përfshin vlerën kohore të opsioneve dhe garancive (TVOG);
      kapitali kërkohet për rrezikun e aksioneve, normave dhe vdekshmërisë.
    \item<3-> \textbf{Tregu shqiptar}: produktet unit-linked janë ende pak të përhapura; mjetet janë të njëjta për çdo garanci të lidhur me tregun.
  \end{itemize}
\end{frame}

\begin{frame}{Drejt projektit të kursit}
  \begin{itemize}
    \item Detyra e projektit për sigurimet e jetës caktohet në Javët 10--12.
    \item Mjetet që ju duhen i keni tani:
      \begin{itemize}
        \item tabela jete dhe $_tp_x$ (Javët 5--7);
        \item rezerva dhe prime neto (Java 7);
        \item vlerësimi i garancive me Black--Scholes dhe Monte Carlo (Java 10).
      \end{itemize}
    \item Raporti duhet të ketë: të dhënat (reale/sintetike), supozimet, kodin e riprodhueshëm, ndjeshmërinë.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse tarifa e administrimit futet si \texttt{d} në \texttt{bsput()}?
    \item Pse vlera e GMMB është $_Tp_x\times$put dhe jo $_TE_x\times$put?
    \item Cili parametër ka efektin më të madh mbi vlerën e garancisë?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) e ul fondin me normë të vazhdueshme, si një dividend; (2) put-i i Black--Scholes është tashmë i skontuar;
  (3) tregu: $\sigma$, tarifa $m$ dhe niveli i garancisë, shumë më shumë se vdekshmëria në moshën 45.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 6}
  \begin{itemize}
    \item GMMB $=$ $_Tp_x\times$ put me $\delta=m$: \Sexpr{fmt(V6["HLD_2011"])} lekë (\Sexpr{fmt(100 * V6["HLD_2011"] / P6, 1)}\% e primit).
    \item HLD 2011 dhe tabela sintetike: pothuajse e njëjta vlerë për $x=45$, $T=10$.
    \item Pasiguria e $\hat\sigma$: $\pm\Sexpr{fmt(100 * (V_sig[3] - V_sig[1]) / 2 / V_sig[2], 1)}\%$; tarifa dhe garancia 2\% e ndryshojnë shumë më shumë.
    \item Monte Carlo konfirmon formulën; GMDB shton pak.
  \end{itemize}
  \vfill
  \begin{block}{Ora 7}
    Konsolidim: kuiz 15/85, ushtrime, gabimet e zakonshme, fletë-kujtesa e funksioneve R.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 6)}
  \small
  \begin{itemize}
    \item Human Life-Table Database: \texttt{albania\_lifetables\_HLD\_1950\_2011.csv} (\textbf{reale}).
    \item README i të dhënave: \texttt{mortality\_table\_synthetic.csv}, \texttt{stock\_prices\_gbm\_synthetic.csv} (\textbf{sintetike}).
    \item M.~R.~Hardy, \emph{Investment Guarantees: Modeling and Risk Management for Equity-Linked Life Insurance}, Wiley.
    \item Dokumentacioni i paketës \Rkey{derivmkts}: \texttt{bsput()}, \texttt{greeks()}.
  \end{itemize}
\end{frame}
