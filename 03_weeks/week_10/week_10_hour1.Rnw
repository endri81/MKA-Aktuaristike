<<w10h1-setup, include=FALSE>>=
suppressMessages(library(derivmkts))
library(ggplot2)
th  <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0)                               # thin space: safe in math mode
  gsub(" ", "\\\\,", format(round(x, d), big.mark = " ", nsmall = d))
st  <- read.csv(file.path(DATA, "stock_prices_gbm_synthetic.csv"))
sig_hat <- sd(diff(log(st$close))) * sqrt(252)          # Week 8
C0 <- bscall(100, 100, 0.25, 0.03, 1, 0)                # benchmark call
P0 <- bsput(100, 100, 0.25, 0.03, 1, 0)                 # benchmark put
@

% ------------------------------------------------------------
\subsection{Pyetja e javës}
% ------------------------------------------------------------

\begin{frame}{Rikthim te ``Pensioni Plus''}
  \begin{itemize}
    \item<1-> Java 8: fondi garanton 10\,000\,000 lekë pas 5 vitesh, të investuara në një aksion.
    \item<2-> Garancia = 100\,000 put me $K=100$, $T=5$.
    \item<3-> Çmimi që gjetëm: \textbf{\Sexpr{fmt(1e5 * bsput(100, 100, sig_hat, 0.03, 5, 0))} lekë}.
  \end{itemize}
  \onslide<4->{
  \begin{Shembull}[(pyetja e javës)]
    ``Nga vjen ky numër? Dhe sa i besueshëm është, kur $\sigma$ dhe tregu nuk janë të njohur saktë?''
  \end{Shembull}}
  \onslide<5->{\small Shembull ilustrues: fondi dhe anëtari janë fiktivë.}
\end{frame}

\begin{frame}[fragile]{Kutia e zezë}
<<w10h1-box>>=
c(call = bscall(s = 100, k = 100, v = 0.25, r = 0.03, tt = 1, d = 0),
  put  = bsput (s = 100, k = 100, v = 0.25, r = 0.03, tt = 1, d = 0))
@
  \begin{itemize}
    \item Javët 8--9: e përdorëm këtë funksion pa e parë brenda.
    \item Sot e hapim: çfarë formule ka brenda? Mbi cilat supozime mbështetet?
  \end{itemize}
\end{frame}

\begin{frame}{Formula që do të nxjerrim}
  \begin{Teoreme}[(Black--Scholes, 1973)]
    \[
      C = S_0\,\Phi(d_1) - K e^{-rT}\,\Phi(d_2), \qquad
      d_{1,2} = \frac{\ln(S_0/K) + (r \pm \tfrac12\sigma^2)T}{\sigma\sqrt{T}}
    \]
  \end{Teoreme}
  \pause
  \begin{itemize}
    \item $\Phi$: funksioni i shpërndarjes normale standarde (\Rkey{pnorm}).
    \item Pesë hyrje: $S_0$, $K$, $\sigma$, $r$, $T$. Asnjë $\mu$!
  \end{itemize}
  \pause
  \small Nxjerrja hap pas hapi: Ora 2. Sot: intuita.
\end{frame}

\begin{frame}{Pak histori}
  \begin{itemize}
    \item 1973: F.~Black dhe M.~Scholes; R.~C.~Merton në të njëjtin vit, me një argument të përgjithshëm.
    \item Në të njëjtin vit hapet bursa e opsioneve në Çikago (CBOE).
    \item 1997: Çmimi Nobel në ekonomi për Scholes dhe Merton. Black kishte vdekur në 1995.
  \end{itemize}
    \begin{Keshille}Ideja kryesore nuk është formula, por argumenti: një opsion mund të \textbf{riprodhohet} me aksion + obligacion.\end{Keshille}
\end{frame}

\begin{frame}{Objektivat e Javës 10}
  \begin{enumerate}
    \item Të kuptojmë supozimet dhe nxjerrjen e formulës Black--Scholes. \LO{K3}
    \item Ta programojmë nga zero dhe ta krahasojmë me \Rkey{derivmkts}. \LO{S2}
    \item Të llogarisim dhe interpretojmë Greeks: $\Delta,\Gamma,\nu,\Theta,\rho$. \LO{K3}
    \item Të gjejmë volatilitetin e nënkuptuar nga një çmim tregu. \LO{K3}
    \item Të vlerësojmë një garanci të ngulitur në një kontratë sigurimi jete. \LO{C3}
  \end{enumerate}
\end{frame}

\begin{frame}{Harta e ditës}
  \centering
