\begin{frame}[label=w11sT1]{Zgjidhja T1}
  \textbf{B)} $ud=1$: ``rritje pastaj rënie'' $=$ ``rënie pastaj rritje'', pra pema rikombinohet.
  \begin{itemize}
    \item A) $q$ nuk varet nga $\mu$ (Ora 2). \; C) ka $n+1$ nyje në maturim, jo $2^n$.
    \item D) pema konvergjon te Black--Scholes vetëm kur $n\to\infty$.
  \end{itemize}
  \vfill\kthehu{w11qT1}
\end{frame}

\begin{frame}[label=w11sT2]{Zgjidhja T2}
  \textbf{B)} Ora 4: $c_{i,j}\ge e^{-r\Delta t}E^{\mathbb Q}[S_{i+1}-K]=S_{i,j}-Ke^{-r\Delta t}>S_{i,j}-K$.
  \begin{itemize}
    \item A), D) nuk kanë lidhje me vendimin. \; C) pema e lejon ushtrimin; thjesht nuk është optimal.
  \end{itemize}
  \vfill\kthehu{w11qT2}
\end{frame}

\begin{frame}[label=w11sU1]{Zgjidhja U1}
  \begin{enumerate}
    \item Payoff-et: $60\to10$, $45\to0$. \; $\Delta=\dfrac{10-0}{60-45}=0.6667$; \;
      $B=\dfrac{1.2\cdot0-0.9\cdot10}{1.03\cdot0.3}=-29.13$.
    \item $C_0=50\cdot0.6667-29.13=\mathbf{4.21}$. \;
      $q=\dfrac{1.03-0.9}{0.3}=0.4333$, \; $C_0=\dfrac{0.4333\cdot10}{1.03}=4.21$. \textcolor{okgreen}{$\checkmark$}
  \end{enumerate}
  \vfill\kthehu{w11qU1}
\end{frame}

\begin{frame}[label=w11sU2]{Zgjidhja U2}
  \begin{enumerate}
    \item $\Delta t=0.25$; \; $\sigma\sqrt{\Delta t}=0.1$; \; $u=1.105171$, \; $d=0.904837$.
    \item $q=\dfrac{1.010050-0.904837}{1.105171-0.904837}=\dfrac{0.105213}{0.200334}=\mathbf{0.5252}$.
    \item $S_{uu}=122.14$, \; $S_{ud}=100$, \; $S_{dd}=81.87$.
  \end{enumerate}
  \vfill\kthehu{w11qU2}
\end{frame}

\begin{frame}[label=w11sU3]{Zgjidhja U3}
  \begin{enumerate}
    \item Payoff-et: $0$, $0$, $100-81.87=18.13$.
    \item $P_u=0$; \; $P_d=\dfrac{0.4748\cdot18.13}{1.01005}=8.52$; \; $P_0=\dfrac{0.4748\cdot8.52}{1.01005}=\mathbf{4.01}$.
  \end{enumerate}
  \small R: \texttt{binomopt(100, 100, 0.2, 0.04, 0.5, 0, 2, american = FALSE, putopt = TRUE, crr = TRUE)}
  $=\Sexpr{fmt(unname(binomopt(100, 100, 0.2, 0.04, 0.5, 0, 2, american = FALSE, putopt = TRUE, crr = TRUE)), 4)}$.
  \vfill\kthehu{w11qU3}
\end{frame}

\begin{frame}[label=w11sU4]{Zgjidhja U4}
  \begin{enumerate}
    \item Në nyjen $S_d=90.48$: intrinsike $9.52>$ vazhdimi $8.52$: \textbf{ushtro}. Në $S_u$ dhe në rrënjë: jo.
    \item $P_A=\dfrac{0.4748\cdot9.52}{1.01005}=\mathbf{4.47}$; \; prima $=4.47-4.01=0.47$.
  \end{enumerate}
  \small R (\texttt{american = TRUE}): $\Sexpr{fmt(unname(binomopt(100, 100, 0.2, 0.04, 0.5, 0, 2, american = TRUE, putopt = TRUE, crr = TRUE)), 4)}$.
  \vfill\kthehu{w11qU4}
\end{frame}

\begin{frame}[label=w11sU5]{Zgjidhja U5}
  \begin{enumerate}
    \item $\Delta_0=\dfrac{P_u-P_d}{S_u-S_d}=\dfrac{0-8.52}{110.52-90.48}=\mathbf{-0.425}$.
    \item Pozicioni i shitur: $-1000\cdot(-0.425)=+425$. Për ta neutralizuar: \textbf{shit} (shkurt) rreth 425 aksione.
  \end{enumerate}
  \vfill\kthehu{w11qU5}
\end{frame}

\begin{frame}[label=w11sU6]{Zgjidhja U6}
  \begin{enumerate}
    \item $q=0.4333$. Gjallë: $(120,\,100)$; vdekur: $(120,\,90)$.\\
      $V_0=\dfrac{0.98\,(0.4333\cdot120+0.5667\cdot100)+0.02\,(0.4333\cdot120+0.5667\cdot90)}{1.03}
      =\dfrac{106.49+2.06}{1.03}=\mathbf{105.39}$.
    \item Garancia vlen $105.39-100=5.39$: put-i me $K=100$ ($=5.50$) i peshuar me $p=0.98$.
  \end{enumerate}
  \vfill\kthehu{w11qU6}
\end{frame}

\begin{frame}[fragile,label=w11sU7]{Zgjidhja U7}
<<w11h7-sol-u7>>=
p7 <- c(own = crr_tree(100, 100, 0.30, 0.05, 2, 400, TRUE, TRUE),
        derivmkts = unname(binomopt(100, 100, 0.30, 0.05, 2, 0, nstep = 400, american = TRUE,
                                    putopt = TRUE, crr = TRUE)),
        average = (crr_tree(100, 100, 0.30, 0.05, 2, 400, TRUE, TRUE) +
                   crr_tree(100, 100, 0.30, 0.05, 2, 401, TRUE, TRUE)) / 2)
b7 <- crr_boundary(100, 100, 0.30, 0.05, 2, 400)
round(c(p7, S_star_t1 = b7$Sstar[which.min(abs(b7$t - 1))]), 4)
@
  \vfill\kthehu{w11qU7}
\end{frame}

\begin{frame}[fragile,label=w11sU8]{Zgjidhja U8}
<<w11h7-sol-u8>>=
round(c(with_surrender = kp_value(c = 0.10, m = 0.02),
        without_surrender = kp_value(c = 0.10, m = 0.02, surrender = FALSE)) / 1e6, 3)
@
  \small Edhe me ndëshkim 10\% dhe tarifë 2\%, $V_0>10$ milionë: garancia 100\% e primit është shumë e shtrenjtë.
  Rekomandim: garanci më e ulët (p.sh.\ 80--90\% e primit), ose mbrojtje e garancisë në treg.
  \vfill\kthehu{w11qU8}
\end{frame}

\begin{frame}[label=w11sGab7]{Zgjidhja: raundi i shpejtë}
  \textbf{(b)} është i saktë: tarifa vepron si dividend te $q$.
  \begin{itemize}
    \item (a) $q$ përdor $r$, jo $\mu$.
    \item (c) Ky është probabiliteti \textbf{vjetor}; për një hap mujor duhet \texttt{(lx[x + 2] / lx[x + 1])\^{}(1 / 12)}.
  \end{itemize}
  \vfill\kthehu{w11qGab7}
\end{frame}
