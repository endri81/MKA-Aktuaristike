<<w11h1-setup, include=FALSE>>=
suppressMessages(library(derivmkts))
library(ggplot2)
th  <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0) format(round(x, d), big.mark = " ", nsmall = d)
st  <- read.csv(file.path(DATA, "stock_prices_gbm_synthetic.csv"))
sig_hat <- sd(diff(log(st$close))) * sqrt(252)                 # Week 8
C0 <- bscall(100, 100, 0.25, 0.03, 1, 0); P0 <- bsput(100, 100, 0.25, 0.03, 1, 0)
crr <- function(n, put = FALSE, am = FALSE)                     # CRR price (derivmkts)
  unname(binomopt(100, 100, 0.25, 0.03, 1, 0, nstep = n, american = am, putopt = put, crr = TRUE))
@

% ------------------------------------------------------------
\subsection{Pyetja e javës}
% ------------------------------------------------------------

\begin{frame}{Rikthim te ``Kursimi Plus''}
  \begin{itemize}
    \item<1-> Java 9: klienti mund ta anulojë kontratën \textbf{në çdo moment}: një put \textbf{amerikan}.
    \item<2-> Java 10: Black--Scholes jep një formulë, por vetëm për opsionet \textbf{europiane}.
    \item<3-> Për put-in amerikan nuk ka formulë të mbyllur.
  \end{itemize}
  \onslide<4->{
  \begin{Shembull}[(pyetja e javës)]
    ``Si e vlerësojmë një opsion që mund të ushtrohet në çdo kohë? Dhe si e dimë që përgjigjja është e saktë?''
  \end{Shembull}}
  \onslide<5->{\small Shembull ilustrues: kompania dhe kontrata janë fiktive.}
\end{frame}

\begin{frame}[fragile]{Kutia e zezë e Javëve 9--10}
<<w11h1-box>>=
binomopt(100, 100, 0.25, 0.03, 1, 0, nstep = 3, american = TRUE, putopt = TRUE,
         crr = TRUE, returnparams = TRUE)[c("price", "up", "dn", "p", "h")]
@
  \begin{itemize}
    \item<2-> \texttt{up}, \texttt{dn}: sa rritet ose bie aksioni në një hap; \texttt{p}: probabiliteti neutral $q$; \texttt{h}: gjatësia e hapit $\Delta t$.
    \item<3-> Sot e hapim këtë kuti: si ndërtohet pema dhe si llogaritet çmimi.
  \end{itemize}
\end{frame}

\begin{frame}{Pema me tre hapa}
  \centering
  \begin{tikzpicture}[>=Stealth,x=2.4cm,y=0.75cm,
      n/.style={draw=uptblue,fill=uptlight,rounded corners=2pt,font=\scriptsize,inner sep=2pt}]
    \node[n] (a) at (0,0) {100};
    \node[n] (b1) at (1,1) {115.53}; \node[n] (b0) at (1,-1) {86.56};
    \node[n] (c2) at (2,2) {133.47}; \node[n] (c1) at (2,0) {100}; \node[n] (c0) at (2,-2) {74.93};
    \node[n] (d3) at (3,3) {154.19}; \node[n] (d2) at (3,1) {115.53};
    \node[n] (d1) at (3,-1) {86.56}; \node[n] (d0) at (3,-3) {64.86};
    \foreach \x/\y in {a/b1,a/b0,b1/c2,b1/c1,b0/c1,b0/c0,c2/d3,c2/d2,c1/d2,c1/d1,c0/d1,c0/d0}
      \draw[->,uptmid] (\x) -- (\y);
    \node[font=\scriptsize,gray] at (0,-3.6) {$t=0$};
    \node[font=\scriptsize,gray] at (3,-3.9) {$t=T=1$};
  \end{tikzpicture}\par
  \small $\sigma=25\%$, $\Delta t=1/3$: \; $u=e^{\sigma\sqrt{\Delta t}}=1.1553$, \; $d=1/u=0.8656$. Pema \textbf{rikombinohet}: $ud=du$.
\end{frame}

\begin{frame}{Ideja: induksioni prapa}
  \begin{enumerate}
    \item<1-> Në maturim (kolona e fundit): vlera $=$ payoff-i.
    \item<2-> Një hap prapa: vlera $=$ mesatarja e skontuar me $q$ e dy pasardhësve.
    \item<3-> Për opsionin amerikan: krahaso me vlerën intrinsike; merr më të madhen.
    \item<4-> Përsërit deri në $t=0$.
  \end{enumerate}
  \onslide<5->{
  \begin{Keshille}E njëjta ide si rezerva matematike e Javës 7: llogaritet nga fundi drejt fillimit.\end{Keshille}}
\end{frame}

\begin{frame}{Objektivat e Javës 11}
  \begin{enumerate}
    \item Të ndërtojmë pemën CRR dhe të nxjerrim probabilitetin neutral $q$. \LO{K3}
    \item Të vlerësojmë opsione europiane dhe amerikane me induksion prapa. \LO{K3}
    \item Ta programojmë pemën nga zero dhe ta krahasojmë me \Rkey{derivmkts}. \LO{S2}
    \item Të tregojmë konvergjencën e CRR te Black--Scholes. \LO{K3}
    \item Të vlerësojmë një garanci me të drejtë anulimi në një kontratë jete. \LO{C3}
  \end{enumerate}
\end{frame}

\begin{frame}{Harta e ditës}
  \centering
  \begin{tikzpicture}[>=Stealth,
      b/.style={draw=uptblue,fill=uptlight,rounded corners=3pt,minimum width=2.6cm,
