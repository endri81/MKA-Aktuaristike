% ============================================================
%  Java 11 · Ora 3 — Zgjidhjet (shtojca)
% ============================================================

\begin{frame}[label=w11zgjGab3]{Zgjidhja: Gjej gabimin}
  \begin{itemize}
    \item \texttt{q} shumëzon \texttt{V[-(i + 2)]} (vlerat ``poshtë''), dhe \texttt{1 - q} vlerat ``lart'': të këmbyera.
    \item Pema i jep peshë $q$ rënies. Meqë $q\approx0.5$, gabimi është i vogël
      (\Sexpr{fmt(crr_bad(100, 100, 0.25, 0.03, 1, 200), 4)} kundrejt \Sexpr{fmt(crr_tree(100, 100, 0.25, 0.03, 1, 200), 4)}):
      prandaj është i rrezikshëm, kalon pa u vënë re.
    \item Testi që e kap: krahasimi me \texttt{binomopt()} ose me Black--Scholes, dhe parity.
  \end{itemize}
  \vfill\kthehu{w11gab3}
\end{frame}

\begin{frame}[fragile,label=w11zgjUsh3]{Zgjidhja: Radha jote!}
<<w11h3-sol-ex>>=
dt3 <- 1 / 3; u3 <- exp(0.25 * sqrt(dt3)); d3 <- 1 / u3
q3 <- (exp(0.03 * dt3) - d3) / (u3 - d3); E3 <- matrix(FALSE, 4, 4)
for (i in 0:2) {                                       # interior nodes only
  cont <- exp(-0.03 * dt3) * (q3 * tr3$V[2:(i + 2), i + 2] + (1 - q3) * tr3$V[1:(i + 1), i + 2])
  E3[1:(i + 1), i + 1] <- pmax(100 - tr3$S[1:(i + 1), i + 1], 0) > cont + 1e-12
}
E3[4:1, ]
@
  \small Ushtrim i hershëm: vetëm nyja më e ulët në $t=2/3$. \;
  $\Delta_0=\Sexpr{fmt((tr3$V[2, 2] - tr3$V[1, 2]) / (tr3$S[2, 2] - tr3$S[1, 2]), 4)}<0$: put.
  \vfill\kthehu{w11ush3}
\end{frame}

\begin{frame}[label=w11zgjPar3]{Zgjidhja: Parashiko}
  \begin{enumerate}
    \item \textbf{Jo}: \texttt{crr\_formula(..., n = 5000)} $=\Sexpr{fmt(crr_formula(100, 100, 0.25, 0.03, 1, 5000), 4)}$, afër Black--Scholes \Sexpr{fmt(C0, 4)}.
    \item \texttt{dbinom()} llogarit në shkallë logaritmike; vetëm probabilitetet e pakuptimta ($\ll10^{-308}$) bëhen 0.
      Ato i përkasin nyjeve ekstreme, me peshë praktikisht zero. Gabimi i mbetur është gabimi i pemës, jo i kompjuterit.
  \end{enumerate}
  \vfill\kthehu{w11par3}
\end{frame}

\begin{frame}[label=w11zgjNdr3]{Interpretimi: Ndrysho parametrin}
  \begin{itemize}
    \item Me $n=10$ prima del rreth 0.37--0.42: pema e trashë e \textbf{mbivlerëson}.
    \item Nga $n=200$ në $1000$ ndryshon vetëm në shifrën e tretë: konvergjencë.
    \item Me $n$ të madh, prima ndryshon \textbf{pak} me $\sigma$ (0.28--0.29): ajo varet kryesisht nga $r$, si në Javën 9.
  \end{itemize}
  \vfill\kthehu{w11ndr3}
\end{frame}
