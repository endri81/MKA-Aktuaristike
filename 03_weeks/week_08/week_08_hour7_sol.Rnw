\begin{frame}[label=w8sU6]{Zgjidhja U6}
  Call-i është \textbf{i shtrenjtë} ($10.00>9.2518$): e shesim.
  \begin{center}
    \small
    \begin{tabular}{lcc}
      \toprule
      Veprimi & Sot & Në $T$ \\
      \midrule
      Shit call & $+10.00$ & $-(S_T-75)^+$ \\
      Bli put & $-2.40$ & $(75-S_T)^+$ \\
      Bli aksionin & $-80$ & $S_T$ \\
      Merr hua $Ke^{-rT}$ & $+73.1482$ & $-75$ \\
      \midrule
      \textbf{Gjithsej} & $\mathbf{+0.7482}$ & $\mathbf{0}$ \\
      \bottomrule
    \end{tabular}
  \end{center}
  \vfill\kthehu{w8qU6}
\end{frame}

\begin{frame}[fragile,label=w8sU7]{Zgjidhja U7}
<<w8s7-u7>>=
e1 <- est_gbm(as.numeric(rx["2023"])); e3 <- est_gbm(rv)
w  <- function(e) e["upper", ] - e["lower", ]
round(rbind(width_1y = w(e1), width_3y = w(e3), ratio = w(e1) / w(e3)), 3)
@
  \small Teoria: $\mu$: $\sqrt{3}=1.73$ herë; $\sigma$: $\sqrt{755/251}\approx1.73$ herë. Të dyja $\approx\sqrt3$, sepse $n$ dhe $T$ shkojnë bashkë. Raporti del \Sexpr{fmt(w(e1)[1] / w(e3)[1], 2)}, pak më shumë, sepse $\hat\sigma$ i 2023 është më i madh.
  \vfill\kthehu{w8qU7}
\end{frame}

\begin{frame}[fragile,label=w8sU8]{Zgjidhja U8}
<<w8s7-u8>>=
sh <- unname(sig_g["estimate"])
p95 <- 1e5 * bsput(100, 95, sh, 0.03, 3, 0)
c95 <- 1e5 * bscall(100, 95, sh, 0.03, 3, 0)
par95 <- c95 - 1e7 + 9.5e6 * exp(-0.03 * 3)
alpha95 <- (1e7 - 9.5e6 * exp(-0.03 * 3)) / c95
round(c(put = p95, via_parity = par95, alpha_pct = 100 * alpha95), 1)
@
  \vfill\kthehu{w8qU8}
\end{frame}

\begin{frame}[label=w8sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{itemize}
    \item (a) gabim: duhet \texttt{sqrt(252)}.
    \item (b) \textbf{e saktë}: $P=C-S_0+Ke^{-rT}$.
    \item (c) gabim: $F=S_0e^{+rT}$.
  \end{itemize}
