<<w6h6-setup, include=FALSE>>=
suppressMessages({library(lifecontingencies); library(MASS)})
library(ggplot2)
th  <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0) format(round(x, d), big.mark = " ", nsmall = d)
mt  <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
gm_q <- function(x, A, B, c) 1 - exp(-A - B * c^x * (c - 1) / log(c))
@

\begin{frame}{Detyra e aktuarit}
  \begin{Shembull}[(AutoSig Jetë, kompani fiktive)]
    Kompania nis një produkt pensioni për çifte. Bordi kërkon:
    \begin{enumerate}
      \item tabelën e vdekshmërisë së \textbf{portofolit} të vet, jo të popullsisë;
      \item tarifën për moshat 60--70, me normën teknike 3\%;
      \item rezervën e një kontrate pas 5 vitesh;
      \item sa i sigurt është vlerësimi.
    \end{enumerate}
  \end{Shembull}
  \vfill\LO{S1}\;\LO{C1}\;\LO{C2}\;\LO{C3}
\end{frame}

