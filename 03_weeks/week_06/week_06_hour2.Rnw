    \item G.~A.~Spedicato, vinjeta e paketës \Rkey{lifecontingencies} (kolonat e komutimit të \texttt{actuarialtable}).
    \item Programi i lëndës MFM2SII09: tabelat aktuariale.
  \end{itemize}
\end{frame}
