% ------------------------------------------------------------
\subsection{Kuizi i ditës}
% ------------------------------------------------------------

\begin{frame}{Kuizi: si provimi përfundimtar}
  \begin{itemize}
    \item<1-> Provimi: \textbf{15\%} pyetje teorike, \textbf{85\%} ushtrime.
    \item<2-> Kuizi i sotëm:
      \begin{itemize}
        \item 2 pyetje teorike (T1--T2);
        \item 8 ushtrime (U1--U8): gjashtë pa ndihmën e PC, dy në R.
      \end{itemize}
    \item<3-> 30 minuta punë individuale, pastaj kontroll bashkë.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}Dy jetë 90-vjeçare, të pavarura, $i=4\%$:\\
    $l^{(x)}_{90..94}=1000,\,800,\,500,\,200,\,0$; \quad $l^{(y)}_{90..94}=1000,\,900,\,600,\,300,\,0$.\end{Keshille}}
\end{frame}

\begin{frame}[label=w6qT1]{T1 · Teori}
  \begin{Parashiko}[(zgjedhje e shumëfishtë)]
    Cili përkufizim i $M_x$ është i saktë?
    \begin{enumerate}
      \item[A)] $M_x=\sum_{k\ge0}D_{x+k}$
      \item[B)] $M_x=\sum_{k\ge0}C_{x+k}$, me $C_x=v^{x+1}d_x$
      \item[C)] $M_x=v^x\,d_x$
      \item[D)] $M_x=\sum_{k\ge0}N_{x+k}$
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{w6sT1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qT2]{T2 · Teori}
  \begin{Parashiko}[(zgjedhje e shumëfishtë)]
    Cila lidhje \textbf{kërkon} pavarësinë e $T_x$ dhe $T_y$?
    \begin{enumerate}
      \item[A)] $\ddot a_{\overline{xy}}=\ddot a_x+\ddot a_y-\ddot a_{xy}$
      \item[B)] ${}_tp_{xy}={}_tp_x\cdot{}_tp_y$
      \item[C)] $A_{xy}=1-d\,\ddot a_{xy}$
      \item[D)] $A_{\overline{xy}}=A_x+A_y-A_{xy}$
    \end{enumerate}
  \end{Parashiko}
  \shkoTe{w6sT2}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU1]{U1 · Komutimet pa ndihmën e PC}
  \begin{Ushtrim}[(jeta $(x)$, baza e moshës 90)]
    \begin{enumerate}
      \item Llogarit $D_{90},\dots,D_{93}$ me $D_{90+k}=v^k\,l_{90+k}$.
      \item Llogarit $N_{90},\dots,N_{93}$.
      \item Llogarit $\ddot a_{90}=N_{90}/D_{90}$ dhe $\ddot a_{91}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU2]{U2 · $C_x$ dhe $M_x$}
  \begin{Ushtrim}[(jeta $(x)$)]
    \begin{enumerate}
      \item Llogarit $C_{90},\dots,C_{93}$ dhe $M_{90}$.
      \item Llogarit $A_{90}=M_{90}/D_{90}$ dhe kontrollo me $A=1-d\,\ddot a$.
      \item Prima neto vjetore $P_{90}=M_{90}/N_{90}$ për 1\,000\,000 lekë.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU2}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU3]{U3 · Dy statuse}
  \begin{Ushtrim}
    \begin{enumerate}
      \item Llogarit ${}_tp_{xy}$ dhe ${}_tp_{\overline{xy}}$ për $t=0,\dots,3$.
      \item Llogarit $\ddot a_y$, $\ddot a_{xy}$ dhe $\ddot a_{\overline{xy}}$.
      \item Kontrollo $\ddot a_{\overline{xy}}=\ddot a_x+\ddot a_y-\ddot a_{xy}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU3}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU4]{U4 · Sigurimet dhe anuiteti i të vesë}
  \begin{Ushtrim}
    \begin{enumerate}
      \item Llogarit $A_{xy}$ dhe $A_{\overline{xy}}$.
      \item Llogarit $\ddot a_{x|y}$: pagesa për $(y)$ pas vdekjes së $(x)$.
      \item Prima neto vjetore $P_{xy}=A_{xy}/\ddot a_{xy}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU4}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU5]{U5 · Opsioni 60\%}
  \begin{Ushtrim}
    Çifti ka 1\,000\,000 lekë kursim dhe zgjedh: 100\% sa janë të dy gjallë, 60\% për të mbijetuarin.
    \begin{enumerate}
      \item Shkruaj vlerën e anuitetit me $\ddot a_{xy}$ dhe $\ddot a_{\overline{xy}}$.
      \item Llogarit pensionin vjetor $P$ në fillim të vitit.
      \item Sa merr i mbijetuari në vit?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU5}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU6]{U6 · Tabela e përzier}
  \begin{Ushtrim}
    Një portofol 90-vjeçarësh ka gjysmën me tabelën e $(x)$ dhe gjysmën me tabelën e $(y)$.
    \begin{enumerate}
      \item Llogarit ${}_tp^{\text{mix}}$ dhe $\ddot a^{\text{mix}}_{90}$.
      \item Llogarit $q^{\text{mix}}_{91}$ saktë dhe me mesataren e $q$-ve.
      \item Shpjego me një fjali diferencën.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU6}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU7]{U7 · Në R}
  \begin{Ushtrim}
    \begin{enumerate}
      \item Krijo dy objekte \texttt{actuarialtable} për $(x)$ dhe $(y)$, moshat 90--94, \texttt{interest = 0.04}.
      \item Kontrollo U3 me \texttt{axyzn()} për \texttt{"joint"} dhe \texttt{"last"}.
      \item Kontrollo U4 me \texttt{Axyzn()}, një herë pa \texttt{n} dhe një herë me \texttt{n = 4}. Çfarë vëren?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU7}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w6qU8]{U8 · Në R}
  \begin{Ushtrim}
    \begin{enumerate}
      \item Përdor \texttt{commute()} (Ora 3) mbi \texttt{soa08Act} me $i=4\%$.
      \item Llogarit $\ddot a_{65}$, $A_{65}$ dhe $(IA)_{65}$ nga kolonat.
      \item Krahasoji me \texttt{axn(soa08Act, 65, i = 0.04)} dhe me vlerat për 6\%.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{w6sU8}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Gabimet e zakonshme}
% ------------------------------------------------------------

\begin{frame}{Klinika e gabimeve (1/2): komutimet}
  \begin{enumerate}
    \item $C_x=v^x d_x$ në vend të $v^{x+1}d_x$: çdo $A$ del $(1+i)$ herë më i madh.
    \item $N_{x+n+1}$ në vend të $N_{x+n}$ për $\ddot a_{x:\overline n|}$: indeksi i parë që \textbf{nuk} paguhet.
    \item $D_x$ me 6\% dhe $M_x$ me 3\%: një tabelë komutimi vlen për \textbf{një} normë.
    \item Krahasim absolut i kolonave në moshat e larta: përdor diferencën \textbf{relative}.
  \end{enumerate}
\end{frame}

\begin{frame}{Klinika e gabimeve (2/2): disa jetë}
  \begin{enumerate}
    \item $\ddot a_{x|y}=\ddot a_y-\ddot a_x$: e sakta është $\ddot a_y-\ddot a_{xy}$.
    \item $q_{xy}=q_x+q_y$: harron $-q_xq_y$.
    \item Vektorë mbijetese me gjatësi të ndryshme: R \textbf{ricikloi} pa gabim.
    \item \texttt{Axyzn()} pa \texttt{n}: horizonti i paracaktuar mund të jetë i shkurtër (U7).
    \item Tabela e përzier me mesataren e $q$-ve: përziej ${}_tp$.
  \end{enumerate}
\end{frame}

\begin{frame}[label=w6qGab7]{Gjej gabimin: raundi i shpejtë}
  Tre studentë, tri rreshta. Cili është i saktë?
  \begin{enumerate}
    \item[(a)] \texttt{a\_last <- axn(tx, 90) + axn(ty, 90) - axyzn(list(tx, ty), x = c(90, 90))}
    \item[(b)] \texttt{A\_joint <- 1 - 0.04 * axyzn(list(tx, ty), x = c(90, 90))}
    \item[(c)] \texttt{p\_last <- px * py}
  \end{enumerate}
  \vfill\shkoTe{w6sGab7}{Shiko zgjidhjen}
\end{frame}

