\subsection{Fletë-kujtesë}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesë (1/3): \Rkey{lifecontingencies}}
  \begin{center}
    \small
    \begin{tabular}{ll}
      \toprule
      Funksioni & Çfarë jep \\
      \midrule
      \texttt{as(act, "data.frame")} & kolonat $D, N, C, M, R$ \\
      \texttt{axn}, \texttt{Axn}, \texttt{IAxn}, \texttt{DAxn} & një jetë \\
      \texttt{axyzn(L, x, status)} & $\ddot a_{xy}$, $\ddot a_{\overline{xy}}$ \\
      \texttt{Axyzn(L, x, n, status)} & $A_{xy}$, $A_{\overline{xy}}$ \\
      \texttt{exyzt}, \texttt{pxyzt} & jetëgjatësia, mbijetesa e statusit \\
      \texttt{rLifexyz(n, L, x, type = "Kx")} & simulim i jetëve \\
      \texttt{data(soa08Act)} & tabela ilustruese e SOA, $i=6\%$ \\
      \bottomrule
    \end{tabular}
  \end{center}
\end{frame}

\begin{frame}{Fletë-kujtesë (2/3): formula}
  \begin{center}
    \small
    \begin{tabular}{ll}
      \toprule
      $\ddot a_x=N_x/D_x$ & $A_x=M_x/D_x$ \\
      $(IA)_x=R_x/D_x$ & $P_x=M_x/N_x$ \\
      $M_x=D_x-d\,N_x$ & $R_x=N_x-d\,S_x$ \\
      $q_{xy}=q_x+q_y-q_xq_y$ & $A_u=1-d\,\ddot a_u$ \\
      $\ddot a_{\overline{xy}}=\ddot a_x+\ddot a_y-\ddot a_{xy}$ & $\ddot a_{x|y}=\ddot a_y-\ddot a_{xy}$ \\
      $\ddot a^{(60\%)}=0.6\,\ddot a_{\overline{xy}}+0.4\,\ddot a_{xy}$ & ${}_tp^{\text{mix}}=w\,{}_tp^{(1)}+(1-w)\,{}_tp^{(2)}$ \\
      \bottomrule
    \end{tabular}
  \end{center}
\end{frame}

\begin{frame}[fragile]{Fletë-kujtesë (3/3): kodi tipik}
<<w6h7-cheat, eval=FALSE>>=
commute <- function(x, lx, i) {          # Hour 3
  v <- 1 / (1 + i); dx <- lx - c(lx[-1], 0)
  D <- v^x * lx;       N <- rev(cumsum(rev(D)))
  C <- v^(x + 1) * dx; M <- rev(cumsum(rev(C)))
  data.frame(x, Dx = D, Nx = N, Cx = C, Mx = M)
}
L <- list(tM, tF)                        # one table per life
axyzn(L, x = c(65, 62), status = "last")
Axyzn(L, x = c(65, 62), n = 49, status = "last")
@
\end{frame}

% ------------------------------------------------------------
\subsection{Detyrë shtëpie}
% ------------------------------------------------------------

\begin{frame}{Detyrë shtëpie (para Javës 7)}
  \begin{enumerate}
    \item Ndërto tabelën aktuariale të plotë (0--110, $D$ deri $R$) për \textbf{gratë} e Shqipërisë 2011 me $i=3\%$ dhe ruaje në CSV.
    \item Llogarit tarifën e Orës 6 (60--70) me tabelat e Shqipërisë 2011 për \textbf{të dy} bashkëshortët.
    \item Simulo 10\,000 çifte me \texttt{rLifexyz()} dhe vlerëso $P(\text{gruaja mbijeton burrin})$ për diferencat 0, 3, 6 vjet.
  \end{enumerate}
  \small Dorëzim: një skript R i riprodhueshëm (\texttt{set.seed}) dhe një faqe me interpretim.
\end{frame}

% ------------------------------------------------------------
\subsection{Java 7}
% ------------------------------------------------------------

\begin{frame}{Java 7: sigurime rritëse, zbritëse dhe rezerva}
  \begin{itemize}
    \item<1-> $(IA)_x$ dhe $(DA)^1_{x:\overline n|}$: \texttt{IAxn()} dhe \texttt{DAxn()} (sot i pamë me $R_x$).
    \item<2-> Anuitetet e menjëhershme, të shtyra dhe me afat: $a_x$, $\ddot a_x$, ${}_{m|}\ddot a_x$.
    \item<3-> Primat neto dhe \textbf{rezervat matematike prospektive}.
    \item<4-> Krahasimi Shqipëria / sintetike / SOA për çdo produkt.
  \end{itemize}
  \onslide<5->{\vfill\LO{C2}\;\LO{C3}}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint i ditës}
  \begin{enumerate}
    \item Me cilat dy kolona llogaritet $P_x$, dhe pse $D_x$ nuk duhet?
    \item Pse $\ddot a_{\overline{xy}}$ i Petritit dhe Dritës është më afër $\ddot a_y$ se $\ddot a_x$?
    \item Si e ndërtojmë tabelën e portofolit nga përvoja e kompanisë?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) $M_x/N_x$, $D_x$ thjeshtohet; (2) Drita jeton më gjatë;
  (3) $\hat q_x=D_x/E_x$, zbutja me Makeham (MLE), mbyllja në 110.}
\end{frame}

\begin{frame}{Përmbledhje e Javës 6}
  \begin{itemize}
    \item Numrat e komutimit: çdo funksion = raport kolonash; identikë me \texttt{soa08Act}. \LO{C1}
    \item ``Funksionet e përziera'': (1) disa jetë, (2) tabela të përziera. \LO{K2}
    \item Petriti dhe Drita: $\ddot a_{xy}$, $\ddot a_{\overline{xy}}$, opsioni 60\%, simulimi. \LO{S2}
    \item Rasti i portofolit: Makeham MLE, tarifa, rezerva në tri gjendje. \LO{C2}\;\LO{C3}
  \end{itemize}
\end{frame}

