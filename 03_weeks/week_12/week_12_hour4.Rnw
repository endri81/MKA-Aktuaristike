% ============================================================
%  Java 12 · Ora 4 — Jetë I: tabelat, funksionet bazë, disa jetë (Javët 5–6)
% ============================================================
\section{Jetë I}

\begin{frame}{Ora 4 · Jetë I}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

<<w12h4-setup, include=FALSE>>=
mt4  <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
hld4 <- read.csv(file.path(DATA, "albania_lifetables_HLD_1950_2011.csv"), check.names = FALSE)
tM4 <- new("actuarialtable", x = mt4$age, lx = mt4$lx_male,   interest = 0.05)
tF4 <- new("actuarialtable", x = mt4$age, lx = mt4$lx_female, interest = 0.05)
@

% ------------------------------------------------------------
\subsection{Rifreskim}
% ------------------------------------------------------------

\begin{frame}{Funksionet bazë (Java 5)}
  \begin{itemize}
    \item<1-> $d_x=l_x-l_{x+1}$, \; $q_x=d_x/l_x$, \; $_tp_x=l_{x+t}/l_x$.
    \item<2-> Jetëgjatësia e mbetur e plotë në vite (\emph{curtate}): $e_x=\sum_{t\ge1}{}_tp_x$; \; e plotë (\emph{complete}): $\mathring e_x\approx e_x+\tfrac12$.
    \item<3-> Sigurimi i jetës: $A_x=\sum_{k\ge0}v^{k+1}\,{}_kp_x\,q_{x+k}$; \; anuiteti paraprak: $\ddot a_x=\sum_{k\ge0}v^k\,{}_kp_x$.
    \item<4-> Lidhja: $\ddot a_x=\dfrac{1-A_x}{d}$, \; $d=\dfrac{i}{1+i}$.
  \end{itemize}
\end{frame}

\begin{frame}{Funksionet e përziera dhe disa jetë (Java 6)}
  \begin{itemize}
    \item<1-> Komutimi: $D_x=v^xl_x$, \; $N_x=\sum_{k\ge0}D_{x+k}$, \; $C_x=v^{x+1}d_x$, \; $M_x=\sum_{k\ge0}C_{x+k}$.
    \item<2-> $\ddot a_x=N_x/D_x$, \; $A_x=M_x/D_x$, \; $_nE_x=D_{x+n}/D_x$.
    \item<3-> Dy jetë të pavarura: $_tp_{xy}={}_tp_x\cdot{}_tp_y$ (\emph{joint}); \; $_tp_{\overline{xy}}={}_tp_x+{}_tp_y-{}_tp_{xy}$ (\emph{last survivor}).
    \item<4-> Në R: \texttt{axyzn(list(tM, tF), c(x, y), status = "joint")}.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime pa ndihmën e PC}
% ------------------------------------------------------------

\begin{frame}[label=w12q4a]{Ushtrim 1 · Tabela me tri mosha}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    $l_{60}=1000$, $l_{61}=950$, $l_{62}=880$, $l_{63}=0$; \; $i=5\%$; \;
    $v=0.952381$, $v^2=0.907029$, $v^3=0.863838$.
    \begin{enumerate}
      \item Llogarit $q_{60}$, $_2p_{60}$ dhe $e_{60}$.
      \item Llogarit $A_{60}$ dhe $\ddot a_{60}$.
      \item Kontrollo: $\ddot a_{60}=(1-A_{60})/d$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj4a}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q4b]{Ushtrim 2 · Dy jetë}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    Bashkëshortët: $_{10}p_x=0.90$, $_{10}p_y=0.95$, të pavarur.
    \begin{enumerate}
      \item Probabiliteti që të dy të jenë gjallë pas 10 vjetësh.
      \item Probabiliteti që të paktën njëri të jetë gjallë.
      \item Probabiliteti që saktësisht njëri të jetë gjallë.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj4b}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q4c]{Ushtrim 3 · Komutimi}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    Jepen: $D_{65}=1200$, $N_{65}=14\,000$, $M_{65}=520$, $D_{75}=550$, $N_{75}=4\,800$.
    \begin{enumerate}
      \item Llogarit $\ddot a_{65}$ dhe $A_{65}$.
      \item Llogarit $_{10}E_{65}$.
      \item Llogarit anuitetin e përkohshëm $\ddot a_{65:\overline{10}|}=(N_{65}-N_{75})/D_{65}$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj4c}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q4d]{Ushtrim 4 · Teori}
  \begin{Parashiko}[(zgjedhje e shumëfishtë)]
    Për të njëjtin person, cila renditje është gjithmonë e vërtetë (me $i>0$)?
    \begin{enumerate}
      \item[A)] $A_x<A^1_{x:\overline n|}$
      \item[B)] $\ddot a_{x:\overline n|}\le\ddot a_x$
      \item[C)] $_nE_x>A^1_{x:\overline n|}$
      \item[D)] $e_x>\mathring e_x$
    \end{enumerate}
  \end{Parashiko}
  \vfill\shkoTe{w12zgj4d}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime në R}
% ------------------------------------------------------------

\begin{frame}[fragile]{Ushtrim 5 · Tabela sintetike kundrejt modelit të vërtetë}
<<w12h4-gm>>=
gm4 <- function(x, A, B, c) 1 - exp(-A - B * c^x * (c - 1) / log(c))   # Gompertz-Makeham q_x
ages4 <- c(30, 50, 70, 90)
round(rbind(table = mt4$qx_male[match(ages4, mt4$age)],
            truth = gm4(ages4, 0.0005, 0.000022, 1.105)), 6)
round(c(e0_curtate = exn(tM4, 0), e0_complete = exn(tM4, 0, type = "complete"), e0_truth_README = 76.3), 2)
@
  \small \textbf{Sintetike}: Gompertz--Makeham, burra ($A=0.0005$, $B=0.000022$, $c=1.105$).
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> $q_x$ e tabelës është saktësisht $q_x$ e Gompertz--Makeham-it: tabela është ndërtuar nga modeli.
    \item<2-> README jep $e_0\approx76.3$: kjo është jetëgjatësia \textbf{e plotë} $\mathring e_0$; \texttt{exn()} jep si parazgjedhje atë \emph{curtate}, gjysmë viti më pak.
  \end{itemize}
  \onslide<3->{
  \begin{Gabim}Të krahasosh $e_x$ (curtate) me një $\mathring e_x$ nga statistikat zyrtare: diferenca $\approx0.5$ vjet nuk është gabim i të dhënave.\end{Gabim}}
\end{frame}

\begin{frame}[fragile]{Ushtrim 6 · Shqipëria (HLD 2011) kundrejt tabelës sintetike}
<<w12h4-hld>>=
e0_hld <- subset(hld4, Year1 == 2011 & Age == 0)[, c("Sex", "e(x)")]
round(rbind(HLD_2011 = e0_hld[["e(x)"]],
            synthetic = c(exn(tM4, 0, type = "complete"), exn(tF4, 0, type = "complete"))), 2)
@
  \small Kolonat: burra, gra. HLD 2011 (\textbf{reale}) kundrejt tabelës sintetike.
\end{frame}

\begin{frame}[fragile,label=w12q4e]{Ushtrim 7 · Gjej gabimin}
<<w12h4-bug>>=
q65_bad  <- mt4$qx_male[65]                       # "q at age 65"
q65_good <- mt4$qx_male[mt4$age == 65]
c(q65_bad = q65_bad, q65_good = q65_good, qx_table = qxt(tM4, 65, 1))
@
  \small Pse \texttt{q65\_bad} nuk është $q_{65}$? Cili rregull e shmang këtë gabim në çdo tabelë?
  \hfill\shkoTe{w12zgj4e}{Zgjidhja}
\end{frame}

\begin{frame}[fragile]{Ushtrim 8 · Komutimi nga zero kundrejt \Rkey{lifecontingencies}}
<<w12h4-comm>>=
D4 <- mt4$lx_male * 1.05^-mt4$age
N4 <- rev(cumsum(rev(D4)))
C4 <- c(-diff(mt4$lx_male), 0) * 1.05^-(mt4$age + 1)
M4 <- rev(cumsum(rev(C4)))
i65 <- which(mt4$age == 65)
round(rbind(commutation = c(a65 = N4[i65] / D4[i65], A65 = M4[i65] / D4[i65]),
            lifecontingencies = c(axn(tM4, 65), Axn(tM4, 65))), 6)
@
\end{frame}

\begin{frame}[fragile]{Ushtrim 9 · Tabela SOA dhe dy jetë}
<<w12h4-soa>>=
round(c(a65_SOA = axn(soa08Act, 65), a65_synth_M = axn(tM4, 65),
        joint_65_62 = axyzn(list(tM4, tF4), c(65, 62), status = "joint"),
        last_65_62  = axyzn(list(tM4, tF4), c(65, 62), status = "last")), 4)
@
  \begin{itemize}
    \item \texttt{soa08Act}: tabela ilustruese e SOA, me $i=6\%$; tabela sintetike me $i=5\%$: nuk krahasohen drejtpërdrejt.
    \item Anuiteti ``last survivor'' $>$ anuiteti i një jete $>$ anuiteti ``joint''.
  \end{itemize}
\end{frame}

\begin{frame}[label=w12q4f]{Radha jote!}
  \begin{Ushtrim}[(8 minuta)]
    \begin{enumerate}
      \item Llogarit $\ddot a_{65}$ e tabelës sintetike (burra) me $i=6\%$ dhe krahasoje me \texttt{soa08Act}.
      \item Cila tabelë ka vdekshmëri më të ulët në moshat 65+? Si e kuptove?
      \item Llogarit primin e vetëm neto për anuitet ``last survivor'' 1\,000\,000 lekë në vit, për çiftin 65/62 me $i=5\%$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj4f}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesë: Javët 5--6}
  \begin{center}
    \small
    \begin{tabular}{ll}
      \toprule
      Detyra & R (\Rkey{lifecontingencies}) \\
      \midrule
      tabela & \texttt{new("actuarialtable", x, lx, interest)} \\
      $q_x$, $_tp_x$, $e_x$ & \texttt{qxt(t, x, n)}, \texttt{pxt(t, x, n)}, \texttt{exn(t, x)} \\
      $A_x$, $\ddot a_x$, $_nE_x$ & \texttt{Axn(t, x, n)}, \texttt{axn(t, x, n)}, \texttt{Exn(t, x, n)} \\
      dy jetë & \texttt{axyzn(list(t1, t2), c(x, y), status = "joint"/"last")} \\
      tabela SOA & \texttt{soa08Act} ($i=6\%$) \\
      \bottomrule
    \end{tabular}
  \end{center}
\end{frame}

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Shkruaj lidhjen midis $\ddot a_x$ dhe $A_x$.
    \item Si llogaritet $_tp_{\overline{xy}}$?
    \item Pse \texttt{mt\$qx\_male[65]} nuk është $q_{65}$?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) $\ddot a_x=(1-A_x)/d$; (2) $_tp_x+{}_tp_y-{}_tp_x\,{}_tp_y$;
  (3) tabela fillon nga mosha 0: elementi 65 është mosha 64.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 4}
  \begin{itemize}
    \item Tabela me tri mosha: $A_{60}$, $\ddot a_{60}$, kontrolli me $d$.
    \item Komutimi: $\ddot a_x=N_x/D_x$, $A_x=M_x/D_x$; nga zero $=$ \Rkey{lifecontingencies}.
    \item Tabela sintetike $=$ Gompertz--Makeham; $\mathring e_0$ kundrejt $e_0$.
    \item Dy jetë: joint $<$ një jetë $<$ last survivor.
  \end{itemize}
  \vfill
  \begin{block}{Ora 5}
    Jetë II: IA/DA, anuitetet, primet neto, rezervat.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 4)}
  \small
  \begin{itemize}
    \item G.~A.~Spedicato, vinjeta e paketës \Rkey{lifecontingencies}.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015: tabelat e jetës.
    \item Human Life-Table Database: \texttt{albania\_lifetables\_HLD\_1950\_2011.csv} (\textbf{reale}).
    \item README i të dhënave: \texttt{mortality\_table\_synthetic.csv} (sintetike).
  \end{itemize}
\end{frame}
