% ------------------------------------------------------------
\subsection{Pyetje teorike (15\%)}
% ------------------------------------------------------------

\begin{frame}{Pyetjet teorike të provimit}
  \begin{itemize}
    \item<1-> 15\% e provimit: pyetje të shkurtra mbi temat e leksioneve.
    \item<2-> Përgjigje e mirë: \textbf{përkufizim} $+$ \textbf{formula} $+$ \textbf{një fjali interpretim}.
    \item<3-> Katër pyetje stërvitore në slide-et e ardhshme: 2 minuta secila.
  \end{itemize}
\end{frame}

\begin{frame}[label=w12qT1]{T1}
  \begin{Parashiko}[(përgjigje e shkurtër)]
    Shpjego pse Chain-Ladder përdor faktorë të \textbf{peshuar me vëllimin} dhe jo mesataren e thjeshtë të raporteve.
  \end{Parashiko}
  \vfill\shkoTe{w12sT1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w12qT2]{T2}
  \begin{Parashiko}[(përgjigje e shkurtër)]
    Çfarë mat faktori i kredibilitetit $Z$? Pse $Z\to1$ kur vëllimi i kontratës rritet?
  \end{Parashiko}
  \vfill\shkoTe{w12sT2}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w12qT3]{T3}
  \begin{Parashiko}[(përgjigje e shkurtër)]
    Përkufizo rezervën prospektive $_tV$ dhe shpjego pse ajo është 0 në fillim të një kontrate me prime neto.
  \end{Parashiko}
  \vfill\shkoTe{w12sT3}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w12qT4]{T4}
  \begin{Parashiko}[(përgjigje e shkurtër)]
    Pse çmimi Black--Scholes nuk varet nga kthimi i pritur $\mu$ i aksionit?
  \end{Parashiko}
  \vfill\shkoTe{w12sT4}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{10 gabimet e semestrit}
% ------------------------------------------------------------

\begin{frame}{10 gabimet më të shpeshta (1/2): teoria}
  \begin{enumerate}
    \item<1-> Norma vjetore me këste mujore (\texttt{tvm}, Java 2).
    \item<2-> Frekuenca ``për dëm'' me ashpërsi ``për pagesë'' (Java 3).
    \item<3-> Trekëndësh inkremental në \texttt{MackChainLadder()} (Java 4).
    \item<4-> $_TE_x\times$ put: skontim i dyfishtë (Javët 8, 10).
    \item<5-> $\mu$ në vend të $r$: në formulë, në simulim, në $q$ (Javët 10--11).
  \end{enumerate}
\end{frame}

\begin{frame}{10 gabimet më të shpeshta (2/2): R}
  \begin{enumerate}
    \setcounter{enumi}{5}
    \item<1-> Indeksi i moshës: \texttt{qx[65]} është mosha 64 (Javët 5--7, 11).
    \item<2-> \texttt{IAxn}, \texttt{DAxn}, \texttt{Axyzn} pa \texttt{n} (Javët 6--7).
    \item<3-> \texttt{binomopt()} pa \texttt{crr = TRUE}; emrat e kthyer pa \texttt{unname()} (Javët 9--11).
    \item<4-> Njësitë e \texttt{greeks()}: Vega/Rho për 1\%, Theta për ditë (Java 10).
    \item<5-> \texttt{ifelse()} me një kusht; \texttt{NA} pa \texttt{na.rm} (Javët 1, 10).
  \end{enumerate}
\end{frame}

\begin{frame}[label=w12qG1]{Gjej gabimin: raundi i shpejtë (1/2)}
  Cili rresht është i saktë?
  \begin{enumerate}
    \item[(a)] \texttt{pmt(amt = 1e6, maturity = 120, rate = 0.06)} \;(kredi 10-vjeçare, 6\% në vit, këste mujore)
    \item[(b)] \texttt{MackChainLadder(incr2cum(tri\_incr))}
    \item[(c)] \texttt{Exn(t, 55, 10) * bsput(100, 100, 0.25, 0.03, 10, 0)} \;(GMMB)
  \end{enumerate}
  \vfill\shkoTe{w12sG1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[label=w12qG2]{Gjej gabimin: raundi i shpejtë (2/2)}
  Cili rresht është i saktë?
  \begin{enumerate}
    \item[(a)] \texttt{IAxn(tM, 40)} \;(sigurim rritës 20-vjeçar)
    \item[(b)] \texttt{q <- (exp(r * dt) - d) / (u - d)}
    \item[(c)] \texttt{theta\_year <- greeks(bscall(...))["Theta", 1]}
  \end{enumerate}
  \vfill\shkoTe{w12sG2}{Shiko zgjidhjen}
\end{frame}

