% ------------------------------------------------------------
\subsection{Punëtori: projekti i kursit}
% ------------------------------------------------------------

\begin{frame}{Projekti i kursit}
  \begin{itemize}
    \item<1-> Dy detyra: një për sigurimet e \textbf{jetës} dhe një për sigurimet e \textbf{jo-jetës}.
    \item<2-> Prezenca në orët e projektit: 100\%.
    \item<3-> Teksti i detyrave jepet nga pedagogu; këtu shohim \textbf{si} duhet ndërtuar raporti.
  \end{itemize}
\end{frame}

\begin{frame}{Struktura e raportit}
  \begin{enumerate}
    \item \textbf{Problemi}: çfarë vlerësohet, për kë, me çfarë qëllimi (1 paragraf).
    \item \textbf{Të dhënat}: burimi, reale apo sintetike, kontrollet e cilësisë.
    \item \textbf{Modeli dhe supozimet}: formulat, parametrat, pse janë zgjedhur.
    \item \textbf{Rezultatet}: tabela dhe grafikë me njësi; ``vlerësimi kundrejt së vërtetës'' kur dihet.
    \item \textbf{Ndjeshmëria}: 2--3 parametrat më të rëndësishëm.
    \item \textbf{Përfundimi}: një paragraf për menaxherin, pa formula.
  \end{enumerate}
\end{frame}

\begin{frame}[fragile]{Riprodhueshmëria}
<<w12h7-skel, eval=FALSE>>=
# project_life.R -- one script, runs top to bottom
library(lifecontingencies); library(derivmkts); library(ggplot2)
set.seed(2026)                                        # every simulation reproducible
DATA <- "data"                                        # relative path, no C:/Users/...
lt <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
## 1. data checks  2. model  3. results  4. sensitivity  5. figures
sessionInfo()                                         # package versions at the end
@
  \small Testi: një koleg e ekzekuton skriptin në kompjuterin e vet dhe merr të njëjtat numra.
\end{frame}

\begin{frame}{Lista kontrolli para dorëzimit}
  \begin{itemize}
    \item[$\square$] Skripti ekzekutohet nga fillimi në fund pa gabime, në një sesion të ri R.
    \item[$\square$] Çdo numër në raport vjen nga skripti (pa kopjim nga konsola).
    \item[$\square$] Çdo dataset është etiketuar \textbf{reale} ose \textbf{sintetike}.
    \item[$\square$] Njësitë (lekë, €, vite, \%) janë në çdo tabelë dhe grafik.
    \item[$\square$] Të paktën një kontroll i pavarur (formulë kundrejt paketës, ose simulim).
    \item[$\square$] Supozimet kryesore janë të shkruara qartë, me burim.
  \end{itemize}
\end{frame}

\begin{frame}[label=w12qP1]{Mendo -- diskuto me shokun -- ndaj}
  \begin{Ushtrim}[(5 minuta)]
    Dy raporte japin të njëjtin rezultat: ``rezerva $=$ 10.0 milionë €''.
    \begin{enumerate}
      \item Raporti A jep vetëm numrin. Raporti B jep edhe Mack SE dhe kuantilin 99.5\%. Cili është më i dobishëm, dhe pse?
      \item Çfarë duhet të shtojë raporti B që një auditor ta riprodhojë?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12sP1}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Mbyllja}
% ------------------------------------------------------------

\begin{frame}{Çfarë mësuam këtë semestër}
  \begin{itemize}
    \item \textbf{K1--K3}: \Rkey{stats}, funksionet e përziera, modelet aktuariale në R.
    \item \textbf{S1--S2}: analiza aktuariale dhe paketat e R-së për vlerësime.
    \item \textbf{C1}: tabela vdekshmërie: nga $l_x$ te tabela aktuariale e plotë.
    \item \textbf{C2}: rezervat teknike (IBNR) dhe matematike (prospektive).
    \item \textbf{C3}: garancitë dhe opsionet në kontratat e sigurimit.
  \end{itemize}
\end{frame}

\begin{frame}{Fjala e fundit}
  \begin{itemize}
    \item<1-> Një aktuar i mirë nuk është ai që di më shumë formula, por ai që \textbf{kontrollon} çdo numër.
    \item<2-> R është mjeti; gjykimi mbetet i juaji: supozimet, ndjeshmëria, interpretimi.
    \item<3-> Suksese në provim dhe në projekt!
  \end{itemize}
\end{frame}

\begin{frame}{Burime (Ora 7)}
  \small
  \begin{itemize}
    \item Programi i lëndës MFM2SII09: rezultatet e të nxënit, vlerësimi, literatura.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015.
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabiliteteve dhe Statistika Matematike me ilustrime në gjuhën R}, Kotti, 2021.
    \item Dokumentacioni i paketave: \Rkey{tvm}, \Rkey{actuar}, \Rkey{ChainLadder}, \Rkey{lifecontingencies}, \Rkey{derivmkts}.
  \end{itemize}
\end{frame}

