\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{Fletë-kujtesë: Java 3}
  \begin{center}
    \small
    \begin{tabular}{ll}
      \toprule
      Detyra & R \\
      \midrule
      përshtatja MLE & \texttt{fitdist(x, "gamma")}, \texttt{gofstat()} \\
      diskretizimi & \texttt{discretize(pgamma(x, ...), from, to, step, method)} \\
      $S$ me Panjer & \texttt{aggregateDist("recursive", model.freq, model.sev, lambda, x.scale)} \\
      rreziku & \texttt{unname(VaR(F, 0.995))}, \texttt{unname(CTE(F, 0.995))} \\
      simulimi & \texttt{rpois()}, \texttt{rgamma()}, \texttt{vapply()} \\
      \bottomrule
    \end{tabular}
  \end{center}
\end{frame}

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Shkruaj $E[S]$ dhe $\operatorname{Var}(S)$ për compound Poisson.
    \item Si ndryshon frekuenca kur shtohet franshiza?
    \item Pse përafrimi normal nënvlerëson VaR-in e dëmeve agregate?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) $\lambda E[X]$, $\lambda E[X^2]$; (2) $\lambda\to\lambda P(X>d)$;
  (3) $S$ ka asimetri pozitive, me bisht të djathtë më të rëndë se normalja.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 2}
  \begin{itemize}
    \item Panjer pa ndihmën e PC: $g_0$, $g_1$, $g_2$; stop-loss me $E[S]-E[\min(S,d)]$.
    \item Franshiza: ``për dëm'' kundrejt ``për pagesë''; frekuenca $\lambda P(X>d)$.
    \item Motor: $\hat\alpha=\Sexpr{fmt(sh2, 2)}$, mesatarja \Sexpr{fmt(sh2 * sc2)} € (e vërteta 2, 900 €).
    \item VaR$_{99.5\%}$ për 100 polica-vit: \Sexpr{fmt(unname(VaR(F2, 0.995)))} €; normalja e nënvlerëson.
  \end{itemize}
  \vfill
  \begin{block}{Ora 3}
    Jo-jetë II: Chain-Ladder, Mack, bootstrap, kredibiliteti.
  \end{block}
\end{frame}

