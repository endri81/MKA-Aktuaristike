<<w12h2-setup, include=FALSE>>=
motor <- read.csv(file.path(DATA, "motor_portfolio_synthetic.csv"))
@

% ------------------------------------------------------------
\subsection{Rifreskim}
% ------------------------------------------------------------

\begin{frame}{Modeli kolektiv (Java 3)}
  \[ S=X_1+\dots+X_N,\qquad N\sim\text{Poisson}(\lambda),\quad X_i\text{ i.i.d., të pavarur nga }N \]
  \begin{itemize}
    \item<2-> $E[S]=\lambda\,E[X]$, \qquad $\operatorname{Var}(S)=\lambda\,E[X^2]$.
    \item<3-> Panjer (Poisson, $X\in\{0,1,2,\dots\}$):
      \[ g_0=e^{-\lambda(1-f_0)},\qquad g_k=\frac{\lambda}{k}\sum_{j=1}^{k}j\,f_j\,g_{k-j}. \]
    \item<4-> Stop-loss: $E[(S-d)^+]=E[S]-E[\min(S,d)]$.
  \end{itemize}
\end{frame}

\begin{frame}{Modifikimet e mbulimit (Java 3)}
  \begin{itemize}
    \item \textbf{Franshiza} $d$ për çdo dëm: kompania paguan $(X-d)^+$.
      \begin{itemize}
        \item për dëm (\emph{per loss}): $E[(X-d)^+]$;
        \item për pagesë (\emph{per payment}): $E[X-d\mid X>d]=\dfrac{E[(X-d)^+]}{P(X>d)}$.
      \end{itemize}
    \item \textbf{Limiti} $u$: $E[\min(X,u)]$ (\emph{limited expected value}, \texttt{levexp()}, \ldots).
    \item Numri i pagesave pas franshizës: Poisson$(\lambda\,P(X>d))$.
  \end{itemize}
  \begin{Gabim}Të përziesh ``për dëm'' me ``për pagesë'': frekuenca dhe ashpërsia duhet të jenë në të njëjtën bazë.\end{Gabim}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime pa ndihmën e PC}
% ------------------------------------------------------------

\begin{frame}[label=w12q2a]{Ushtrim 1 · Panjer}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    $N\sim\text{Poisson}(2)$; \; $P(X=1)=0.6$, $P(X=2)=0.4$; \; $e^{-2}=0.13534$.
    \begin{enumerate}
      \item Llogarit $E[S]$ dhe $\operatorname{Var}(S)$.
      \item Llogarit $g_0$, $g_1$, $g_2$ me Panjer, dhe $P(S\le2)$.
      \item Llogarit primin stop-loss $E[(S-2)^+]$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj2a}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q2b]{Ushtrim 2 · Franshiza dhe limiti}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    $X\sim\text{Eksponenciale}$ me mesatare 1000 €; \; $e^{-0.2}=0.81873$, $e^{-3}=0.04979$.
    \begin{enumerate}
      \item Franshizë $d=200$: $E[(X-d)^+]$ (për dëm) dhe $E[X-d\mid X>d]$ (për pagesë).
      \item Limit $u=3000$ pa franshizë: $E[\min(X,u)]$.
      \item Ndihmë: $E[(X-d)^+]=\int_d^\infty P(X>x)\,dx$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj2b}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q2c]{Ushtrim 3 · Gjej gabimin}
  \small Portofol: $\lambda=10$ dëme në vit, $X\sim\text{Exp}$(mesatare 1000), franshizë 200.
  \begin{columns}[T]
    \column{0.48\textwidth}
      \begin{block}{Studenti A}
        Ashpërsia për pagesë: 1000 (pa kujtesë).\\
        $E[S]=10\cdot1000=10\,000$.
      \end{block}
    \column{0.48\textwidth}
      \begin{block}{Studenti B}
        Ashpërsia për dëm: 818.73.\\
        $E[S]=10\cdot818.73=8187$.
      \end{block}
  \end{columns}
  \vspace{4pt}
  Kush ka të drejtë? Ku gabon tjetri? Jep edhe një rrugë të tretë që jep të njëjtin rezultat.
  \vfill\shkoTe{w12zgj2c}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q2d]{Ushtrim 4 · Teori}
  \begin{Parashiko}[(zgjedhje e shumëfishtë)]
    Për $S$ compound Poisson me $\lambda=50$ dhe dëme me bisht të rëndë, përafrimi normal i VaR$_{99.5\%}$ është zakonisht:
    \begin{enumerate}
      \item[A)] i saktë, sepse $\lambda$ është i madh;
      \item[B)] shumë i lartë;
      \item[C)] shumë i ulët, sepse $S$ ka asimetri pozitive;
      \item[D)] i pavlefshëm, sepse $S$ është diskret.
    \end{enumerate}
  \end{Parashiko}
  \vfill\shkoTe{w12zgj2d}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q2g]{Ushtrim 8 · VaR dhe TVaR pa ndihmën e PC}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    Humbja vjetore $S$ ka shpërndarjen:
    \begin{center}
      \begin{tabular}{lcccc}
        \toprule
        $s$ (€) & 0 & 1000 & 5000 & 20\,000 \\
        $P(S=s)$ & 0.50 & 0.30 & 0.15 & 0.05 \\
        \bottomrule
      \end{tabular}
    \end{center}
    \begin{enumerate}
      \item Llogarit $E[S]$ dhe VaR$_{90\%}$.
      \item Llogarit TVaR$_{90\%}$: mesatarja e 10\% të humbjeve më të këqija.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj2g}{Zgjidhja}
\end{frame}

\begin{frame}[label=w12q2h]{Ushtrim 9 · Përzierja e dëmeve individuale}
  \begin{Ushtrim}[(pa ndihmën e PC)]
    Dëmet: 95\% lognormale($\mu=7$, $\sigma=0.9$), 5\% Pareto me $\alpha=1.8$ mbi pragun $\theta=20\,000$ €.
    \; $e^{7.405}=1645.6$; \; mesatarja e Pareto-s: $\alpha\theta/(\alpha-1)$.
    \begin{enumerate}
      \item Llogarit $E[X]$ e përzierjes.
      \item Krahasoje me mesataren e mostrës \Sexpr{fmt(mean(claims$amount_eur), 1)} € (Ora 1).
      \item Sa \% e mesatares vjen nga 5\% e dëmeve të mëdha?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj2h}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Ushtrime në R}
% ------------------------------------------------------------

\begin{frame}[fragile]{Ushtrim 5 · Frekuenca dhe ashpërsia nga të dhënat}
<<w12h2-est>>=
lam2 <- sum(motor$n_claims) / sum(motor$exposure)           # claims per policy-year
x2 <- motor$claim_amount_eur[motor$n_claims == 1]           # single-claim policies
fit2 <- fitdist(x2 / 1000, "gamma")                         # in thousand EUR (scaling)
sh2 <- unname(fit2$estimate["shape"]); sc2 <- 1000 / unname(fit2$estimate["rate"])
round(rbind(estimate = c(lambda = lam2, shape = sh2, mean_sev = sh2 * sc2),
            truth = c(NA, 2, 900)), 4)
@
  \small \textbf{Sintetike}: frekuenca e vërtetë varet nga kovariatat (GLM, README), ndaj $\lambda$ nuk ka një ``të vërtetë'' të vetme.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Forma $\hat\alpha=\Sexpr{fmt(sh2, 2)}$ dhe mesatarja \Sexpr{fmt(sh2 * sc2)} €: afër së vërtetës (2 dhe 900 €), me \Sexpr{length(x2)} dëme.
    \item<2-> Përdorëm vetëm policat me \textbf{një} dëm: për to \texttt{claim\_amount\_eur} është vetë dëmi.
    \item<3-> Shkallëzimi (në mijë €): \texttt{fitdist()} konvergjon më mirë me numra të rendit 1.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Ushtrim 6 · Dëmet agregate për 100 polica-vit}
<<w12h2-agg>>=
L2 <- 100 * lam2
fx2 <- discretize(pgamma(x, shape = sh2, scale = sc2), from = 0, to = 20000, step = 100,
                  method = "rounding")
F2 <- aggregateDist("recursive", model.freq = "poisson", model.sev = fx2, lambda = L2,
                    x.scale = 100, maxit = 5000)
ES2 <- L2 * sh2 * sc2; SD2 <- sqrt(L2 * sh2 * (sh2 + 1) * sc2^2)
round(c(lambda = L2, mean_panjer = mean(F2), mean_exact = ES2, VaR995 = unname(VaR(F2, 0.995)),
        TVaR995 = unname(CTE(F2, 0.995)), VaR995_normal = ES2 + qnorm(0.995) * SD2))
@
\end{frame}

\begin{frame}[fragile]{Kontrolli me simulim}
<<w12h2-sim>>=
set.seed(2026)
N2 <- rpois(1e5, L2)
S2 <- vapply(N2, function(n) sum(rgamma(n, shape = sh2, scale = sc2)), numeric(1))
round(c(mean_sim = mean(S2), VaR995_sim = unname(quantile(S2, 0.995)),
        VaR995_panjer = unname(VaR(F2, 0.995))))
@
  \small Panjer (me diskretizim ``rounding'', hap 100 €) dhe simulimi pajtohen brenda gabimit të diskretizimit dhe të simulimit.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Mesatarja: Panjer $=$ formula $\lambda E[X]$. \textcolor{okgreen}{$\checkmark$}
    \item<2-> VaR$_{99.5\%}$ normal (\Sexpr{fmt(ES2 + qnorm(0.995) * SD2)}) është \textbf{më i ulët} se Panjer (\Sexpr{fmt(unname(VaR(F2, 0.995)))}):
      $S$ ka asimetri pozitive (Ushtrimi 4).
    \item<3-> TVaR $>$ VaR: mesatarja e humbjeve përtej VaR-it.
  \end{itemize}
\end{frame}

\begin{frame}[label=w12q2e]{Radha jote!}
  \begin{Ushtrim}[(8 minuta)]
    Kompania shton një franshizë 500 € për çdo dëm.
    \begin{enumerate}
      \item Llogarit $P(X>500)$ dhe frekuencën e re të pagesave për 100 polica-vit.
      \item Ndërto ashpërsinë për pagesë: $X-500\mid X>500$ (ndihmë: \texttt{discretize()} mbi
        $\big(F(x+500)-F(500)\big)/\big(1-F(500)\big)$).
      \item Llogarit $E[S]$ dhe VaR$_{99.5\%}$ të rinj. Sa \% ul franshiza VaR-in?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w12zgj2e}{Zgjidhja}
\end{frame}

\begin{frame}[fragile,label=w12q2f]{Ushtrim 7 · Stop-loss në R}
<<w12h2-sl>>=
sl2 <- function(d) {                                   # E[(S - d)+] from the Panjer cdf
  s <- knots(F2); p <- diff(c(0, F2(s)))
  sum(pmax(s - d, 0) * p)
}
round(sapply(c(10000, 15000, 20000, 25000), sl2))
@
  \small Primet stop-loss për pikat e mbajtjes $d=10\,000$, $15\,000$, $20\,000$, $25\,000$ €.
  \hfill\shkoTe{w12zgj2f}{Interpretimi}
\end{frame}

