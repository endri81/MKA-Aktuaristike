% ============================================================
%  Java 5 · Ora 7 — Zgjidhjet e kuizit (shtojca)
% ============================================================

<<w5s7-setup, include=FALSE>>=
suppressMessages(library(lifecontingencies))
mt <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
lx <- c(500, 400, 250, 100, 0); v <- 1 / 1.04; d <- 0.04 / 1.04; k <- 0:3
kp <- lx[k + 1] / lx[1]; kq <- (lx[k + 1] - lx[k + 2]) / lx[1]
@

\begin{frame}[label=w5sT1]{Zgjidhja T1}
  \textbf{B)} Nga $\mu_{x+s}=-\frac{d}{ds}\log l(x+s)$.
  \begin{itemize}
    \item A) Vetëm përafrim i rendit të parë, për $\mu$ të vogël.
    \item C), D) Supozojnë $\mu$ ose $q$ konstant dhe ngatërrojnë normën me probabilitetin.
  \end{itemize}
  \vfill\kthehu{w5qT1}
\end{frame}

\begin{frame}[label=w5sT2]{Zgjidhja T2}
  \textbf{C)} $\ddot a_x=E[(1-v^{K+1})/d]=(1-A_x)/d$.
  \begin{itemize}
    \item A) $i$ në vend të $d$. \; B) Vlen për të \textbf{përzierin}, jo për atë me afat. \; D) $a_x$ në vend të $\ddot a_x$.
  \end{itemize}
  \vfill\kthehu{w5qT2}
\end{frame}

\begin{frame}[label=w5sU1]{Zgjidhja U1}
  \begin{enumerate}
    \item $d_x$: 100, 150, 150, 100; \; $q_x$: 0.2, 0.375, 0.6, 1.
    \item ${}_2p_{80}=250/500=0.5$; \; ${}_{1|}q_{80}=d_{81}/l_{80}=150/500=0.3$.
    \item $e_{80}=(400+250+100)/500=1.5$.
  \end{enumerate}
  \vfill\kthehu{w5qU1}
\end{frame}

\begin{frame}[label=w5sU2]{Zgjidhja U2}
  \begin{enumerate}
    \item $L_x$: 450, 325, 175, 50; \; $T_{80}=1\,000$.
    \item $\mathring e_{80}=1\,000/500=2.0=e_{80}+0.5$. \textcolor{okgreen}{$\checkmark$}
  \end{enumerate}
  \vfill\kthehu{w5qU2}
\end{frame}

\begin{frame}[fragile,label=w5sU3]{Zgjidhja U3}
  \begin{enumerate}
    \item $\mu_{50}=0.001+0.0001\times117.39=0.001+0.011739=0.012739$.
    \item $\log2/\log1.1\approx7.27$ vite.
    \item Në moshat e reja $Bc^x$ është i vogël (në 20 vjeç: $0.0001\times6.73=0.00067<A$): dominon $A$.
  \end{enumerate}
<<w5s7-u3>>=
c(mu50 = 0.001 + 0.0001 * 1.1^50, doubling = log(2) / log(1.1),
  Bcx_20 = 0.0001 * 1.1^20)
@
  \vfill\kthehu{w5qU3}
\end{frame}

\begin{frame}[label=w5sU4]{Zgjidhja U4}
  \begin{enumerate}
    \item UDD: $1-0.5\times0.2=0.9$.
    \item Forca konstante: $0.8^{0.5}=0.8944$.
    \item Balducci: $0.8/(1-0.5\times0.2)=0.8/0.9=0.8889$.
  \end{enumerate}
  \small Renditja: UDD $>$ forca konstante $>$ Balducci. \textcolor{okgreen}{$\checkmark$}
  \vfill\kthehu{w5qU4}
\end{frame}

\begin{frame}[fragile,label=w5sU5]{Zgjidhja U5}
  \begin{itemize}
    \item $A_{80}=0.2v+0.3v^2+0.3v^3+0.2v^4=0.192308+0.277367+0.266699+0.170961=0.907335$.
    \item $\ddot a_{80}=1+0.8v+0.5v^2+0.2v^3=1+0.769231+0.462278+0.177799=2.409308$.
    \item $1-0.038462\times2.409308=0.907335$ \textcolor{okgreen}{$\checkmark$}; \; $P=0.907335/2.409308=0.376596$: \textbf{376\,596 lekë}.
  \end{itemize}
<<w5s7-u5>>=
A <- sum(v^(k + 1) * kq); a <- sum(v^k * kp)
round(c(A = A, a_due = a, check = 1 - d * a, P = 1e6 * A / a), 6)
@
  \vfill\kthehu{w5qU5}
\end{frame}

\begin{frame}[fragile,label=w5sU6]{Zgjidhja U6}
  \begin{itemize}
    \item $A^1_{80:\overline2|}=0.192308+0.277367=0.469675$; \; ${}_2E_{80}=0.5v^2=0.462278$; \; $\ddot a_{80:\overline2|}=1.769231$.
    \item $P^1=0.469675/1.769231=0.265468$: \textbf{265\,468 lekë}.
    \item $A_{80:\overline2|}=0.931953=1-0.038462\times1.769231$. \textcolor{okgreen}{$\checkmark$}
  \end{itemize}
<<w5s7-u6>>=
A1 <- sum((v^(k + 1) * kq)[1:2]); a2 <- sum((v^k * kp)[1:2]); E2 <- v^2 * kp[3]
round(c(A1 = A1, E2 = E2, a2 = a2, P1 = 1e6 * A1 / a2, AE = A1 + E2, check = 1 - d * a2), 6)
@
  \vfill\kthehu{w5qU6}
\end{frame}

\begin{frame}[fragile,label=w5sU7]{Zgjidhja U7}
<<w5s7-u7>>=
ltF  <- new("lifetable", x = mt$age, lx = mt$lx_female)
actF <- new("actuarialtable", x = mt$age, lx = mt$lx_female, interest = 0.04)
round(c(e65 = exn(ltF, 65, type = "complete"),
        term_premium = 1e6 * Axn(actF, 40, 20) / axn(actF, 40, 20),
        a65_monthly = axn(actF, 65, k = 12),
        pension_cost = 120000 * axn(actF, 65, k = 12)), 2)
@
  \small Pensioni 10\,000 lekë/muaj = 120\,000 lekë/vit, paguar në 12 këste.
  \vfill\kthehu{w5qU7}
\end{frame}

\begin{frame}[fragile,label=w5sU8]{Zgjidhja U8}
<<w5s7-u8>>=
P_def <- function(x) axn(actF, x, m = 65 - x) / axn(actF, x, n = 65 - x)
round(c(EPV_35 = axn(actF, 35, m = 30), premium_35 = P_def(35),
        premium_50 = P_def(50), ratio = P_def(50) / P_def(35)), 4)
@
  \small Më herët: më shumë vite pagese dhe më shumë vite interesi. Prima e 50-vjeçares del rreth \Sexpr{format(round(P_def(50) / P_def(35), 1))} herë më e lartë.
  \vfill\kthehu{w5qU8}
\end{frame}

\begin{frame}[label=w5sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{enumerate}
    \item \texttt{x = 1:111}: mosha 0 emërtohet 1; çdo rezultat zhvendoset me një moshë. E saktë: \texttt{x = mt\$age}.
    \item ${}_{10}p_{60}\ne p_{60}^{10}$: duhet \texttt{prod(1 - mt\$qx\_male[61:70])}.
    \item Mungon \texttt{interest = 0.05}: paketa përdor 3\% dhe prima del më e lartë se ajo e kontratës.
  \end{enumerate}
  \vfill\kthehu{w5qGab7}
\end{frame}
