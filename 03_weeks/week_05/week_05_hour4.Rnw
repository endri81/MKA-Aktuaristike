  \small
  \begin{itemize}
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015 (kapitulli për sigurimet e jetës).
    \item G.~A.~Spedicato, vinjeta e paketës \Rkey{lifecontingencies}.
    \item Programi i lëndës MFM2SII09: tabelat aktuariale, sigurimet dhe anuitetet bazë.
  \end{itemize}
\end{frame}
