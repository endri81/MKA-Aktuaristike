\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint i ditës}
  \begin{enumerate}
    \item Pse e kontrollojmë çdo rezultat me dy rrugë (nga zero dhe me paketën)?
    \item Çfarë i bën tabelat e Shqipërisë të vështira për t'u përdorur direkt?
    \item Pse prima e nivelit krijon një rezervë?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) gabimet e indeksit dhe të argumenteve nuk japin mesazh gabimi; (2) janë të shkurtuara dhe të vjetra;
  (3) në vitet e para prima e kalon koston e rrezikut, teprica ruhet për më vonë.}
\end{frame}

\begin{frame}{Përmbledhje e Javës 5}
  \begin{itemize}
    \item Tabela e vdekshmërisë: $l_x$, $d_x$, $q_x$, $p_x$, $e_x$, $L_x$, $T_x$. \LO{C1}
    \item Forca e vdekshmërisë, Makeham, moshat jo të plota; përshtatja me \texttt{nls()}. \LO{K3}
    \item ${}_nE_x$, $A_x$, $\ddot a_x$, prima neto; $A=1-d\ddot a$. \LO{C3}
    \item \Rkey{lifecontingencies}: \texttt{lifetable}, \texttt{actuarialtable}. \LO{S2}
    \item Shqipëria: HLD 1950--2011, rindërtimi i 2011, Eurostat 2013--2024.
  \end{itemize}
\end{frame}

