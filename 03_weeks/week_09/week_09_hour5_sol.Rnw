% ============================================================

\begin{frame}[label=w9zgjPar5]{Zgjidhja: Parashiko}
  \begin{enumerate}
    \item $r$: nga $\approx0$ në \Sexpr{fmt(sens$r[5], 3)}: rritje e fortë.
    \item $T$: nga \Sexpr{fmt(sens$T[1], 3)} në \Sexpr{fmt(sens$T[5], 3)}: rritje e fortë.
    \item $\sigma$: nga \Sexpr{fmt(sens$sigma[1], 3)} në \Sexpr{fmt(sens$sigma[4], 3)}: pothuajse e njëjtë, jo monotone.
  \end{enumerate}
  \small Shumica parashikojnë një efekt të madh të $\sigma$. Por $\sigma$ rrit si $P_A$, si $P$: diferenca ndryshon pak.
  \vfill\kthehu{w9par5}
\end{frame}

\begin{frame}[label=w9zgjGab5]{Zgjidhja: Gjej gabimin}
  \begin{enumerate}
    \item \texttt{putopt = FALSE}: llogarit call-in amerikan, jo put-in. Pra \texttt{eep\_bad} $=C_A-P\approx C-P$.
    \item Nga parity: $C-P=S_0-Ke^{-rT}=100-97.0446=2.9554$.
  \end{enumerate}
  \small Mësim: një rezultat ``i njohur'' (këtu parity) ndihmon për të gjetur se cili argument është gabim.
  \vfill\kthehu{w9gab5}
\end{frame}

\begin{frame}[fragile,label=w9zgjUsh5]{Zgjidhja: Radha jote!}
<<w9h5-sol-ush>>=
p_q5 <- c(american = amq(100, 100, 0.25, 0.03, 1, TRUE, 0.05), european = bsput(100, 100, 0.25, 0.03, 1, 0.05))
p_q0 <- c(american = amq(100, 100, 0.25, 0.03, 1, TRUE, 0),    european = bsput(100, 100, 0.25, 0.03, 1, 0))
sym  <- c(call_A = amq(110, 100, 0.25, 0.03, 1, FALSE, 0.05),  put_A_swapped = amq(100, 110, 0.25, 0.05, 1, TRUE, 0.03))
round(rbind(q5 = c(p_q5, eep = unname(diff(rev(p_q5)))), q0 = c(p_q0, eep = unname(diff(rev(p_q0))))), 4)
round(sym, 4)
@
  \small Dividendi e ul primën e ushtrimit të hershëm të put-it pothuajse në zero. Simetria vlen. \textcolor{okgreen}{$\checkmark$}
  \vfill\kthehu{w9ush5}
\end{frame}
