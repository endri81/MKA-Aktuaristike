\begin{frame}[label=w9sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{itemize}
    \item (a) gabim: \texttt{put = FALSE} llogarit call-in; duhet \texttt{TRUE}.
    \item (b) \textbf{e saktë}: kufiri i poshtëm i put-it europian.
    \item (c) gabim: kufiri më i mirë është $\max(S_0-Ke^{-rT},0)$, më i lartë se $(S_0-K)^+$.
  \end{itemize}
  \vfill\kthehu{w9qGab7}
\end{frame}
