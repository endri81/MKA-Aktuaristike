        option_r4 = pa6(97, 0.04) - pe6(97, 0.04), option_r3 = pa6(97, 0.03) - pe6(97, 0.03))
round(u8)
@
  \small Me $r=4\%$, garancia totale bie, por pjesa e anulimit rritet (Ora 6).
  \vfill\kthehu{w9qU8}
