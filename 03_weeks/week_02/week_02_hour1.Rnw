\begin{frame}{Gabim i zakonshëm: funksione me të njëjtin emër}
  \begin{Gabim}
    \Rkey{fitdistrplus} ngarkon paketën \Rkey{MASS}, e cila ka një funksion \texttt{select()}.
    Nëse përdor edhe \Rkey{dplyr}, \texttt{select()} mund të thërrasë funksionin e gabuar.
  \end{Gabim}
  \pause
  \begin{Keshille}
    Zgjidhja: shkruaj paketën qartë, p.sh.\ \texttt{dplyr::select()}.
    R paralajmëron me mesazhin \texttt{The following object is masked}.
  \end{Keshille}
\end{frame}

