% ------------------------------------------------------------
\subsection{Dy pyetje}
% ------------------------------------------------------------

\begin{frame}{Dy pyetje në një zyrë në Tiranë}
  \begin{itemize}
    \item<1-> Departamenti i dëmeve pyet:
  \end{itemize}
  \onslide<2->{
  \begin{Shembull}[(pyetja 1: pasiguria)]
    ``Dëmet tona nuk janë të gjitha njësoj. Si shpërndahen shumat e tyre?
    Sa është një dëm `tipik' dhe sa i madh mund të jetë një dëm i rrallë?''
  \end{Shembull}}
  \begin{itemize}
    \item<3-> Një klient pyet:
  \end{itemize}
  \onslide<4->{
  \begin{Shembull}[(pyetja 2: koha)]
    ``Dua një kredi prej \textbf{5\,000\,000 lekësh} për \textbf{10 vjet} me \textbf{6\%} në vit.
    Sa është kësti mujor?''
  \end{Shembull}}
\end{frame}

\begin{frame}{Dy shtylla të çdo llogaritjeje aktuariale}
  \centering
  \begin{tikzpicture}[>=Stealth,
      b/.style={draw=uptblue,fill=uptlight,rounded corners=3pt,minimum width=3.6cm,
                minimum height=1.3cm,align=center,font=\small}]
    \node[b] (p) at (0,1.2) {\textbf{Pasiguria}\\shpërndarjet, \Rkey{stats}};
    \node[b] (t) at (0,-1.2) {\textbf{Koha}\\interesi, \Rkey{tvm}};
    \node[b,fill=accent!15,draw=accent,minimum width=3.2cm] (c) at (6,0)
         {\textbf{Çmimi, rezerva}\\vlera aktuale e pritshme};
    \draw[->,thick,uptmid] (p.east) -- (c.west);
    \draw[->,thick,uptmid] (t.east) -- (c.west);
  \end{tikzpicture}\par
  \vspace{8pt}
  \begin{itemize}
    \item<2-> Java 1: $A^1_{x:\overline{n}|}=\sum v^{k+1}\cdot\Pr(\dots)$ i përdori \textbf{të dyja}.
    \item<3-> Java 2: secilën shtyllë veç e veç, më thellë. \LO{K1} \LO{S2}
  \end{itemize}
\end{frame}

\begin{frame}{Pse e para është pasiguria?}
  \begin{itemize}
    \item<1-> Kompania nuk e di sa do të jetë dëmi i ardhshëm.
    \item<2-> Por mund të dijë \textbf{shpërndarjen}: cilat shuma janë të shpeshta, cilat të rralla.
    \item<3-> Nga shpërndarja: prima, rezerva, risigurimi, kapitali (Solvency II).
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}Një mesatare e vetme nuk mjafton: dy portofole me të njëjtën mesatare mund të kenë rrezik shumë të ndryshëm.\end{Keshille}}
\end{frame}

\begin{frame}{Pse e dyta është koha?}
  \begin{itemize}
    \item<1-> Kredi, anuitete, pensione: pagesa të \textbf{sigurta}, por në kohë të ndryshme.
    \item<2-> 1 lek sot $\neq$ 1 lek pas 10 vjetësh.
    \item<3-> Siguruesi investon primat: kthimi i investimit hyn në çmim.
    \item<4-> IFRS 17: detyrimet raportohen të \textbf{aktualizuara}.
  \end{itemize}
\end{frame}

\begin{frame}[label=w2tps1]{Mendo -- diskuto me shokun -- ndaj}
  \begin{Ushtrim}[(3 minuta)]
    Gjeni në çifte:
    \begin{enumerate}
      \item dy vende në një kompani sigurimi ku përdoret një \textbf{shpërndarje};
      \item dy vende ku përdoret \textbf{interesi}.
    \end{enumerate}
  \end{Ushtrim}
  \pause
  \small Shembuj: madhësia e dëmeve, numri i dëmeve; prima e jetës, rezervat matematike, kreditë e stafit, investimet.
\end{frame}

% ------------------------------------------------------------
\subsection{Objektivat}
% ------------------------------------------------------------

\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item<1-> të përshkruash të dhëna dëmesh me statistika dhe grafikë; \LO{K1}
    \item<2-> të përdorësh familjen \texttt{d/p/q/r} të librarisë \Rkey{stats}; \LO{K1}
    \item<3-> të vlerësosh parametrat me metodën e momenteve dhe me përgjasinë maksimale; \LO{K1}
    \item<4-> të zgjedhësh një shpërndarje me \Rkey{fitdistrplus}; \LO{S2}
    \item<5-> të llogaritësh këste, tabela amortizimi, NPV dhe IRR me \Rkey{tvm}. \LO{S2}
  \end{enumerate}
\end{frame}

\begin{frame}{Objektivat e kësaj ore}
  \begin{enumerate}
    \item<1-> Të kuptosh pse pasiguria dhe koha janë dy shtyllat.
    \item<2-> Të rifreskosh: ndryshorja e rastit, dendësia, funksioni i shpërndarjes, momentet, kuantilet.
    \item<3-> Të rifreskosh: interesi i thjeshtë dhe i përbërë, norma mujore dhe vjetore.
    \item<4-> Të llogaritësh pa ndihmën e PC një mesatare, një variancë dhe një këst.
  \end{enumerate}
\end{frame}

