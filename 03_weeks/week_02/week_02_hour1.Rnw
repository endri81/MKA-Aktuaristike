% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse $f(x)$ mund të jetë më i madh se 1, por $F(x)$ jo?
    \item Për një shpërndarje të anuar djathtas, cila është më e madhe: mesatarja apo mediana?
    \item Me 6\% nominale dhe këste mujore, cilën normë i jep funksionit \texttt{pmt()}?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) $f$ është dendësi, $F$ probabilitet; (2) mesatarja; (3) \texttt{0.06 / 12}.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 1}
  \begin{itemize}
    \item Dy shtylla: pasiguria (shpërndarjet) dhe koha (interesi).
    \item $F(x)=\Pr(X\le x)$; probabiliteti = sipërfaqja nën $f$.
    \item Dëmet janë të anuara: mesatarja $>$ mediana; dëmet e mëdha kanë peshë.
    \item Kësti i kredisë: $P=L\,j/(1-(1+j)^{-n})$; në R: \texttt{tvm::pmt()}.
  \end{itemize}
  \vfill
  \begin{block}{Ora 2}
    Shpërndarjet në detaje: familja \texttt{d/p/q/r}, lognormalja, metoda e momenteve, përgjasia maksimale.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 1)}
  \small
  \begin{itemize}
    \item Programi i lëndës MFM2SII09, FIMIF--UPT, 2025--2026.
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabiliteteve dhe Statistika
          Matematike me ilustrime në gjuhën R}, Kotti, 2021 (ndryshoret e rastit, momentet).
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015.
    \item Dokumentacioni i paketës \Rkey{tvm} (versioni \Sexpr{as.character(packageVersion("tvm"))}): \texttt{?pmt}.
    \item README i të dhënave: \texttt{individual\_claims\_synthetic.csv} (sintetike).
  \end{itemize}
\end{frame}
