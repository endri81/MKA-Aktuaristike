\subsection{Java 5}
% ------------------------------------------------------------

\begin{frame}{Java 5: tabelat e vdekshmërisë}
  \begin{itemize}
    \item<1-> Kalojmë te sigurimet e jetës: \Rkey{lifecontingencies}. \LO{C1}
    \item<2-> Objektet \texttt{lifetable} dhe \texttt{actuarialtable}; funksionet $l_x$, $d_x$, $q_x$, $p_x$, $e_x$.
    \item<3-> Tabelat reale të Shqipërisë (HLD) dhe tabela sintetike me të vërtetë të njohur.
    \item<4-> Sigurimet dhe anuitetet bazë: $A_x$, $\ddot a_x$, primat neto.
  \end{itemize}
  \onslide<5->{
  \begin{Shembull}[(pyetja e Javës 5)]
    Sa duhet të paguajë sot një 40-vjeçar shqiptar për një sigurim jete prej 1\,000\,000 lekësh?
  \end{Shembull}}
\end{frame}

\begin{frame}[fragile]{Përgatitja për Javën 5}
<<w4h7-prep, eval=FALSE>>=
install.packages("lifecontingencies")   # once, before next week
library(lifecontingencies)
@
  \pause
  \begin{Keshille}Të dhënat e Javës 5: \texttt{mortality\_table\_synthetic.csv} (sintetike) dhe
  \texttt{albania\_lifetables\_HLD\_1950\_2011.csv} (reale, Human Life-Table Database).\end{Keshille}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint i ditës}
  \begin{enumerate}
    \item Pse rezerva chain-ladder ka nevojë për një gabim standard?
    \item Çfarë kanë të përbashkët BF dhe kredibiliteti?
    \item Pse kontrolli i të dhënave vjen para çdo modeli?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) rezerva është vlerësim i rastit; IFRS 17 dhe Solvency II kërkojnë pasigurinë;
  (2) të dyja përziejnë përvojën me një vlerë paraprake, me peshë që rritet me informacionin;
  (3) modelet nuk e dallojnë një anomali (kolona 7) nga sjellja reale.}
\end{frame}

\begin{frame}{Përmbledhje e Javës 4}
  \begin{itemize}
    \item Trekëndëshi, chain-ladder, BF: rezerva e dëmeve. \LO{C2}
    \item Mack dhe bootstrap: gabimi standard dhe shpërndarja e rezervës. \LO{C3}
    \item IFRS 17 (RA) dhe Solvency II (BE, SCR, RM) mbi të njëjtin trekëndësh.
    \item Bühlmann, Bühlmann--Straub, Poisson--Gamma: primat me kredibilitet. \LO{C3}
    \item \Rkey{ChainLadder} dhe \texttt{actuar::cm()} në praktikë. \LO{S2}
  \end{itemize}
\end{frame}

\begin{frame}{Burime (Ora 7)}
  \small
  \begin{itemize}
    \item Programi i lëndës MFM2SII09, FIMIF--UPT.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015.
    \item M.~Gesmann et al., vinjeta e paketës \Rkey{ChainLadder} (të dhënat \texttt{RAA}).
    \item V.~Goulet et al., vinjeta e kredibilitetit në \Rkey{actuar}.
    \item README i të dhënave të kursit (të dhëna sintetike).
  \end{itemize}
\end{frame}

