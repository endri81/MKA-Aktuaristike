% ============================================================
%  Java 4 · Ora 3 — Laborator R I: chain-ladder dhe Mack nga zero
% ============================================================
\section{Laborator R I}

\begin{frame}{Ora 3 · Laborator R I}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

<<w4h3-setup, include=FALSE>>=
library(ggplot2)
th <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0)                               # thin space: safe in math mode
  gsub(" ", "\\\\,", format(round(x, d), big.mark = " ", nsmall = d))
mln <- function(x, d = 2) fmt(x / 1e6, d)
@

\begin{frame}{Plani i laboratorit}
  \begin{enumerate}
    \item<1-> Trekëndëshi si matricë $10\times10$ dhe diagonalja e fundit.
    \item<2-> Faktorët $\hat f_j$: me \texttt{sapply()} dhe me \texttt{colSums()}.
    \item<3-> Plotësimi i trekëndëshit, ultimate dhe rezerva.
    \item<4-> \textbf{Vlerësimi kundrejt së vërtetës}: faktorët dhe rezerva sipas vitit.
    \item<5-> Mack nga zero: $\hat\sigma_j^2$, gabimi standard sipas vitit dhe për totalin.
  \end{enumerate}
  \onslide<6->{\small Vetëm \textbf{base R}. Në fund krahasojmë me \Rkey{ChainLadder}: duhet të dalë saktësisht i njëjti numër.}
\end{frame}

% ------------------------------------------------------------
\subsection{Trekëndëshi si matricë}
% ------------------------------------------------------------

\begin{frame}[fragile]{Nga formati i gjatë te matrica}
<<w4h3-mat>>=
rt <- read.csv(file.path(DATA, "runoff_triangle_synthetic.csv"))
n  <- 10
C  <- matrix(NA_real_, n, n,
             dimnames = list(2016:2025, 1:n))
C[cbind(rt$accident_year - 2015, rt$dev_year)] <- rt$cum_paid_eur
round(C[c(1, 2, 9, 10), ] / 1e6, 2)          # a few rows, million EUR
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> \texttt{C[cbind(i, j)] <- x}: indeksim me \textbf{matricë indeksesh}, një çift $(i,j)$ për çdo rresht të të dhënave.
    \item<2-> \texttt{NA\_real\_}: qelizat e panjohura mbeten \texttt{NA}, jo 0 (ndryshe nga \texttt{xtabs()}).
    \item<3-> \texttt{dimnames}: rreshtat marrin emrat e viteve, kolonat numrat e zhvillimit.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}E njëjta teknikë punon për çdo të dhëna në format të gjatë: tabela e vdekshmërisë, kontratat e kredibilitetit.\end{Keshille}}
\end{frame}

\begin{frame}[fragile]{Diagonalja e fundit}
<<w4h3-latest>>=
latest <- C[cbind(1:n, n:1)]                 # C[1,10], C[2,9], ..., C[10,1]
names(latest) <- rownames(C)
round(latest / 1e6, 3)
@
  \small Për vitin $i$, zhvillimi i fundit i njohur është $n+1-i$: çiftet $(1,10),(2,9),\dots,(10,1)$.
\end{frame}

\begin{frame}[fragile,label=w4gab3]{Gjej gabimin}
<<w4h3-bug>>=
latest_bad <- diag(C)
round(latest_bad / 1e6, 3)
@
  \begin{enumerate}
    \item Çfarë merr \texttt{diag(C)}?
    \item Pse shumica e vlerave dalin \texttt{NA}?
    \item A është ndonjë nga pesë vlerat e para vlera e fundit e vitit të vet?
  \end{enumerate}
  \vfill\shkoTe{w4zgjGab3}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Faktorët e zhvillimit}
% ------------------------------------------------------------

\begin{frame}[fragile]{Faktorët me \texttt{sapply()}}
<<w4h3-f>>=
f <- sapply(1:(n - 1), function(j) {
  rows <- 1:(n - j)                          # years known in column j + 1
  sum(C[rows, j + 1]) / sum(C[rows, j])
})
round(f, 4)
@
  \small I njëjti kod si te trekëndëshi $3\times3$ i Orës 1: vetëm $n$ ndryshon.
\end{frame}

\begin{frame}[fragile]{Faktorët me \texttt{colSums()}}
<<w4h3-f2>>=
num <- colSums(C[, -1], na.rm = TRUE)                     # sum of C[, j + 1]
den <- colSums(C[, -n] * !is.na(C[, -1]), na.rm = TRUE)   # same rows in C[, j]
f2  <- num / den
all.equal(unname(f2), f)
@
  \begin{itemize}
    \item<2-> \texttt{!is.na(C[, -1])} është maskë: 1 kur kolona $j+1$ është e njohur, 0 ndryshe.
    \item<3-> Shumëzimi me maskën heq nga emëruesi rreshtat që nuk duhen.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Vlerësimi kundrejt së vërtetës: faktorët}
<<w4h3-ftrue>>=
p_true <- c(0.40, 0.65, 0.80, 0.88, 0.93, 0.96, 0.98, 0.99, 0.995, 1)
f_true <- p_true[-1] / p_true[-n]
round(rbind(estimate = f, truth = f_true, diff = f - f_true), 4)
@
\end{frame}

\begin{frame}[fragile]{Faktorët në një figurë}
<<w4h3-fplot, echo=FALSE, warning=FALSE, fig.height=3.1>>=
df <- rbind(data.frame(j = 1:9, f = f, type = "vleresimi"),
            data.frame(j = 1:9, f = f_true, type = "e verteta"))
ggplot(df, aes(j, f - 1, colour = type)) + geom_line() + geom_point(size = 2) +
  scale_y_log10() + scale_x_continuous(breaks = 1:9) +
  labs(x = "j", y = "f(j) - 1, shkalla log", colour = NULL) +
  th + theme(legend.position = "top")
@
  \small Pika e vlerësimit për $j=6$ mungon: $\hat f_6-1=0$ nuk ka logaritëm.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Faktorët e parë janë afër së vërtetës: shumë vite, shumë të dhëna.
    \item<2-> $\hat f_6=1$ saktësisht: anomalia e kolonës 7 (Ora 1). E vërteta: 1.0208.
    \item<3-> Faktorët e fundit mbështeten në 1--3 vite: luhaten shumë.
    \item<4-> $\hat f_1$ dhe $\hat f_5$ dalin \textbf{mbi} të vërtetën; $\hat f_6$ \textbf{nën}. Efektet te rezerva pjesërisht kompensohen.
  \end{itemize}
  \onslide<5->{
  \begin{block}{Pse?}
    Çdo $\hat f_j$ është vetë një vlerësim i rastit. Mack e mat këtë si ``gabim vlerësimi''.
  \end{block}}
\end{frame}

\begin{frame}[label=w4par3]{Parashiko para se ta ekzekutosh}
  \begin{Parashiko}
    Nëse do të përdornim faktorët e \textbf{vërtetë} $f_j$ në vend të $\hat f_j$:
    \begin{enumerate}
      \item rezerva totale do të ishte më e madhe apo më e vogël se me $\hat f_j$?
      \item cila do të ishte formula, me $p_j$ e vërtetë?
    \end{enumerate}
  \end{Parashiko}
  \vfill\shkoTe{w4zgjPar3}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Plotësimi dhe rezerva}
% ------------------------------------------------------------

\begin{frame}[fragile]{Plotësimi i trekëndëshit}
<<w4h3-fill>>=
Cfull <- C
for (j in 1:(n - 1)) {
  miss <- is.na(Cfull[, j + 1])
  Cfull[miss, j + 1] <- Cfull[miss, j] * f[j]
}
round(Cfull[7:10, 6:10] / 1e6, 3)            # lower-right corner
@
\end{frame}

\begin{frame}[fragile]{Ultimate dhe rezerva sipas vitit}
<<w4h3-res>>=
ult <- Cfull[, n]
res <- data.frame(latest = latest, dev_pct = 100 * latest / ult,
                  ultimate = ult, reserve = ult - latest)
round(res / c(1e6, 1, 1e6, 1e6)[col(res)], 3)[4:10, ]   # million EUR, %
c(total_reserve_mln = sum(res$reserve) / 1e6)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Rezerva totale chain-ladder: \textbf{\Sexpr{mln(sum(res$reserve))} mln €}.
    \item<2-> Viti 2025 jep \Sexpr{fmt(100 * res$reserve[10] / sum(res$reserve))}\% të rezervës: është vetëm \Sexpr{fmt(res$dev_pct[10], 1)}\% i zhvilluar.
    \item<3-> Viti 2016: rezerva 0, sepse ka mbaruar zhvillimin dhe nuk ka faktor bishti.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}\texttt{c(1e6, 1, 1e6, 1e6)[col(res)]}: një pjesëtues për çdo kolonë, pa cikël.\end{Keshille}}
\end{frame}

\begin{frame}[fragile]{Vlerësimi kundrejt së vërtetës: rezerva}
<<w4h3-rtrue>>=
dev <- n:1                                    # development of the latest cell
R_true <- latest * (1 / p_true[dev] - 1)      # expected reserve, true pattern
round(cbind(CL = res$reserve, truth = R_true) / 1e6, 3)[5:10, ]
c(CL = sum(res$reserve), truth = sum(R_true)) / 1e6
@
  \small ``E vërteta'' këtu = rezerva e \textbf{pritur} nëse e njohim modelin e vërtetë të zhvillimit.
\end{frame}

\begin{frame}[fragile]{Rezerva sipas vitit: figura}
<<w4h3-rplot, echo=FALSE, fig.height=3.1>>=
dr <- rbind(data.frame(ay = 2016:2025, R = res$reserve / 1e6, type = "chain-ladder"),
            data.frame(ay = 2016:2025, R = R_true / 1e6, type = "e verteta"))
ggplot(dr, aes(factor(ay), R, fill = type)) +
  geom_col(position = "dodge") +
  scale_fill_manual(values = c("#2C5AA0", "#E67E22")) +
  labs(x = "viti i aksidentit", y = "rezerva (mln EUR)", fill = NULL) +
  th + theme(legend.position = "top")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Chain-ladder: \Sexpr{mln(sum(res$reserve))} mln €; e vërteta e pritur: \Sexpr{mln(sum(R_true))} mln €.
    \item<2-> Diferenca \Sexpr{mln(sum(res$reserve) - sum(R_true))} mln € vjen nga disa faktorë: $\hat f_1,\hat f_3,\hat f_5,\hat f_7$ dalin mbi të vërtetën, $\hat f_2,\hat f_4,\hat f_6$ nën të. Bilanci neto: rezerva del më e madhe.
    \item<3-> A është kjo diferencë ``e madhe''? Na duhet një njësi matëse: \textbf{gabimi standard} i Mack-ut.
  \end{itemize}
\end{frame}

\begin{frame}[label=w4ndr3]{Ndrysho parametrin dhe shiko}
  \begin{Ushtrim}[(5 minuta)]
    Supozo që departamenti i dëmeve konfirmon: kolona 7 duhej të kishte pagesa.
    \begin{enumerate}
      \item Zëvendëso \texttt{f[6]} me vlerën e vërtetë $0.98/0.96$ dhe plotëso përsëri trekëndëshin.
      \item Sa rritet rezerva totale?
      \item Cilat vite aksidenti preken? Pse jo vitet 2016--2019?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w4zgjNdr3}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Mack nga zero}
% ------------------------------------------------------------

\begin{frame}[fragile]{$\hat\sigma_j^2$ në R}
<<w4h3-sigma>>=
sigma2 <- sapply(1:(n - 2), function(j) {
  rows <- 1:(n - j)
  Fij  <- C[rows, j + 1] / C[rows, j]        # individual factors
  sum(C[rows, j] * (Fij - f[j])^2) / (n - j - 1)
})
sigma2 <- c(sigma2, min(sigma2[n - 2]^2 / sigma2[n - 3],
                        sigma2[n - 3], sigma2[n - 2]))   # Mack (1993)
signif(sigma2, 3)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> $\hat\sigma_j^2$ ka njësinë e $C_{ij}$ (€): vlera të mëdha nuk do të thonë pasiguri të madhe.
    \item<2-> $\hat\sigma_6^2=0$: të gjithë $F_{i6}=1$, pa asnjë variacion. Përsëri kolona 7!
    \item<3-> $\hat\sigma_9^2$ vjen nga ekstrapolimi i Mack-ut: nuk ka asnjë shkallë lirie.
  \end{itemize}
  \onslide<4->{
  \begin{Gabim}$\hat\sigma_6^2=0$ do të thotë që modeli ``beson'' plotësisht te $\hat f_6=1$. Anomalia e të dhënave na jep një siguri të rreme.\end{Gabim}}
\end{frame}

\begin{frame}[fragile]{Gabimi standard sipas vitit}
<<w4h3-mack>>=
colsum <- sapply(1:(n - 1), function(k) sum(C[1:(n - k), k]))
msep_i <- sapply(1:n, function(i) {
  if (i == 1) return(0)
  k <- (n + 1 - i):(n - 1)                   # future development steps
  Cfull[i, n]^2 * sum(sigma2[k] / f[k]^2 * (1 / Cfull[i, k] + 1 / colsum[k]))
})
se_i <- sqrt(msep_i)
round(data.frame(reserve_mln = res$reserve / 1e6, se_mln = se_i / 1e6,
                 CV = se_i / res$reserve)[5:10, ], 3)
@
\end{frame}

\begin{frame}[fragile]{Kontroll me \Rkey{ChainLadder}}
<<w4h3-check, warning=FALSE>>=
library(ChainLadder)
trc <- as.triangle(rt, origin = "accident_year", dev = "dev_year",
                   value = "cum_paid_eur")
mk  <- MackChainLadder(trc, est.sigma = "Mack")
c(max_diff_reserve = max(abs(summary(mk)$ByOrigin$IBNR - res$reserve)),
  max_diff_se      = max(abs(mk$Mack.S.E[, n] - se_i)))
@
  \small Diferencat janë zero deri në gabimin e rrumbullakimit: kodi ynë = paketa.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> CV më i madh: vitet e mesme. Vitet e vjetra kanë rezervë të vogël; viti 2025 ka rezervë të madhe.
    \item<2-> Vitet 2016--2018 kanë gabim standard pothuajse 0: pak hapa të mbetur dhe $\hat\sigma_j^2$ të vogla.
    \item<3-> \texttt{est.sigma = "Mack"} riprodhon formulën me \texttt{min()} të Mack-ut. Parazgjedhja e paketës është ekstrapolim log-linear.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Gabimi standard i totalit \Zgj}
<<w4h3-total>>=
cov_term <- 0
for (i in 2:(n - 1)) for (l in (i + 1):n) {
  k <- (n + 1 - i):(n - 1)                   # steps shared by years i and l
  cov_term <- cov_term + Cfull[i, n] * Cfull[l, n] *
    sum(2 * sigma2[k] / f[k]^2 / colsum[k])
}
se_total <- sqrt(sum(msep_i) + cov_term)
c(se_total = se_total, package = summary(mk)$Totals["Mack S.E.:", 1],
  CV_total = se_total / sum(res$reserve))
@
  \small Termi i kovariancës: vitet $i<l$ ndajnë hapat $k\ge n+1-i$, pra të njëjtët $\hat f_k$.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Rezerva: \Sexpr{mln(sum(res$reserve))} mln €, me gabim standard \Sexpr{mln(se_total)} mln € (CV \Sexpr{fmt(100 * se_total / sum(res$reserve), 1)}\%).
    \item<2-> E vërteta e pritur \Sexpr{mln(sum(R_true))} mln € është \Sexpr{fmt((sum(res$reserve) - sum(R_true)) / se_total, 2)} gabime standarde larg.
    \item<3-> Pra diferenca chain-ladder -- e vërteta është plotësisht në përputhje me pasigurinë e modelit.
  \end{itemize}
  \onslide<4->{
  \begin{block}{Vlerësimi kundrejt së vërtetës}
    Chain-ladder ``nuk gaboi'': 10 vite të dhëna nuk mjaftojnë për një rezervë më të saktë se $\pm$\Sexpr{mln(se_total)} mln €.
  \end{block}}
\end{frame}

\begin{frame}{Gabim i zakonshëm: totali i gabimeve standarde}
  \begin{Gabim}
    \begin{enumerate}
      \item $\mathrm{se}(\hat R)=\sum_i\mathrm{se}(\hat R_i)$: \textbf{mbivlerëson} (supozon korrelacion të plotë).
      \item $\mathrm{se}(\hat R)=\sqrt{\sum_i\mathrm{se}(\hat R_i)^2}$: \textbf{nënvlerëson} (harron kovariancën).
    \end{enumerate}
  \end{Gabim}
  \pause
  \begin{center}
    \begin{tabular}{lr}
      \toprule
      Llogaritja & mln € \\
      \midrule
      $\sum_i\mathrm{se}(\hat R_i)$ & \Sexpr{mln(sum(se_i))} \\
      $\sqrt{\sum_i\mathrm{se}(\hat R_i)^2}$ & \Sexpr{mln(sqrt(sum(se_i^2)))} \\
      Mack me kovariancë (e sakta) & \Sexpr{mln(se_total)} \\
      \bottomrule
    \end{tabular}
  \end{center}
\end{frame}

\begin{frame}[label=w4ush3]{Radha jote!}
  \begin{Ushtrim}[(6 minuta)]
    Në praktikë, nga $\hat R$ dhe $\mathrm{se}(\hat R)$ ndërtohet një shpërndarje \textbf{lognormale} me të njëjtën mesatare dhe devijim:
    \[ \sigma_{\ln}^2=\log(1+\mathrm{CV}^2),\qquad \mu_{\ln}=\log\hat R-\sigma_{\ln}^2/2. \]
    \begin{enumerate}
      \item Llogarit kuantilin 75\% dhe 99.5\% të rezervës totale.
      \item Sa është ``marzhi'' mbi rezervën mesatare në secilin rast?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w4zgjUsh3}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Si merret diagonalja e fundit e një matrice trekëndëshi në R?
    \item Pse $\hat\sigma_6^2=0$ te të dhënat tona?
    \item Pse gabimi standard i totalit nuk është $\sqrt{\sum_i\mathrm{se}_i^2}$?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) \texttt{C[cbind(1:n, n:1)]}; (2) të gjitha $F_{i6}=1$ për shkak të kolonës 7 me zero;
  (3) vitet ndajnë të njëjtët $\hat f_k$: gabimet e vlerësimit janë të korreluara.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 3}
  \begin{itemize}
    \item Format i gjatë $\to$ matricë: \texttt{C[cbind(i, j)] <- x}; diagonalja: \texttt{C[cbind(1:n, n:1)]}.
    \item $\hat f_j$ me \texttt{sapply()} ose \texttt{colSums()} me maskë.
    \item Rezerva chain-ladder \Sexpr{mln(sum(res$reserve))} mln €; e vërteta e pritur \Sexpr{mln(sum(R_true))} mln €.
    \item Mack nga zero = \Rkey{ChainLadder}; se(totali) $=$ \Sexpr{mln(se_total)} mln € me termin e kovariancës.
  \end{itemize}
  \vfill
  \begin{block}{Ora 4}
    Teoria e kredibilitetit: Bühlmann, Bühlmann--Straub, lidhja me Bayes.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 3)}
  \small
  \begin{itemize}
    \item T.~Mack (1993), \emph{ASTIN Bulletin} 23(2).
    \item M.~Gesmann et al., vinjeta e paketës \Rkey{ChainLadder}: \texttt{?MackChainLadder}.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015 (kapitulli për rezervat).
    \item README i të dhënave: \texttt{runoff\_triangle\_synthetic.csv} (sintetike).
  \end{itemize}
\end{frame}
