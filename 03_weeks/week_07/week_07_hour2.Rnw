% ------------------------------------------------------------
\subsection{Sigurimi rritës}
% ------------------------------------------------------------

\begin{frame}{Përkufizimi}
  \begin{Definicion}
    \termi{Sigurimi rritës i përjetshëm}{increasing whole life insurance} $(IA)_x$: nëse $(x)$ vdes në vitin $k+1$, paguhen $k+1$ lekë në fund të vitit.
  \end{Definicion}
  \pause
  \[
    (IA)_x=\sum_{k\ge0}(k+1)\,v^{k+1}\,{}_{k|}q_x,
    \qquad {}_{k|}q_x=\frac{d_{x+k}}{l_x}.
  \]
  \pause
  \small $K$ = numri i viteve të plota që jeton $(x)$; pagesa është $(K+1)\,v^{K+1}$.
\end{frame}

\begin{frame}{Me komutime: hapi 1}
  Shumëzojmë numëruesin dhe emëruesin me $v^x$:
  \begin{align*}
    (IA)_x &= \sum_{k\ge0}(k+1)\,\frac{v^{x+k+1}d_{x+k}}{v^xl_x} \\
    \onslide<2->{&= \frac{1}{D_x}\sum_{k\ge0}(k+1)\,C_{x+k}} \\
    \onslide<3->{&= \frac{C_x+2C_{x+1}+3C_{x+2}+\dots}{D_x}.}
  \end{align*}
\end{frame}

\begin{frame}{Me komutime: hapi 2, ``shkallët''}
  Rendisim termat në rreshta:
  \[
    \begin{array}{rcccccl}
      M_x     &=& C_x &+& C_{x+1} &+& C_{x+2}+\dots \\
      M_{x+1} &=&     & & C_{x+1} &+& C_{x+2}+\dots \\
      M_{x+2} &=&     & &         & & C_{x+2}+\dots \\
      \vdots  & &     & &         & &
    \end{array}
  \]
  \pause
  \begin{itemize}
    \item Shuma e kolonës së $C_{x+k}$: $k+1$ herë.
    \item Pra $\sum_k(k+1)C_{x+k}=M_x+M_{x+1}+\dots=R_x$.
  \end{itemize}
  \pause
  \begin{center}\fbox{$(IA)_x=R_x/D_x$}\end{center}
\end{frame}

\begin{frame}{Interpretimi: shtresat}
  \centering
  \begin{tikzpicture}[x=0.9cm,y=0.45cm]
    \draw[->] (0,0) -- (7.4,0) node[right,font=\small]{viti};
    \draw[->] (0,0) -- (0,5) node[above,font=\small]{shuma};
    \fill[uptblue!75] (0,0) rectangle (7,1); \node[white,font=\scriptsize] at (3.5,0.5) {$A_x$};
    \fill[uptblue!55] (1,1) rectangle (7,2); \node[white,font=\scriptsize] at (4,1.5) {${}_{1|}A_x$};
    \fill[uptblue!35] (2,2) rectangle (7,3); \node[font=\scriptsize] at (4.5,2.5) {${}_{2|}A_x$};
    \fill[uptblue!20] (3,3) rectangle (7,4); \node[font=\scriptsize] at (5,3.5) {${}_{3|}A_x$};
    \node[font=\scriptsize,below] at (0.5,0) {1}; \node[font=\scriptsize,below] at (1.5,0) {2};
    \node[font=\scriptsize,below] at (2.5,0) {3}; \node[font=\scriptsize,below] at (3.5,0) {4};
  \end{tikzpicture}\par
  \pause
  \small Sigurimi rritës = shumë sigurimesh konstante të shtyra: $(IA)_x=\sum_{j\ge0}{}_{j|}A_x=\sum_{j\ge0}M_{x+j}/D_x$.
\end{frame}

\begin{frame}{Me afat: $(IA)^1_{x:\overline n|}$}
  Shuma $k+1$ vetëm për $k=0,\dots,n-1$:
  \begin{align*}
    (IA)^1_{x:\overline n|} &= \frac1{D_x}\sum_{k=0}^{n-1}(k+1)\,C_{x+k} \\
    \onslide<2->{&= \frac1{D_x}\Big[\underbrace{\textstyle\sum_{k\ge0}(k+1)C_{x+k}}_{R_x}-\underbrace{\textstyle\sum_{k\ge n}(k+1)C_{x+k}}_{?}\Big].}
  \end{align*}
  \onslide<3->{
  Për $k\ge n$: \; $(k+1)=(k-n+1)+n$, pra
  \[
    \sum_{k\ge n}(k+1)C_{x+k}=R_{x+n}+n\,M_{x+n}.
  \]}
\end{frame}

\begin{frame}{Formula}
  \begin{Teoreme}
    \[
      (IA)^1_{x:\overline n|}=\frac{R_x-R_{x+n}-n\,M_{x+n}}{D_x}.
    \]
  \end{Teoreme}
  \pause
  \begin{itemize}
    \item $R_x-R_{x+n}$: shtresat që \textbf{fillojnë} para moshës $x+n$.
    \item $-n\,M_{x+n}$: këto $n$ shtresa duhet të \textbf{ndalen} në $x+n$, jo të vazhdojnë përgjithmonë.
  \end{itemize}
\end{frame}

\begin{frame}[label=w7gab2]{Gjej gabimin}
  Një student shkruan për tabelën e vogël ($n=3$):
  \[
    (IA)^1_{100:\overline3|}=\frac{R_{100}-R_{103}}{D_{100}}=\frac{1772.554-82.270}{1000}=1.690284.
  \]
  \begin{enumerate}
    \item Vlera e saktë është $1.443474$ (Ora 1). Ku është gabimi?
    \item Çfarë kontrate çmon në fakt formula e tij?
  \end{enumerate}
  \vfill\shkoTe{w7zgjGab2}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Sigurimi zbritës}
% ------------------------------------------------------------

\begin{frame}{Përkufizimi}
  \begin{Definicion}
    \termi{Sigurimi zbritës me afat}{decreasing term insurance} $(DA)^1_{x:\overline n|}$: nëse $(x)$ vdes në vitin $k+1\le n$, paguhen $n-k$ lekë.
  \end{Definicion}
  \pause
  \[
    (DA)^1_{x:\overline n|}=\sum_{k=0}^{n-1}(n-k)\,v^{k+1}\,{}_{k|}q_x=\frac1{D_x}\sum_{k=0}^{n-1}(n-k)\,C_{x+k}.
  \]
  \pause
  \small Shumat: $n,\,n-1,\,\dots,\,1$. Pas vitit $n$: asgjë.
\end{frame}

\begin{frame}{Shtresat e sigurimit zbritës}
  \centering
  \begin{tikzpicture}[x=0.9cm,y=0.45cm]
    \draw[->] (0,0) -- (5.4,0) node[right,font=\small]{viti};
    \draw[->] (0,0) -- (0,5) node[above,font=\small]{shuma};
    \fill[accent!85] (0,0) rectangle (4,1); \node[white,font=\scriptsize] at (2,0.5) {$A^1_{x:\overline4|}$};
    \fill[accent!65] (0,1) rectangle (3,2); \node[white,font=\scriptsize] at (1.5,1.5) {$A^1_{x:\overline3|}$};
    \fill[accent!45] (0,2) rectangle (2,3); \node[font=\scriptsize] at (1,2.5) {$A^1_{x:\overline2|}$};
    \fill[accent!25] (0,3) rectangle (1,4); \node[font=\scriptsize] at (0.5,3.5) {$A^1_{x:\overline1|}$};
    \node[font=\scriptsize,below] at (0.5,0) {1}; \node[font=\scriptsize,below] at (1.5,0) {2};
    \node[font=\scriptsize,below] at (2.5,0) {3}; \node[font=\scriptsize,below] at (3.5,0) {4};
  \end{tikzpicture}\par
  \pause
  \small $(DA)^1_{x:\overline n|}=\sum_{j=1}^{n}A^1_{x:\overline j|}$: $n$ sigurime konstante me afate $1,2,\dots,n$.
\end{frame}

\begin{frame}{Formula me komutime}
  \begin{align*}
    (DA)^1_{x:\overline n|} &= \sum_{j=1}^{n}\frac{M_x-M_{x+j}}{D_x} \\
    \onslide<2->{&= \frac{n\,M_x-(M_{x+1}+M_{x+2}+\dots+M_{x+n})}{D_x}} \\
    \onslide<3->{&= \frac{n\,M_x-(R_{x+1}-R_{x+n+1})}{D_x}.}
  \end{align*}
  \onslide<4->{
  \begin{Teoreme}
    $(DA)^1_{x:\overline n|}=\dfrac{n\,M_x-R_{x+1}+R_{x+n+1}}{D_x}$.
  \end{Teoreme}}
\end{frame}

\begin{frame}{Identiteti kryesor}
  \begin{Teoreme}
    $(IA)^1_{x:\overline n|}+(DA)^1_{x:\overline n|}=(n+1)\,A^1_{x:\overline n|}$.
  \end{Teoreme}
  \pause
  \begin{itemize}
    \item Prova: në vitin $k+1$, shumat janë $(k+1)+(n-k)=n+1$, e njëjta për çdo $k$.
    \pause
    \item Pasoja praktike: mjafton të llogaritet njëri; tjetri del nga identiteti.
    \pause
    \item Kontroll i shpejtë i çdo kodi (Ora 3).
  \end{itemize}
\end{frame}

\begin{frame}[label=w7mc2]{Zgjedhje e shumëfishtë}
  Cila formulë jep $(DA)^1_{x:\overline2|}$ (shumat 2, 1)?
  \begin{enumerate}[A)]
    \item $(2M_x-M_{x+1})/D_x$
    \item $(2M_x-M_{x+1}-M_{x+2})/D_x$
    \item $(R_x-R_{x+2})/D_x$
    \item $(2M_x-R_{x+1})/D_x$
  \end{enumerate}
  \vfill\shkoTe{w7zgjMC2}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Shembull pa ndihmën e PC}
% ------------------------------------------------------------

\begin{frame}{Tabela e vogël, $n=2$}
  Nga Ora 1: $M_{100..102}=908.099,\,527.147,\,255.038$; \; $R_{100..103}=1772.554,\,864.455,\,337.308,\,82.270$.
  \pause
  \begin{align*}
    A^1_{100:\overline2|} &= (908.099-255.038)/1000=0.653061 \\
    \onslide<3->{(IA)^1_{100:\overline2|} &= (1772.554-337.308-2\cdot255.038)/1000=0.925170} \\
    \onslide<4->{(DA)^1_{100:\overline2|} &= (2\cdot908.099-864.455+82.270)/1000=1.034013}
  \end{align*}
  \onslide<5->{\small Kontroll: $0.925170+1.034013=1.959183=3\cdot0.653061$. \textcolor{okgreen}{$\checkmark$}}
\end{frame}

\begin{frame}{Kontroll me shumat direkte}
  ${}_{k|}q_{100}\,v^{k+1}$: \; $k=0$: $0.380952$; \; $k=1$: $0.272109$.
  \begin{itemize}
    \item<2-> $(IA)^1$: $1(0.380952)+2(0.272109)=0.925170$. \textcolor{okgreen}{$\checkmark$}
    \item<3-> $(DA)^1$: $2(0.380952)+1(0.272109)=1.034013$. \textcolor{okgreen}{$\checkmark$}
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}Në provim: llogarit me komutime, kontrollo me shumën direkte ose me identitetin.\end{Keshille}}
\end{frame}

\begin{frame}[label=w7ush2]{Radha jote!}
  \begin{Ushtrim}[(6 minuta, pa ndihmën e PC)]
    Për 100-vjeçarin, me $n=4$ (deri në fund të tabelës):
    \begin{enumerate}
      \item Llogarit $(DA)^1_{100:\overline4|}$ me komutime ($R_{105}=0$).
      \item Llogarit $(IA)^1_{100:\overline4|}$. Pse është e barabartë me $(IA)_{100}$?
      \item Kontrollo identitetin me $A_{100}=0.908099$.
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w7zgjUsh2}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Primat}
% ------------------------------------------------------------

\begin{frame}{Prima neto vjetore}
  \begin{itemize}
    \item<1-> Parimi i ekuivalencës: vlera e primave = vlera e përfitimeve.
    \item<2-> Prima konstante për $n$ vjet, në fillim të vitit:
      \[ P\,\ddot a_{x:\overline n|}=(DA)^1_{x:\overline n|}\quad\Rightarrow\quad P=\frac{(DA)^1_{x:\overline n|}}{\ddot a_{x:\overline n|}}. \]
    \item<3-> Shembull: $\ddot a_{100:\overline2|}=(1929.921-358.493)/1000=1.571428$; \;
      $P=1.034013/1.571428=0.658008$.
  \end{itemize}
\end{frame}

\begin{frame}{Kujdes: prima konstante për sigurim zbritës}
  \begin{itemize}
    \item<1-> Me $n=3$: $P=(DA)^1_{100:\overline3|}/\ddot a_{100:\overline3|}=1.859842/1.843537=1.008844$.
    \item<2-> Në vitin e fundit, kompania merr $P=1.008844$ për një rrezik që vlen vetëm $v\,q_{102}=0.634921$.
    \item<3-> Kontrata ``i detyrohet'' klientit: rezerva del \textbf{negative}.
  \end{itemize}
  \onslide<4->{
  \begin{Gabim}Për sigurimet zbritëse, primat zakonisht paguhen për një periudhë \textbf{më të shkurtër} se afati. Përndryshe klienti ka arsye ta ndërpresë kontratën në fund. (Ora 4: rezervat.)\end{Gabim}}
\end{frame}

\begin{frame}[label=w7ush2b]{Radha jote! Kthimi i primave}
  \begin{Ushtrim}[(5 minuta)]
    Kontratë me afat 2 vjet për 100-vjeçarin: në vdekje paguhet 1 lek \textbf{plus} primat e paguara deri atëherë (pa interes).
    Prima $P$ paguhet në fillim të çdo viti.
    \begin{enumerate}
      \item Shkruaj ekuacionin e ekuivalencës me $A^1$, $(IA)^1$ dhe $\ddot a$.
      \item Gjej $P$. Pse del $P>1$?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w7zgjUsh2b}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Indeksimi gjeometrik \Zgj}
% ------------------------------------------------------------

\begin{frame}{Shuma rritet me $j$ në vit \Zgj}
  Shuma në vitin $k+1$: $(1+j)^k$ (p.sh.\ indeksim me inflacionin).
  \begin{align*}
    A^{(j)}_x &= \sum_{k\ge0}(1+j)^k\,v^{k+1}\,{}_{k|}q_x \\
    \onslide<2->{&= \frac1{1+j}\sum_{k\ge0}\Big(\frac{1+j}{1+i}\Big)^{k+1}{}_{k|}q_x} \\
    \onslide<3->{&= \frac{1}{1+j}\;A_x\big|_{i^*},\qquad 1+i^*=\frac{1+i}{1+j}.}
  \end{align*}
  \onslide<4->{\small Shembull: $j=i=5\%$ $\Rightarrow$ $i^*=0$, $A_x|_{0}=1$, pra $A^{(j)}_{100}=1/1.05=0.952381$.}
\end{frame}

\begin{frame}[label=w7tps2]{Mendo -- diskuto me shokun -- ndaj \Zgj}
  \begin{Ushtrim}[(4 minuta)]
    \begin{enumerate}
      \item Pse $i^*\approx i-j$ për norma të vogla?
      \item Nëse $j>i$, $i^*<0$. A ka kuptim një ``normë negative''? Çfarë ndodh me $A^{(j)}_x$?
      \item Në R: me cilin argument të \texttt{Axn()} do ta llogarisje $A_x|_{i^*}$?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w7zgjTps2}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse $\sum_k(k+1)C_{x+k}=R_x$?
    \item Çfarë korrigjon termi $-n\,M_{x+n}$ në $(IA)^1_{x:\overline n|}$?
    \item Shkruaj identitetin që lidh $(IA)^1$, $(DA)^1$ dhe $A^1$.
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) çdo $C_{x+k}$ shfaqet në $M_x,\dots,M_{x+k}$: $k+1$ herë;
  (2) ndal shtresat në $x+n$; (3) $(IA)^1+(DA)^1=(n+1)A^1$.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 2}
  \begin{itemize}
    \item $(IA)_x=R_x/D_x$; \; $(IA)^1_{x:\overline n|}=(R_x-R_{x+n}-nM_{x+n})/D_x$.
    \item $(DA)^1_{x:\overline n|}=(nM_x-R_{x+1}+R_{x+n+1})/D_x$.
    \item Shtresat: rritës = shumë sigurimesh të shtyra; zbritës = shumë sigurimesh me afat.
    \item $(IA)^1+(DA)^1=(n+1)A^1$.
    \item Indeksimi gjeometrik: normë e modifikuar $i^*$ \Zgj.
  \end{itemize}
  \vfill
  \begin{block}{Ora 3}
    Laborator R: \texttt{IAxn()}, \texttt{DAxn()}, një funksion për çdo vektor shumash, kredia e Arbenit.
  \end{block}
\end{frame}

