\begin{frame}[fragile,label=w7sU7]{Zgjidhja U7}
<<w7s7-u7>>=
q <- new("actuarialtable", x = 80:84, lx = c(1000, 900, 600, 200, 0), interest = 0.04)
round(c(A1 = Axn(q, 80, 3), IA = IAxn(q, 80, 3), DA = DAxn(q, 80, 3),
        IA_default = IAxn(q, 80), IA_n4 = IAxn(q, 80, 4)), 6)
@
  \small Pa \texttt{n}, \texttt{IAxn()} ndalet pas 3 vitesh: humbet vitin e fundit. Jep gjithmonë \texttt{n}.
  \vfill\kthehu{w7qU7}
\end{frame}

\begin{frame}[fragile,label=w7sU8]{Zgjidhja U8}
<<w7s7-u8>>=
Pe <- AExn(q, 80, 3) / axn(q, 80, 3)
Ve <- reserve(q, 80, b = c(1, 1, 1, 0), c = c(0, 0, 0, 1), prem = c(Pe, Pe, Pe, 0))
Vw <- 1 - sapply(80:83, function(a) axn(q, a)) / axn(q, 80)
round(rbind(endowment = Ve, whole_life = Vw), 6)
@
  \small I përziri paguan me siguri në 83 (vdekje ose maturim): rezerva rritet drejt 1 më shpejt.
  \vfill\kthehu{w7qU8}
\end{frame}

\begin{frame}[label=w7sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{itemize}
    \item (a) gabim: emëruesi duhet \texttt{axn(q, 80)}; si është, jep 0.
    \item (b) gabim: primat paguhen 3 vjet, pra \texttt{axn(q, 80, 3)}.
    \item (c) \textbf{e saktë}: $a_x=\ddot a_x-1$.
  \end{itemize}
  \vfill\kthehu{w7qGab7}
\end{frame}
