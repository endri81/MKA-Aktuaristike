\begin{frame}[label=w7sU2]{Zgjidhja U2}
  \begin{itemize}
    \item $A^1_{80:\overline3|}=(900.080-170.961)/1000=0.729119$.
    \item $(IA)^1_{80:\overline3|}=(2401.527-170.961-3\cdot170.961)/1000=1.717683$.
    \item $(DA)^1_{80:\overline3|}=(3\cdot900.080-1501.446+0)/1000=1.198794$.
    \item $1.717683+1.198794=2.916477\approx4\cdot0.729119=2.916476$ \textcolor{okgreen}{$\checkmark$} (rrumbullakim).
    \item $(IA)_{80}=R_{80}/D_{80}=2.401527$.
  \end{itemize}
  \vfill\kthehu{w7qU2}
\end{frame}

