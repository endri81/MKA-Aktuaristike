\begin{frame}[label=w7sT1]{Zgjidhja T1}
  \textbf{B)} $(R_x-R_{x+n}-n\,M_{x+n})/D_x$.
  \begin{itemize}
    \item A) shtresat nuk ndalen: paguan $\min(K+1,n)$ gjithë jetën.
    \item C) është $(DA)^1_{x:\overline n|}$. \; D) është $A^1_{x:\overline n|}$.
  \end{itemize}
  \vfill\kthehu{w7qT1}
\end{frame}

\begin{frame}[label=w7sT2]{Zgjidhja T2}
  \textbf{B)} Primën origjinale dhe supozimet e vlerësimit.
  \begin{itemize}
    \item A) jep gjithmonë 0. \; C) është ide retrospektive pa koston e vdekjeve.
    \item D) vlen vetëm për sigurimin e përjetshëm me prima gjithë jetën.
  \end{itemize}
  \vfill\kthehu{w7qT2}
\end{frame}

