<<w7h1-setup, include=FALSE>>=
suppressMessages({library(lifecontingencies); library(tvm)})
library(ggplot2)
th  <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0) format(round(x, d), big.mark = " ", nsmall = d)
mt  <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
@

% ------------------------------------------------------------
\subsection{Pyetja e javës}
% ------------------------------------------------------------

\begin{frame}{Arbeni merr një kredi}
  \begin{itemize}
    \item<1-> Arbeni, 40 vjeç, blen një apartament në Tiranë.
    \item<2-> Banka i jep kredi 8\,000\,000 lekë, për 20 vjet, me interes 6\% në vit.
    \item<3-> Kusht: një \textbf{sigurim jete} që, nëse Arbeni vdes, paguan bankës \textbf{mbetjen e kredisë}.
  \end{itemize}
  \onslide<4->{
  \begin{Shembull}[(pyetja e javës)]
    ``Sa kushton ky sigurim? Dhe pse kompania duhet të mbajë një \textbf{rezervë} për të, edhe kur Arbeni është plotësisht mirë?''
  \end{Shembull}}
  \onslide<5->{\small Shembull ilustrues: Arbeni, kredia dhe kompania janë fiktive.}
\end{frame}

\begin{frame}[fragile]{Kësti dhe mbetja e kredisë}
<<w7h1-loan>>=
L0 <- 8e6; r <- 0.06; n <- 20
P  <- pmt(amt = L0, maturity = n, rate = r)      # tvm, Week 2
k  <- 0:(n - 1)                                  # start of loan year k + 1
B  <- P * (1 - (1 + r)^-(n - k)) / r             # outstanding balance
c(annual_payment = round(P))
round(B[c(1, 6, 11, 16, 20)])
@
  \small Mbetja në fillim të çdo viti: vlera aktuale e kësteve që kanë mbetur.
\end{frame}

\begin{frame}[fragile]{Mbetja nuk bie në vijë të drejtë}
<<w7h1-plot, echo=FALSE, fig.height=3>>=
db <- data.frame(year = rep(k + 1, 2), amount = c(B, L0 * (n - k) / n) / 1e6,
                 type = rep(c("mbetja reale (6%)", "linear 8M x (20-k)/20"), each = n))
ggplot(db, aes(year, amount, colour = type)) + geom_step(linewidth = 1, direction = "hv") +
  scale_colour_manual(values = c("#E67E22", "#2C5AA0")) +
  labs(x = "viti i kredise", y = "milione leke", colour = NULL) + th + theme(legend.position = "top")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Në fillim, kësti paguan kryesisht \textbf{interes}: mbetja bie ngadalë.
    \item<2-> Në vitin 11, mbetja është ende \Sexpr{fmt(B[11] / 1e6, 2)} milionë, jo 4.
    \item<3-> Shuma e siguruar \textbf{zbret} me kohën: ky është një sigurim \textbf{zbritës}.
  \end{itemize}
  \onslide<4->{\small Në Orën 3: sa gabon përafrimi linear (sigurimi zbritës ``klasik'') për çmimin?}
\end{frame}

