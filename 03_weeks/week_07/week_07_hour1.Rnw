    \fill[uptblue!70] (0.3,0) rectangle (1.3,3); \fill[uptblue!70] (1.6,0) rectangle (2.6,3);
    \fill[uptblue!70] (2.9,0) rectangle (3.9,3); \fill[uptblue!70] (4.2,0) rectangle (5.2,3);
    \fill[okgreen!70] (9.3,0) rectangle (10.3,1); \fill[okgreen!70] (10.6,0) rectangle (11.6,2);
    \fill[okgreen!70] (11.9,0) rectangle (12.9,3); \fill[okgreen!70] (13.2,0) rectangle (14.2,4);
    \fill[accent!80] (18.3,0) rectangle (19.3,4); \fill[accent!80] (19.6,0) rectangle (20.6,3);
    \fill[accent!80] (20.9,0) rectangle (21.9,2); \fill[accent!80] (22.2,0) rectangle (23.2,1);
