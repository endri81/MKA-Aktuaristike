  \vspace{6pt}
  \small Shembull me $n=4$: shumat $3,3,3,3$ \quad $1,2,3,4$ \quad $4,3,2,1$.
\end{frame}

\begin{frame}{Ku përdoren?}
  \begin{itemize}
    \item<1-> \textbf{Zbritëse} (DA): sigurimi i kredisë; mbron familjen dhe bankën.
    \item<2-> \textbf{Rritëse} (IA): shuma e siguruar e indeksuar; kthimi i primave të paguara në rast vdekjeje.
    \item<3-> \textbf{Anuitetet}: pensionet, me pagesa në fillim ($\ddot a$) ose në fund ($a$) të vitit.
    \item<4-> \textbf{Rezervat}: detyrimi i kompanisë sot për pagesat e ardhshme (IFRS 17, Solvency II).
  \end{itemize}
\end{frame}

\begin{frame}{Objektivat e Javës 7}
  \begin{enumerate}
    \item<1-> Të llogarisim $(IA)_x$, $(IA)^1_{x:\overline n|}$, $(DA)^1_{x:\overline n|}$ me komutime dhe në R. \LO{C3}
    \item<2-> Të çmojmë sigurimin e kredisë me mbetjen \textbf{reale}. \LO{S2}
    \item<3-> Të përdorim anuitetet e menjëhershme, me afat dhe të shtyra. \LO{C3}
    \item<4-> Të llogarisim primat neto dhe \textbf{rezervat matematike prospektive}. \LO{C2}
    \item<5-> Të krahasojmë Shqipërinë 2011, tabelën sintetike dhe SOA. \LO{C2}
  \end{enumerate}
\end{frame}

\begin{frame}{Harta e ditës}
  \centering
  \begin{tikzpicture}[>=Stealth,
      b/.style={draw=uptblue,fill=uptlight,rounded corners=3pt,minimum width=2.6cm,
                minimum height=1cm,align=center,font=\footnotesize}]
