\subsection{Java 8}
% ------------------------------------------------------------

\begin{frame}{Java 8: R në ekonomi dhe financë}
  \begin{itemize}
    \item<1-> Kthimet dhe vlerësimi i volatilitetit nga çmimet e aksioneve.
    \item<2-> Të dhënat: \texttt{stock\_prices\_gbm\_synthetic.csv} (GBM, me $\mu$ dhe $\sigma$ të njohura).
    \item<3-> Parimi \textbf{put--call parity}: teoria, arbitrazhi, kontrolli numerik.
    \item<4-> Lidhja me aktuaristikën: opsionet e përfshira në kontratat e jetës (garancitë).
  \end{itemize}
  \onslide<5->{\vfill\LO{S1}\;\LO{K3}}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint i ditës}
  \begin{enumerate}
    \item Pse sigurimi i kredisë me mbetjen reale kushton më shumë se \texttt{DAxn()}?
    \item Pse rezerva e sigurimit me afat bie në zero në fund?
    \item Pse rezerva e pensioneve bie kur tabela e vlerësimit ka vdekshmëri më të lartë?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) mbetja reale është mbi vijën e drejtë; (2) nuk ka më përfitime të ardhshme;
  (3) pensionet paguhen për më pak vite.}
\end{frame}

\begin{frame}{Përmbledhje e Javës 7}
  \begin{itemize}
    \item $(IA)$ dhe $(DA)$: shtresat, komutimet me $R_x$, identiteti $(n+1)A^1$. \LO{C3}
    \item Kredia e Arbenit: mbetja reale, \texttt{varA()}, ndjeshmëria ndaj interesit. \LO{S2}
    \item Anuitetet: $\ddot a$, $a$, me afat, të shtyra, mujore. \LO{C3}
    \item Primat neto dhe rezervat prospektive; \texttt{reserve()} me rekursion. \LO{C2}
    \item Portofoli: 800 kontrata, tri tabela, rezervat negative. \LO{C2}
  \end{itemize}
\end{frame}

