\subsection{Detyrë shtëpie}
% ------------------------------------------------------------

\begin{frame}{Detyrë shtëpie (para Javës 8)}
  \begin{enumerate}
    \item Përsërit rastin e Orës 6 me \textbf{gratë} (tabela sintetike F dhe Shqipëria 2011 F). Si ndryshojnë rezervat?
    \item Ndrysho primat e kredive në \textbf{primë të vetme}. A zhduken rezervat negative?
    \item Shto pagesat mujore ($k=12$) te pensionet dhe krahaso rezervën totale.
  \end{enumerate}
  \small Dorëzim: një skript R i riprodhueshëm (\texttt{set.seed}) dhe një faqe me interpretim.
\end{frame}

