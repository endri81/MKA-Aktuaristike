% ============================================================
%  Java 3 · Ora 4 — Zgjidhjet (shtojca)
% ============================================================

<<w3s4-setup, include=FALSE>>=
suppressMessages(library(actuar))
approx_var <- function(lambda, shape = 2, scale = 450, p = 0.995) {
  m <- sapply(1:3, function(k) mgamma(k, shape, scale = scale))
  ES <- lambda * m[1]; sdS <- sqrt(lambda * m[2])
  gam <- lambda * m[3] / (lambda * m[2])^1.5; z <- qnorm(p)
  c(skew = gam, normal = ES + z * sdS, NP2 = ES + sdS * (z + gam / 6 * (z^2 - 1)))
}
@

\begin{frame}[label=w3zgjMC5]{Zgjidhja: zgjedhja e shumëfishtë (a, b)}
  \textbf{C)} $a>0$ ndodh vetëm te binomialja negative.
  \begin{itemize}
    \item $a=1-\pi=0.15\Rightarrow\pi=0.85$.
    \item $b=(r-1)(1-\pi)=0.05\Rightarrow r-1=1/3$, \; $r\approx1.33$.
    \item A) Poisson kërkon $a=0$. \; B) Binomialja kërkon $a<0$. \; D) Nuk ka kusht të tillë.
  \end{itemize}
  \vfill\kthehu{w3mc5}
\end{frame}

\begin{frame}[fragile,label=w3zgjUsh4a]{Zgjidhja: Radha jote! (NB)}
  \begin{enumerate}
    \item $a=0.6$, \; $b=2\times0.6=1.2$, \; $p_0=0.4^3=0.064$.
    \item $p_1=(0.6+1.2)\times0.064=0.1152$; \; $p_2=(0.6+0.6)\times0.1152=0.13824$.
    \item $p_2=\binom{4}{2}0.4^3\,0.6^2=6\times0.064\times0.36=0.13824$. \textcolor{okgreen}{$\checkmark$}
  \end{enumerate}
<<w3s4-nb>>=
dnbinom(0:2, size = 3, prob = 0.4)
@
  \vfill\kthehu{w3ush4a}
\end{frame}

\begin{frame}[fragile,label=w3zgjPar4]{Zgjidhja: Parashiko (Kukësi)}
  \begin{enumerate}
    \item $\gamma_S\propto1/\sqrt\lambda$: \; $\sqrt{60/20}=\sqrt3\approx1.73$ herë më e madhe.
    \item Gabimi relativ i normales \textbf{rritet}: më pak dëme, më shumë anësi.
  \end{enumerate}
<<w3s4-par>>=
set.seed(3)
S_k <- vapply(1:50000, function(b)
  sum(rgamma(rpois(1, 20), 2, scale = 450)), numeric(1))
c(approx_var(20), simulation = quantile(S_k, 0.995, type = 1, names = FALSE))
@
  \vfill\kthehu{w3par4}
\end{frame}

\begin{frame}[label=w3zgjUsh4b]{Zgjidhja: Radha jote! (stop-loss)}
  \begin{enumerate}
    \item $\pi(300)=\pi(200)-100\,(1-F_S(200))=16-100\times(1-0.872)=16-12.8=3.2$.
    \item Direkt: vetëm $S=400$ e kalon 300: \; $100\times0.032=3.2$. \textcolor{okgreen}{$\checkmark$}
    \item $\pi(400)=3.2-100\times(1-0.968)=0$: $S$ nuk e kalon kurrë 400, ndaj risiguruesi nuk paguan asgjë.
  \end{enumerate}
  \vfill\kthehu{w3ush4b}
\end{frame}

\begin{frame}[label=w3zgjMC6]{Zgjidhja: zgjedhja e shumëfishtë (GLM)}
  \textbf{B)} $e^{0.10}=1.105$: frekuenca (dëme për police-vit) shumëzohet me 1.105.
  \begin{itemize}
    \item A) $e^\beta$ është raport mesataresh, jo probabilitetesh.
    \item C) Ky është GLM i frekuencës, jo i ashpërsisë.
    \item D) Efekti është shumëzues (log link), jo shtues.
  \end{itemize}
  \vfill\kthehu{w3mc6}
\end{frame}
