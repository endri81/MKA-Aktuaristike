<<w3h6-setup, include=FALSE>>=
suppressMessages(library(actuar))
library(ggplot2)
th <- theme_minimal(base_size = 13)
fmt <- function(x, d = 0) format(round(x, d), big.mark = " ", nsmall = d)
mln <- function(x, d = 2) fmt(x / 1e6, d)
@

% ------------------------------------------------------------
\subsection{Detyra}
% ------------------------------------------------------------

\begin{frame}{Detyra e rastit}
  Kompania fiktive \textbf{``AutoSig sh.a.''} ka dy linja auto me të njëjtat 10\,000 police:
  \begin{itemize}
    \item<2-> \textbf{Kasko} (dëme materiale): ashpërsi Gamma, mesatare 900 €.
    \item<3-> \textbf{TPL} (përgjegjësia ndaj palëve të treta): dëme trupore me bisht të rëndë.
  \end{itemize}
  \onslide<4->{
  \begin{block}{Pyetjet e bordit}
    \begin{enumerate}
      \item Sa kapital duhet për secilën linjë (VaR 99.5\%)?
      \item Sa e ul kapitalin një risigurim excess-of-loss (XL) për dëm?
      \item A ia vlen të shtohet një stop-loss mbi portofolin?
    \end{enumerate}
  \end{block}}
\end{frame}

\begin{frame}{Harta e rastit}
  \centering
  \begin{tikzpicture}[>=Stealth,
      b/.style={draw=uptblue,fill=uptlight,rounded corners=3pt,minimum width=2.3cm,
                minimum height=0.95cm,align=center,font=\footnotesize}]
    \node[b] (a) at (0,0) {\textbf{1.} Frekuenca\\GLM};
    \node[b] (b) at (3,0) {\textbf{2.} Ashpërsia\\Gamma / Pareto};
    \node[b] (c) at (6,0) {\textbf{3.} $S$ bruto\\VaR, TVaR};
    \node[b] (d) at (9,0) {\textbf{4.} XL për dëm\\$S$ neto};
    \node[b] (e) at (9,-2) {\textbf{5.} Stop-loss\\mbi $S$ neto};
    \node[b,fill=accent!15,draw=accent] (f) at (4.5,-2) {\textbf{6.} Krahasimi i kostos\\dhe rekomandimi};
    \draw[->,thick,uptmid] (a) -- (b); \draw[->,thick,uptmid] (b) -- (c);
    \draw[->,thick,uptmid] (c) -- (d); \draw[->,thick,uptmid] (d) -- (e);
    \draw[->,thick,uptmid] (e) -- (f);
  \end{tikzpicture}\par
  \vspace{8pt}
  \small Të dhëna \textbf{sintetike}: \texttt{motor\_portfolio\_synthetic.csv} dhe \texttt{individual\_claims\_synthetic.csv}.
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 1--2: frekuenca dhe ashpërsia}
% ------------------------------------------------------------

\begin{frame}[fragile]{Hapi 1: sa dëme presim vitin e ardhshëm?}
<<w3h6-freq>>=
mp <- read.csv(file.path(DATA, "motor_portfolio_synthetic.csv"))
mp <- transform(mp, young = pmax(30 - driver_age, 0),
                old = pmax(driver_age - 65, 0),
                tirane = as.numeric(region == "Tirane"),
                nafte = as.numeric(fuel == "nafte"))
glm_f <- glm(n_claims ~ young + old + vehicle_age + tirane + nafte +
               offset(log(exposure)), family = poisson, data = mp)
lam <- sum(fitted(glm_f))          # same exposures next year
c(expected_claims = lam, observed = sum(mp$n_claims))
@
  \small Për GLM Poisson me intercept, shuma e vlerave të përshtatura = shuma e vrojtuar.
\end{frame}

\begin{frame}{Pse përdorim GLM këtu?}
  \begin{itemize}
    \item<1-> Për gjithë portofolin, $\lambda$ del i njëjtë si me raportin e thjeshtë.
    \item<2-> GLM ka rëndësi kur \textbf{përbërja} ndryshon: p.sh.\ vitin e ardhshëm 30\% më shumë police në Tiranë.
    \item<3-> Atëherë: \texttt{sum(predict(glm\_f, newdata = portofoli\_i\_ri, type = "response"))}.
  \end{itemize}
  \onslide<4->{\small Për rastin tonë mbajmë të njëjtin portofol: $\lambda=\Sexpr{fmt(lam)}$ dëme në vit për secilën linjë.}
\end{frame}

\begin{frame}[fragile]{Hapi 2: bishti i dëmeve TPL}
<<w3h6-tail>>=
x  <- read.csv(file.path(DATA, "individual_claims_synthetic.csv"))$amount_eur
u0 <- 20000                                  # threshold from Week 2
xt <- x[x > u0]
alpha_hat <- length(xt) / sum(log(xt / u0))  # Pareto MLE
c(n_tail = length(xt), w_hat = mean(x > u0), alpha_hat = alpha_hat,
  se_alpha = alpha_hat / sqrt(length(xt)),
  meanlog = mean(log(x[x <= u0])), sdlog = sd(log(x[x <= u0])))
@
\end{frame}

\begin{frame}{Vlerësimi kundrejt së vërtetës}
  \centering
  \begin{tabular}{lcc}
    \toprule
    Parametri & Vlerësimi & E vërteta \\
    \midrule
    Pesha e bishtit $w$ & \Sexpr{fmt(mean(x > u0), 4)} & 0.05 \\
    Forma Pareto $\alpha$ & \Sexpr{fmt(alpha_hat, 3)} \;(SE \Sexpr{fmt(alpha_hat / sqrt(length(xt)), 3)}) & 1.8 \\
    Trupi: $\mu$, $\sigma$ & \Sexpr{fmt(mean(log(x[x <= u0])), 3)}, \Sexpr{fmt(sd(log(x[x <= u0])), 3)} & 7, 0.9 \\
    \bottomrule
  \end{tabular}\par
  \vspace{10pt}
  \begin{itemize}
    \item<2-> $\hat\alpha$ ndryshon nga e vërteta me $\approx\Sexpr{fmt((alpha_hat - 1.8) / (alpha_hat / sqrt(length(xt))), 1)}$ SE: vetëm \Sexpr{length(xt)} dëme në bisht.
    \item<3-> Për kapitalin përdorim \textbf{të vërtetën} $\alpha=1.8$; ndjeshmërinë ndaj $\alpha$ e shohim në Hapin 5.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Gjeneratori i ashpërsisë TPL}
<<w3h6-rsev>>=
rsev_tpl <- function(n, w = 0.05, alpha = 1.8, mu = 7, sigma = 0.9) {
  big <- rbinom(n, 1, w) == 1               # which claims come from the tail
  out <- rlnorm(n, mu, sigma)
  out[big] <- rpareto1(sum(big), alpha, u0)
  out
}
set.seed(1); xs <- rsev_tpl(1e6)
c(sim_mean = mean(xs), true_mean = 0.95 * exp(7 + 0.9^2 / 2) +
    0.05 * 1.8 * u0 / 0.8)
@
  \small E njëjta përzierje si \texttt{rmixture()} i Orës 2, por me një parametër $\alpha$ që mund ta ndryshojmë.
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 3: shuma bruto}
% ------------------------------------------------------------

\begin{frame}[fragile]{Simulim i vektorizuar i $S$}
<<w3h6-sim>>=
set.seed(2026); B <- 20000
N  <- rpois(B, lam)                          # claims per year
id <- rep(seq_len(B), N)                     # year of each claim
X_tpl <- rsev_tpl(sum(N))
X_kas <- rgamma(sum(N), shape = 2, scale = 450)
S_tpl <- as.vector(rowsum(X_tpl, id))
S_kas <- as.vector(rowsum(X_kas, id))
c(years = length(S_tpl), claims = sum(N))
@
  \small Një thirrje e vetme \texttt{rsev\_tpl()} për të gjithë $\approx15$ milionë dëmet, pastaj \texttt{rowsum()} sipas vitit.
\end{frame}

\begin{frame}{Pse vektorizim?}
  \begin{itemize}
    \item<1-> \texttt{vapply()} i Orës 3: 20\,000 thirrje të \texttt{rgamma()}, një për çdo vit.
    \item<2-> Këtu: \textbf{një} thirrje për të gjitha dëmet; \texttt{rowsum(X, id)} mbledh sipas grupit.
    \item<3-> Rezultati është i njëjtë në shpërndarje, por shumë më i shpejtë.
  \end{itemize}
  \onslide<4->{
  \begin{Gabim}\texttt{rowsum()} dhe \texttt{tapply()} nuk krijojnë rresht për vitet me $N=0$. Me $\lambda=768$ kjo nuk ndodh kurrë; me $\lambda$ të vogël po (shih ushtrimin).\end{Gabim}}
\end{frame}

\begin{frame}[fragile]{Kasko kundrejt TPL: kapitali bruto}
<<w3h6-risk>>=
risk <- function(S, p = 0.995) {
  v <- quantile(S, p, type = 1, names = FALSE)
  c(mean = mean(S), sd = sd(S), VaR = v, TVaR = mean(S[S > v]),
    capital = v - mean(S), cap_ratio = (v - mean(S)) / mean(S))
}
round(rbind(kasko = risk(S_kas), tpl = risk(S_tpl)), 3)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Kasko: kapitali $\approx\Sexpr{fmt(100 * risk(S_kas)[["cap_ratio"]], 0)}\%$ e dëmeve të pritura.
    \item<2-> TPL: kapitali $\approx\Sexpr{fmt(100 * risk(S_tpl)[["cap_ratio"]], 0)}\%$: \textbf{më shumë se vetë dëmet e pritura}!
    \item<3-> I njëjti numër dëmesh; ndryshon vetëm \textbf{bishti} i ashpërsisë.
    \item<4-> TVaR i TPL-së është shumë mbi VaR: vitet e këqija janë \emph{shumë} të këqija.
  \end{itemize}
  \onslide<5->{
  \begin{block}{Pse?}
    Me $\alpha=1.8$, $\mathrm{Var}[X]=\infty$: teorema qendrore limite nuk ``e qetëson'' shumën. Një dëm i vetëm prej disa milionësh vendos vitin.
  \end{block}}
\end{frame}

\begin{frame}[fragile]{Shpërndarjet e $S/E[S]$}
<<w3h6-plot, echo=FALSE, fig.height=3.2>>=
df <- rbind(data.frame(r = S_kas / mean(S_kas), line = "Kasko (Gamma)"),
            data.frame(r = S_tpl / mean(S_tpl), line = "TPL (LN + Pareto)"))
ggplot(df, aes(r, colour = line)) +
  geom_density(linewidth = 1, adjust = 1.5) +
  coord_cartesian(xlim = c(0.5, 3)) +
  labs(x = "S / E[S]", y = "dendesia", colour = NULL) +
  th + theme(legend.position = "top")
@
  \small Kasko: e ngushtë dhe simetrike. TPL: kulm më majtas, bisht i gjatë djathtas.
\end{frame}

\begin{frame}[fragile,label=w3gab6]{Gjej gabimin}
  Një degë e vogël ka $\lambda=2$ dëme në vit:
<<w3h6-bug>>=
set.seed(5); B <- 10
N <- rpois(B, 2); X <- rgamma(sum(N), 2, scale = 450)
S <- as.vector(rowsum(X, rep(seq_len(B), N)))
c(B = B, length_S = length(S), mean_S = mean(S), truth = 2 * 900)
@
  \begin{enumerate}
    \item Pse \texttt{length(S)} nuk është 10?
    \item Pse mesatarja e llogaritur kështu është sistematikisht mbi të vërtetën? Rregulloje.
  \end{enumerate}
  \vfill\shkoTe{w3zgjGab6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 4: XL për dëm}
% ------------------------------------------------------------

\begin{frame}{Excess-of-loss për dëm}
  \begin{Definicion}[(XL me prioritet $M$)]
    Për çdo dëm $X_i$: siguruesi mban $X_i\wedge M$, risiguruesi paguan $(X_i-M)_+$.
    \[
      S^{\text{neto}}=\sum_{i=1}^{N}(X_i\wedge M),\qquad
      S^{\text{risig}}=\sum_{i=1}^{N}(X_i-M)_+.
    \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item E njëjta matematikë si \textbf{limiti} i policës (Ora 2), por nga ana e siguruesit.
    \item Prima neto e XL: $\lambda\,E[(X-M)_+]=\lambda\,(E[X]-E[X\wedge M])$.
    \item<3-> Në TPL shqiptare, dëmet e mëdha trupore janë arsyeja kryesore e XL-së.
  \end{itemize}
\end{frame}

\begin{frame}[label=w3ush6a]{Radha jote!}
  \begin{Ushtrim}[(5 minuta, pa ndihmën e PC)]
    Për Pareto me një parametër $(\alpha,\theta)$ dhe $M>\theta$:
    \[ E[(X-M)_+]=\int_M^\infty\Big(\frac{\theta}{x}\Big)^{\alpha}dx=\frac{\theta^\alpha M^{1-\alpha}}{\alpha-1}. \]
    \begin{enumerate}
      \item Llogarit $E[(X-M)_+]$ për $\alpha=1.8$, $\theta=20\,000$, $M=50\,000$.
      \item Shumëzo me peshën 0.05 (pjesa lognormale mbi 50\,000 € është e papërfillshme).
      \item Sa është prima neto vjetore e XL-së me $\lambda=768$?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w3zgjUsh6a}{Zgjidhja}
\end{frame}

\begin{frame}[fragile]{XL me $M=50\,000$ € në R}
<<w3h6-xl>>=
M <- 50000
S_net   <- as.vector(rowsum(pmin(X_tpl, M), id))      # insurer keeps X ^ M
S_ceded <- S_tpl - S_net                              # reinsurer pays the rest
lev_mix <- function(t) 0.95 * levlnorm(t, 7, 0.9) +
  0.05 * ifelse(t <= u0, t, levpareto1(t, 1.8, u0))
EX <- 0.95 * exp(7 + 0.9^2 / 2) + 0.05 * 1.8 * u0 / 0.8
c(ceded_sim = mean(S_ceded), ceded_formula = lam * (EX - lev_mix(M)))
round(rbind(gross = risk(S_tpl), net_XL = risk(S_net)), 3)
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Risiguruesi merr mesatarisht \Sexpr{mln(mean(S_ceded))} mln € në vit: rreth \Sexpr{fmt(100 * mean(S_ceded) / mean(S_tpl))}\% e dëmeve.
    \item<2-> Kapitali bie nga \Sexpr{mln(risk(S_tpl)[["capital"]])} në \Sexpr{mln(risk(S_net)[["capital"]])} mln €.
    \item<3-> Pas XL-së, $X\wedge M$ ka të gjitha momentet: $S^{\text{neto}}$ është pothuajse normal.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}XL e kthen një linjë me bisht të rëndë në një linjë ``të qetë'': kapitali neto i TPL-së afrohet me atë të Kaskos.\end{Keshille}}
\end{frame}

\begin{frame}[label=w3par6]{Parashiko}
  \begin{Parashiko}
    Bordi propozon të ulet prioriteti në $M=20\,000$ €.
    \begin{enumerate}
      \item Prima e XL-së rritet apo bie? Përafërsisht sa herë?
      \item Kapitali neto rritet apo bie?
      \item Kush fiton nga ky ndryshim: siguruesi, risiguruesi, apo varet nga çmimi?
    \end{enumerate}
  \end{Parashiko}
  \vfill\shkoTe{w3zgjPar6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 5: stop-loss dhe kostoja}
% ------------------------------------------------------------

\begin{frame}[fragile]{Stop-loss mbi portofolin neto}
<<w3h6-sl>>=
d_sl <- 2.9e6                                   # stop-loss priority
S_ret <- pmin(S_net, d_sl)                       # retained after XL + SL
c(P_trigger = mean(S_net > d_sl),
  SL_net_premium = mean(pmax(S_net - d_sl, 0)))
round(rbind(net_XL = risk(S_net), net_XL_SL = risk(S_ret)), 3)
@
  \small Pas stop-loss, humbja e mbajtur nuk e kalon kurrë 2.9 mln €: VaR$_{0.995}=d$.
\end{frame}

\begin{frame}{Krahasimi i kostos: supozimet}
  \begin{itemize}
    \item<1-> Risiguruesi kërkon primë = prima neto $\times$ (1 + ngarkesë).
      \begin{itemize}
        \item XL: ngarkesë 25\% \quad (supozim për rastin)
        \item Stop-loss: ngarkesë 50\% \quad (pagesa të rralla, më të rrezikshme)
      \end{itemize}
    \item<2-> Kostoja e kapitalit: 6\% në vit, si norma \termi{cost of capital}{} e Solvency II.
    \item<3-> Kostoja totale e pritur:
      \[ \underbrace{E[S^{\text{mbajtur}}]}_{\text{dëmet}}+\underbrace{\text{primat e risigurimit}}_{\text{çmimi}}+\underbrace{6\%\times\text{kapitali}}_{\text{kapitali}}. \]
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Tre programe, një tabelë}
<<w3h6-cost>>=
coc <- 0.06
prog <- function(S_kept, premium) {
  r <- risk(S_kept)
  c(E_kept = r[["mean"]], premium = premium, capital = r[["capital"]],
    total = r[["mean"]] + premium + coc * r[["capital"]])
}
p_xl <- 1.25 * mean(S_ceded); p_sl <- 1.50 * mean(pmax(S_net - d_sl, 0))
round(rbind(none  = prog(S_tpl, 0),
            XL    = prog(S_net, p_xl),
            XL_SL = prog(S_ret, p_xl + p_sl)) / 1e6, 3)   # million EUR
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
<<w3h6-costvals, include=FALSE>>=
tab <- rbind(none = prog(S_tpl, 0), XL = prog(S_net, p_xl), XL_SL = prog(S_ret, p_xl + p_sl))
@
  \begin{itemize}
    \item<1-> Pa risigurim: kostoja e kapitalit $\approx\Sexpr{mln(coc * tab["none", "capital"])}$ mln € në vit.
    \item<2-> XL kushton \Sexpr{mln(p_xl - mean(S_ceded))} mln € ngarkesë, por kursen \Sexpr{mln(coc * (tab["none","capital"] - tab["XL","capital"]))} mln € kosto kapitali.
    \item<3-> Programi me kosto totale më të ulët: \textbf{\Sexpr{sub("_", " + ", rownames(tab)[which.min(tab[, "total"])])}}, por diferenca midis tre programeve është vetëm \Sexpr{mln(diff(range(tab[, "total"])))} mln € në vit.
  \end{itemize}
  \onslide<4->{
  \begin{Gabim}Rezultati varet nga ngarkesat dhe nga kostoja e kapitalit, të cilat i \textbf{supozuam}. Në praktikë ato vijnë nga oferta e risiguruesit dhe nga politika e kompanisë.\end{Gabim}}
\end{frame}

\begin{frame}[label=w3tps6]{Mendo -- diskuto me shokun -- ndaj}
  \begin{Ushtrim}[(4 minuta)]
    Je aktuari i AutoSig. Bordi do \textbf{një} fjali për secilën:
    \begin{enumerate}
      \item Pse TPL ka nevojë për XL, kurse Kasko jo?
      \item Pse stop-loss shtohet (ose jo) mbi XL?
      \item Cili supozim i rastit të shqetëson më shumë?
    \end{enumerate}
  \end{Ushtrim}
  \vfill\shkoTe{w3zgjTps6}{Zgjidhja}
\end{frame}

% ------------------------------------------------------------
\subsection{Hapi 6: ndjeshmëria ndaj $\alpha$}
% ------------------------------------------------------------

\begin{frame}[fragile]{Sa varet kapitali nga $\alpha$?}
<<w3h6-sens>>=
sens <- t(sapply(c(1.5, 1.8, 2.0, 2.5, 3.0), function(a) {
  set.seed(11); Ns <- rpois(10000, lam)
  Xs <- rsev_tpl(sum(Ns), alpha = a); ids <- rep(seq_len(10000), Ns)
  g <- risk(as.vector(rowsum(Xs, ids)))
  n <- risk(as.vector(rowsum(pmin(Xs, M), ids)))
  c(alpha = a, gross_capital = g[["capital"]], net_capital = n[["capital"]])
}))
round(cbind(alpha = sens[, 1], sens[, 2:3] / 1e6), 3)   # million EUR
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Kapitali \textbf{bruto} ndryshon shumë me $\alpha$: nga $\alpha=1.5$ te $\alpha=3$ bie disa herë.
    \item<2-> Kapitali \textbf{neto} (pas XL) ndryshon pak: XL e heq pjesën më të pasigurt.
    \item<3-> Vlerësimi ynë $\hat\alpha=\Sexpr{fmt(alpha_hat, 2)}$ (SE \Sexpr{fmt(alpha_hat / sqrt(length(xt)), 2)}): intervali 95\% shkon nga $\approx\Sexpr{fmt(alpha_hat - 1.96 * alpha_hat / sqrt(length(xt)), 2)}$ deri $\approx\Sexpr{fmt(alpha_hat + 1.96 * alpha_hat / sqrt(length(xt)), 2)}$.
  \end{itemize}
  \onslide<4->{
  \begin{block}{Pse?}
    Pasiguria e parametrit $\alpha$ është vetë një rrezik (\emph{parameter risk}). XL e transferon te risiguruesi.
  \end{block}}
\end{frame}

\begin{frame}{Gabim i zakonshëm: Gamma për TPL}
  \begin{Gabim}
    ``Mesatarja dhe varianca e mostrës përputhen me Gamma, ndaj përdorim Gamma.''
  \end{Gabim}
  \pause
  \begin{itemize}
    \item Varianca e mostrës ekziston gjithmonë, edhe kur $\mathrm{Var}[X]=\infty$.
    \item Gamma me të njëjtat dy momente ka bisht eksponencial: kapitali del shumë më i vogël.
    \item<3-> Kontrolli: grafiku i bishtit në shkallë log (Ora 2), \texttt{qqcomp()} (Java 2), vlerësimi i $\alpha$.
  \end{itemize}
\end{frame}

\begin{frame}{Raporti për bordin}
  \begin{block}{Rekomandimi (rast studimi, të dhëna sintetike)}
    \begin{enumerate}
      \item Kasko: kapitali $\approx\Sexpr{fmt(100 * risk(S_kas)[["cap_ratio"]])}\%$ e dëmeve të pritura; risigurimi nuk është prioritet.
      \item TPL: pa risigurim, kapitali kalon vetë dëmet e pritura ($\approx\Sexpr{fmt(100 * risk(S_tpl)[["cap_ratio"]])}\%$).
      \item XL me $M=50\,000$ €: kapitali neto bie në $\approx\Sexpr{mln(risk(S_net)[["capital"]])}$ mln €.
      \item Stop-loss: vendimi varet nga çmimi; me supozimet tona, programi më i lirë është \textbf{\Sexpr{sub("_", " + ", rownames(tab)[which.min(tab[, "total"])])}}.
    \end{enumerate}
  \end{block}
  \pause
  \small Kufizimet: ngarkesat dhe kostoja e kapitalit janë supozime; $\alpha$ ka pasiguri të madhe; inflacioni i dëmeve trupore nuk është përfshirë.
\end{frame}

\begin{frame}{Lidhja me praktikën}
  \begin{itemize}
    \item<1-> \textbf{Solvency II:} risigurimi ul kapitalin e kërkuar (SCR) për rrezikun e primës dhe të katastrofës.
    \item<2-> \textbf{IFRS 17:} kontratat e risigurimit të mbajtura maten veçmas; edhe ato kanë \emph{risk adjustment}.
    \item<3-> \textbf{AMF:} kompanitë raportojnë programin e risigurimit dhe vlerësimin e rrezikut.
    \item<4-> \textbf{Detyra e kursit} (Javët 10--12): një rast si ky, me të dhënat e tua.
  \end{itemize}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse \texttt{rowsum(X, id)} mund të japë më pak vite se $B$?
    \item Me XL për dëm, cila pjesë e $X_i$ mbetet te siguruesi?
    \item Pse kapitali neto pas XL është më pak i ndjeshëm ndaj $\alpha$?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) vitet me $N=0$ nuk kanë asnjë dëm, ndaj nuk kanë rresht;
  (2) $X_i\wedge M$; (3) $\alpha$ ndikon vetëm dëmet e mëdha, dhe pjesa e tyre mbi $M$ shkon te risiguruesi.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 6}
  \begin{itemize}
    \item Simulim i vektorizuar: \texttt{rpois()} $\to$ \texttt{rep(1:B, N)} $\to$ \texttt{rowsum()}.
    \item Bishti i ashpërsisë vendos kapitalin: Kasko $\approx\Sexpr{fmt(100 * risk(S_kas)[["cap_ratio"]])}\%$, TPL $\approx\Sexpr{fmt(100 * risk(S_tpl)[["cap_ratio"]])}\%$ e $E[S]$.
    \item XL: $S^{\text{neto}}=\sum(X_i\wedge M)$; stop-loss: $S\wedge d$.
    \item Krahasimi i programeve: dëmet + primat + kostoja e kapitalit.
    \item Ndjeshmëria ndaj $\alpha$ është e madhe bruto, e vogël neto.
  \end{itemize}
  \vfill
  \begin{block}{Ora 7}
    Konsolidim: kuiz në stilin e provimit, klinika e gabimeve, fletë-kujtesa, paraqitja e Javës 4.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 6)}
  \small
  \begin{itemize}
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015 (kapitujt për modelet agregate dhe risigurimin).
    \item V.~Goulet et al., vinjetat e paketës \Rkey{actuar}.
    \item EIOPA, \emph{Solvency II}: metoda e kostos së kapitalit (norma 6\%) për marzhin e rrezikut.
    \item README i të dhënave: \texttt{motor\_portfolio\_synthetic.csv}, \texttt{individual\_claims\_synthetic.csv} (sintetike).
  \end{itemize}
\end{frame}
