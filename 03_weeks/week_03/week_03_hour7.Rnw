\subsection{Detyrë shtëpie}
% ------------------------------------------------------------

\begin{frame}{Detyrë shtëpie (para Javës 4)}
  \begin{Ushtrim}[(skript i vetëm, i riprodhueshëm)]
    \begin{enumerate}
      \item Për degën e Durrësit (\texttt{motor\_portfolio\_synthetic.csv}): $\lambda$ nga GLM, ashpërsia Gamma(2, 450).
            Llogarit VaR$_{0.995}$ me Panjer, NP2 dhe simulim.
      \item Për TPL (Ora 6): përsërit tabelën e kostos me $M=100\,000$ €. A ndryshon rekomandimi?
      \item Me \texttt{coverage()}: dendësia e pagesës për Lomax$(3, 2\,000)$, $d=500$, $u=10\,000$.
            Kontrollo që integrali + masa pikësore $=1$.
    \end{enumerate}
  \end{Ushtrim}
  \small Kriteri: skripti ekzekutohet pa gabim pas \emph{Session $\rightarrow$ Restart R}.
\end{frame}

% ------------------------------------------------------------
\subsection{Java 4}
% ------------------------------------------------------------

\begin{frame}{Java 4: rezervat dhe kredibiliteti}
  \begin{itemize}
    \item<1-> Dëmet nuk paguhen menjëherë: trekëndëshi i zhvillimit (\emph{run-off triangle}). \LO{C2}
    \item<2-> Chain-ladder, Mack dhe bootstrap me \Rkey{ChainLadder}: rezerva IBNR.
    \item<3-> Kredibiliteti Bühlmann dhe Bühlmann--Straub me \texttt{actuar::cm()}. \LO{C3}
    \item<4-> Lidhja me sot: Poisson--Gamma (Ora 2) është baza e kredibilitetit.
  \end{itemize}
  \onslide<5->{
  \begin{Shembull}[(pyetja e Javës 4)]
    Dëmet e ndodhura deri më 31 dhjetor, por të paraportuara: sa rezervë duhet të mbajë kompania?
  \end{Shembull}}
\end{frame}

\begin{frame}[fragile]{Përgatitja për Javën 4}
<<w3h7-prep, eval=FALSE>>=
install.packages("ChainLadder")   # once, before next week
library(ChainLadder)
@
  \pause
  \begin{Keshille}Të dhënat e Javës 4: \texttt{runoff\_triangle\_synthetic.csv} dhe \texttt{credibility\_portfolio\_synthetic.csv} (sintetike, me parametra të njohur).\end{Keshille}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint i ditës}
  \begin{enumerate}
    \item Pse kapitali i TPL-së është shumë më i madh se i Kaskos me të njëjtin numër dëmesh?
    \item Kur përdor \texttt{convolve} në \texttt{aggregateDist()}?
    \item Çfarë do të thotë ``vlerësimi brenda 2 SE nga e vërteta''?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) bishti Pareto i ashpërsisë; (2) kur $e^{-\lambda(1-f_0)}$ bën \emph{underflow};
  (3) diferenca shpjegohet me rastësinë e mostrës, pa treguar gabim të modelit.}
\end{frame}

\begin{frame}{Përmbledhje e Javës 3}
  \begin{itemize}
    \item Modeli kolektiv $S=X_1+\dots+X_N$; momentet; konvolucioni. \LO{K3}
    \item Shpërndarjet e humbjeve në \Rkey{actuar}; franshiza, limiti, $E[X\wedge u]$. \LO{S2}
    \item Funksionet e përziera: përzierjet dhe shpërndarjet e përbëra. \LO{K2}
    \item Panjer, diskretizimi, simulimi, përafrimet; VaR dhe TVaR.
    \item GLM për frekuencën dhe ashpërsinë; prima e pastër; risigurimi XL dhe stop-loss.
  \end{itemize}
\end{frame}

