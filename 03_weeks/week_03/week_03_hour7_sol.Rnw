% ============================================================
%  Java 3 · Ora 7 — Zgjidhjet e kuizit (shtojca)
% ============================================================

<<w3s7-setup, include=FALSE>>=
suppressMessages(library(actuar))
@

\begin{frame}[label=w3sT1]{Zgjidhja T1}
  \textbf{B)} $\mathrm{Var}[S]=E[N]\mathrm{Var}[X]+\mathrm{Var}[N]E[X]^2=\lambda(\mathrm{Var}[X]+E[X]^2)=\lambda E[X^2]$.
  \begin{itemize}
    \item A) Harron termin e numrit $\mathrm{Var}[N]E[X]^2$.
    \item C) $\lambda^2$ do të ishte rasti i gabuar $S=N\cdot X$ (pjesërisht).
    \item D) Harron termin e ashpërsisë.
  \end{itemize}
  \vfill\kthehu{w3qT1}
\end{frame}

\begin{frame}[label=w3sT2]{Zgjidhja T2}
  \textbf{C)} Klasa (a, b, 0) përmban vetëm Poisson-in ($a=0$), binomialen ($a<0$) dhe binomialen negative ($a>0$), si dhe rastin e degjeneruar.
  \begin{itemize}
    \item A) Teorema Sundt--Jewell: nuk ka të tjera.
    \item B), D) Janë raste të veçanta, jo e gjithë klasa.
  \end{itemize}
  \vfill\kthehu{w3qT2}
\end{frame}

\begin{frame}[fragile,label=w3sU1]{Zgjidhja U1}
  \begin{itemize}
    \item $\Pr(S=0)=0.6$; \; $\Pr(S=1\,000)=0.3\times0.5=0.15$;
    \item $\Pr(S=2\,000)=0.3\times0.5+0.1\times0.25=0.175$; \; $\Pr(S=3\,000)=0.1\times2\times0.25=0.05$; \; $\Pr(S=4\,000)=0.025$.
    \item $E[S]=0.5\times1\,500=750$ €; \; $\mathrm{Var}[S]=0.5\times250\,000+0.45\times1\,500^2=1\,137\,500$.
  \end{itemize}
<<w3s7-u1>>=
s <- c(0, 1000, 2000, 3000, 4000); p <- c(0.6, 0.15, 0.175, 0.05, 0.025)
c(sum = sum(p), mean = sum(s * p), var = sum(s^2 * p) - sum(s * p)^2)
@
  \vfill\kthehu{w3qU1}
\end{frame}

\begin{frame}[fragile,label=w3sU2]{Zgjidhja U2}
  \begin{enumerate}
    \item $E[S]=50\times600=30\,000$ €; \; $E[X^2]=3\times4\times200^2=480\,000$; \; $\mathrm{sd}[S]=\sqrt{24\times10^6}\approx4\,899$ €.
    \item VaR$_{0.995}\approx30\,000+2.5758\times4\,899\approx42\,619$ €.
    \item E nënvlerëson: $S$ është i anuar djathtas ($\gamma_S>0$).
  \end{enumerate}
<<w3s7-u2>>=
set.seed(1)
S <- vapply(1:50000, function(b) sum(rgamma(rpois(1, 50), 3, scale = 200)), 1)
c(normal = 30000 + qnorm(0.995) * sqrt(50 * 480000),
  simulation = quantile(S, 0.995, type = 1, names = FALSE))
@
  \vfill\kthehu{w3qU2}
\end{frame}

\begin{frame}[fragile,label=w3sU3]{Zgjidhja U3}
  \begin{enumerate}
    \item $g_0=e^{-2}=0.13534$; \; $g_1=\frac21(1\times0.5\times g_0)=0.13534$;\\
          $g_2=\frac22(1\times0.5\times g_1+2\times0.5\times g_0)=0.06767+0.13534=0.20301$.
    \item $S=1$ vetëm kur $N=1$ dhe $X=1$: $\;2e^{-2}\times0.5=e^{-2}$. \textcolor{okgreen}{$\checkmark$}
  \end{enumerate}
<<w3s7-u3>>=
F <- aggregateDist("recursive", model.freq = "poisson",
                   model.sev = c(0, 0.5, 0.5), lambda = 2, maxit = 50)
round(diff(F)[1:3], 5)
@
  \vfill\kthehu{w3qU3}
\end{frame}

\begin{frame}[fragile,label=w3sU4]{Zgjidhja U4}
  \begin{enumerate}
    \item $E[X\wedge t]=\theta(1-e^{-t/\theta})$, me $\theta=2\,000$.
    \item $E[Y^L]=E[X\wedge5\,000]-E[X\wedge500]=2\,000\,(e^{-0.25}-e^{-2.5})=2\,000\times(0.77880-0.08208)\approx1\,393.4$ €.
    \item $E[Y^P]=1\,393.4/e^{-0.25}\approx1\,789.2$ €.
  \end{enumerate}
<<w3s7-u4>>=
yl <- levexp(5000, 1 / 2000) - levexp(500, 1 / 2000)
c(E_YL = yl, E_YP = yl / pexp(500, 1 / 2000, lower.tail = FALSE))
@
  \vfill\kthehu{w3qU4}
\end{frame}

\begin{frame}[fragile,label=w3sU5]{Zgjidhja U5}
  \begin{enumerate}
    \item $a=1-\pi=0.5$, \; $b=(r-1)(1-\pi)=0.5$, \; $p_0=0.5^2=0.25$.
    \item $p_1=(0.5+0.5)\times0.25=0.25$; \; $p_2=(0.5+0.25)\times0.25=0.1875$.
    \item $E[N]=r(1-\pi)/\pi=2$, \; $\mathrm{Var}[N]=r(1-\pi)/\pi^2=4>2$: mbishpërndarje, portofol heterogjen.
  \end{enumerate}
<<w3s7-u5>>=
dnbinom(0:2, size = 2, prob = 0.5)
@
  \vfill\kthehu{w3qU5}
\end{frame}

\begin{frame}[label=w3sU6]{Zgjidhja U6}
  \begin{enumerate}
    \item $\pi(2\,000)=1\,000\times0.05+2\,000\times0.025=50+50=100$ €.
    \item $\pi(0)=750$; \; $\pi(1\,000)=750-1\,000\times(1-0.6)=350$; \; $\pi(2\,000)=350-1\,000\times(1-0.75)=100$. \textcolor{okgreen}{$\checkmark$}
    \item $F_S$: 0.6, 0.75, 0.925, 0.975, 1. \; Vlera e parë me $F_S\ge0.95$ është 3\,000: VaR$_{0.95}=3\,000$ €.
  \end{enumerate}
  \vfill\kthehu{w3qU6}
\end{frame}

\begin{frame}[fragile,label=w3sU7]{Zgjidhja U7}
  \begin{enumerate}
    \item $e^{-2.5}\approx0.0821$ dëme për police-vit.
    \item $e^{0.18}\approx1.197$: rreth 19.7\% më shumë dëme.
    \item $0.0821\times1.197\times900\approx88.4$ € në vit; për 6 muaj (ekspozim 0.5): $\approx44.2$ €.
  \end{enumerate}
<<w3s7-u7>>=
f <- exp(-2.5 + 0.18)
c(base = exp(-2.5), young = f, pure_year = 900 * f, pure_half = 0.5 * 900 * f)
@
  \vfill\kthehu{w3qU7}
\end{frame}

\begin{frame}[fragile,label=w3sU8]{Zgjidhja U8}
<<w3s7-u8, warning=FALSE>>=
set.seed(2026); B <- 20000; lambda <- 100
N <- rpois(B, lambda); id <- factor(rep(seq_len(B), N), levels = seq_len(B))
S <- tapply(rpareto(sum(N), 3, 2000), id, sum, default = 0)
v <- quantile(S, 0.995, type = 1, names = FALSE)
fx <- discretize(ppareto(x, 3, 2000), from = 0, to = 1e6, step = 100,
                 method = "rounding")
F <- aggregateDist("recursive", model.freq = "poisson", model.sev = fx,
                   lambda = lambda, x.scale = 100, maxit = 10000)
rbind(simulation = c(VaR = v, TVaR = mean(S[S > v])),
      recursive  = c(VaR(F, 0.995), CTE(F, 0.995)))
@
  \small R jep një \emph{warning}: rrjeta ndalet te $10^6$ € me masë të mbetur $\approx10^{-6}$, pa ndikim te VaR$_{0.995}$.
  \vfill\kthehu{w3qU8}
\end{frame}

\begin{frame}[label=w3sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{enumerate}
    \item \texttt{ppareto()} është Lomax. E saktë: \texttt{ppareto1(30000, 1.8, 20000, lower.tail = FALSE)}.
    \item Mungon \texttt{x.scale = 100} (dhe \texttt{maxit} duhet rritur): rrjeta do të ishte në hapa 1 €.
    \item \texttt{limit} është humbja maksimale e mbuluar: për pagesë maksimale 10\,000 € mbi franshizën 1\,000 €,
          duhet \texttt{limit = 11000}.
  \end{enumerate}
  \vfill\kthehu{w3qGab7}
\end{frame}
