% ------------------------------------------------------------
\subsection{Pyetja e bordit}
% ------------------------------------------------------------

\begin{frame}{Një mbledhje bordi në një kompani sigurimesh}
  \begin{itemize}
    \item<1-> Portofoli auto (Kasko): \textbf{10\,000 police}, të shpërndara në 12 qarqe.
    \item<2-> Drejtori financiar pyet:
  \end{itemize}
  \onslide<3->{
  \begin{Shembull}[(pyetja e bordit)]
    ``Sa do të paguajmë \textbf{gjithsej} për dëme vitin e ardhshëm?
    Dhe me çfarë probabiliteti shuma e dëmeve kalon 750\,000 €?''
  \end{Shembull}}
  \begin{itemize}
    \item<4-> Pyetja e parë kërkon një \textbf{mesatare}.
    \item<5-> Pyetja e dytë kërkon \textbf{gjithë shpërndarjen} e shumës totale.
  \end{itemize}
\end{frame}

\begin{frame}{Pse ka rëndësi pyetja e dytë?}
  \begin{itemize}
    \item<1-> Prima mbulon mesataren. Kapitali mbulon \textbf{vitet e këqija}.
    \item<2-> Solvency II: kapitali duhet të mjaftojë në 199 vite nga 200 (VaR 99.5\%).
    \item<3-> Risiguruesi çmon kontratën stop-loss nga \textbf{bishti} i shumës totale.
    \item<4-> AMF (Autoriteti i Mbikëqyrjes Financiare) kërkon rezerva dhe kapital të argumentuara.
  \end{itemize}
  \onslide<5->{
  \begin{Keshille}Mesatarja i përgjigjet ``sa?''. Shpërndarja i përgjigjet ``sa keq mund të shkojë?''.\end{Keshille}}
\end{frame}

\begin{frame}{Çfarë sollëm nga Java 2}
  \centering
  \begin{tabular}{lll}
    \toprule
    Përbërësi & Modeli & Vlerësimi (Java 2) \\
    \midrule
    Frekuenca (\emph{frequency}) & Poisson me ekspozim & $\hat\lambda\approx0.141$ për police-vit \\
    Ashpërsia (\emph{severity}) & Gamma (auto) & mesatare $\approx 870$ € \\
    Dëmet individuale & Lognormale + Pareto & bisht i rëndë mbi 20\,000 € \\
    \bottomrule
  \end{tabular}\par
  \vspace{10pt}
  \begin{itemize}
    \item<2-> I kemi \textbf{veç e veç}: sa dëme ndodhin dhe sa kushton secili.
    \item<3-> Pyetja e sotme: si i \textbf{bashkojmë} në një shumë totale?
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Portofoli auto në R}
<<w3h1-motor>>=
d <- read.csv(file.path(DATA, "motor_portfolio_synthetic.csv"))
c(policies  = nrow(d),
  exposure  = sum(d$exposure),        # policy-years
  claims    = sum(d$n_claims),
  total_eur = sum(d$claim_amount_eur))
table(d$n_claims)                     # claims per policy
@
  \small Të dhëna \textbf{sintetike} (\texttt{motor\_portfolio\_synthetic.csv}), me parametra të njohur.
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> 10\,000 police, por vetëm $\approx$\Sexpr{fmt(sum(d$exposure))} police-vite: shumë police mbulojnë një pjesë të vitit.
    \item<2-> \Sexpr{sum(d$n_claims)} dëme gjithsej, me shumë \Sexpr{fmt(sum(d$claim_amount_eur))} €.
    \item<3-> Shumica dërrmuese e policave (\Sexpr{fmt(100*mean(d$n_claims==0),1)}\%) nuk kanë asnjë dëm.
    \item<4-> Disa police kanë 2 ose 3 dëme: numri i dëmeve është \textbf{i rastit}.
  \end{itemize}
  \onslide<5->{
  \begin{block}{Pyetje}
    Vitin e ardhshëm shuma totale nuk do të jetë saktësisht \Sexpr{fmt(sum(d$claim_amount_eur))} €. Sa mund të lëkundet?
  \end{block}}
\end{frame}

\begin{frame}{Objektivat e Javës 3}
  \begin{enumerate}
    \item<1-> Të ndërtojmë \termi{modelin kolektiv}{collective risk model} $S=X_1+\dots+X_N$. \LO{K3}
    \item<2-> Të përdorim shpërndarjet e humbjeve dhe modifikimet e policës në \Rkey{actuar}. \LO{S2}
    \item<3-> Të kuptojmë \termi{funksionet e përziera}{mixed functions}: përzierjet dhe shpërndarjet e përbëra. \LO{K2}
    \item<4-> Të llogarisim shpërndarjen e $S$: Panjer, simulim, përafrime. \LO{K3}
    \item<5-> Të vlerësojmë VaR, TVaR dhe çmimin stop-loss të risigurimit. \LO{S2}
  \end{enumerate}
\end{frame}

