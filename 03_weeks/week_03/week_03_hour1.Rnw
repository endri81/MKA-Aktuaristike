\subsection{Përgatitja e mjedisit}
% ------------------------------------------------------------

\begin{frame}[fragile]{Paketa \texttt{actuar}}
<<w3h1-actuar-run, include=FALSE>>=
msg <- character()
withCallingHandlers(library(actuar), message = function(m) {
  msg <<- c(msg, conditionMessage(m)); invokeRestart("muffleMessage") })
@
<<w3h1-actuar, eval=FALSE>>=
library(actuar)
@
<<w3h1-actuar-msg, echo=FALSE>>=
cat(trimws(msg, "right"), sep = "\n")
@
<<w3h1-ver>>=
packageVersion("actuar")
@
  \small Instalimi një herë: \texttt{install.packages("actuar")}.
\end{frame}

\begin{frame}[fragile]{Gabim i zakonshëm: ``is masked from''}
  \begin{Gabim}
    Mesazhi \texttt{The following objects are masked from 'package:stats': sd, var}
    duket si gabim. Nuk është.
  \end{Gabim}
  \pause
  \begin{itemize}
    \item \Rkey{actuar} përcakton \texttt{var()} dhe \texttt{sd()} që punojnë edhe me të dhëna të grupuara.
    \item Për vektorë numerikë rezultati është \textbf{i njëjtë}:
  \end{itemize}
<<w3h1-mask>>=
c(actuar = var(x1), stats = stats::var(x1))
@
\end{frame}

\begin{frame}{Çfarë ofron \texttt{actuar} sot}
  \centering
  \begin{tabular}{ll}
    \toprule
    Detyra & Funksionet \\
    \midrule
    Shpërndarjet e humbjeve & \texttt{dpareto}, \texttt{ppareto1}, \texttt{levgamma}, \dots \\
    Modifikimet e policës & \texttt{coverage()} \\
    Përzierjet dhe shumat e përbëra & \texttt{rmixture()}, \texttt{rcompound()} \\
    Diskretizimi & \texttt{discretize()} \\
    Shpërndarja e $S$ & \texttt{aggregateDist()} \\
    Masat e rrezikut & \texttt{VaR()}, \texttt{CTE()} \\
    \bottomrule
  \end{tabular}\par
  \vspace{6pt}
  \small Burimi: vinjetat e paketës \Rkey{actuar} (\Sexpr{as.character(packageVersion("actuar"))}).
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse $\Pr(S=0)\ge\Pr(N=0)$, dhe kur kemi barazim?
    \item Me $E[N]=2$, $\mathrm{Var}[N]=2$, $E[X]=100$, $\mathrm{Var}[X]=400$: sa është $\mathrm{Var}[S]$?
    \item Pse $S=N\cdot X$ jep variancë të gabuar?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) $S=0$ edhe kur ka dëme me shumë 0; barazim kur $X>0$;
  (2) $2\times400+2\times10\,000=20\,800$; (3) supozon që të gjitha dëmet e vitit janë të barabarta.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 1}
  \begin{itemize}
    \item Modeli kolektiv: $S=X_1+\dots+X_N$, me $X_i$ i.i.d.\ dhe të pavarura nga $N$.
    \item $\Pr(S=s)=\sum_k\Pr(N=k)f^{*k}(s)$: konvolucion i peshuar.
    \item $E[S]=E[N]E[X]$; \; $\mathrm{Var}[S]=E[N]\mathrm{Var}[X]+\mathrm{Var}[N]E[X]^2$.
    \item Poisson i përbërë: $\mathrm{Var}[S]=\lambda E[X^2]$; CV bie si $1/\sqrt{\lambda}$.
  \end{itemize}
  \vfill
  \begin{block}{Ora 2}
    Shpërndarjet e humbjeve në \Rkey{actuar}, franshiza dhe limiti, vlera e pritur e kufizuar, përzierjet.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 1)}
  \small
  \begin{itemize}
    \item Programi i lëndës MFM2SII09, FIMIF--UPT, 2025--2026.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015 (kapitulli për modelet e dëmeve agregate).
    \item E.~Raço, E.~Llagami, K.~Haxhi, O.~Zaçaj, \emph{Teoria e Probabiliteteve dhe Statistika
          Matematike me ilustrime në gjuhën R}, Kotti, 2021 (pritja e kushtëzuar).
    \item V.~Goulet et al., vinjetat e paketës \Rkey{actuar} (versioni \Sexpr{as.character(packageVersion("actuar"))}).
    \item README i të dhënave: \texttt{motor\_portfolio\_synthetic.csv} (sintetike).
  \end{itemize}
\end{frame}
