% ============================================================
%  Java 1 · Ora 4 — Teoria II: funksionet, rrjedha, të dhënat, kurthet
% ============================================================
\section{Teoria II}

\begin{frame}{Ora 4 · Funksionet, rrjedha, kurthet}
  \tableofcontents[currentsection,hideothersubsections,sectionstyle=show/hide]
\end{frame}

<<h4-setup, include=FALSE>>=
# Functions from Hour 3, redefined so this hour runs on its own
epv_term <- function(qx, i = 0.05, n = length(qx)) {
  stopifnot(n <= length(qx))
  v <- 1 / (1 + i); kpx <- c(1, cumprod(1 - qx))[1:n]
  sum(v^(1:n) * kpx * qx[1:n])
}
annuity_due <- function(qx, i = 0.05, n = length(qx)) {
  stopifnot(n <= length(qx))
  v <- 1 / (1 + i); kpx <- c(1, cumprod(1 - qx))[1:n]
  sum(v^(0:(n - 1)) * kpx)
}
qx <- c(0.010, 0.012, 0.015, 0.019, 0.024)
@

% ------------------------------------------------------------
\subsection{Funksionet më thellë}
% ------------------------------------------------------------

\begin{frame}[fragile]{Argumentet: sipas pozicionit apo sipas emrit}
<<h4-args>>=
epv_term(qx, 0.03, 3)              # by position: qx, i, n
epv_term(qx, n = 3, i = 0.03)      # by name: order does not matter
@
  \pause
  \begin{Keshille}
    Argumentin e parë jepe me pozicion. Të tjerët \textbf{me emër}:
    kodi lexohet më lehtë dhe gabohet më pak.
  \end{Keshille}
\end{frame}

\begin{frame}[fragile]{Një funksion që kthen disa vlera}
<<h4-list>>=
price_term <- function(qx, S = 100000, i = 0.05, n = length(qx)) {
  A <- epv_term(qx, i, n)
  a <- annuity_due(qx, i, n)
  list(NSP = S * A, annuity = a, P = S * A / a)   # several results
}
res <- price_term(qx)
res$P
unlist(res)
@
\end{frame}

\begin{frame}[fragile]{Fusha e veprimit (\emph{scope})}
<<h4-scope>>=
v <- 999                       # a global v
f <- function(i) {
  v <- 1 / (1 + i)             # a local v, lives only inside f
  v
}
f(0.05)
v                              # the global v is untouched
@
  \pause
  \small Brenda funksionit punon një ``dhomë'' më vete. Objektet lokale zhduken kur funksioni mbaron.
\end{frame}

\begin{frame}[fragile]{Gabim i zakonshëm: variabla globale e fshehur}
<<h4-global>>=
i <- 0.05
pv_bad <- function(x, t) x / (1 + i)^t    # i is NOT an argument!
pv_bad(100, 3)
i <- 0.10                                  # somebody changes i ...
pv_bad(100, 3)                             # ... and the result changes
@
  \pause
  \begin{Gabim}Çdo gjë që përdor funksioni duhet të hyjë si \textbf{argument}.\end{Gabim}
\end{frame}

\begin{frame}[label=pyetjeScope]{Parashiko!}
  \begin{Parashiko}
    \ttfamily
    S <- 100000\\
    g <- function(q) \{ S <- 50000; S * q \}\\
    g(0.01)\\
    S
  \end{Parashiko}
  \normalfont Çfarë printojnë dy rreshtat e fundit?
  \vspace{4pt}

  \shkoTe{zgjScope}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Dokumento funksionin}
<<h4-doc, eval=FALSE>>=
# price_term(): net premiums of an n-year term insurance
#   qx : vector of one-year death probabilities, starting at the entry age
#   S  : sum insured (EUR);  i : annual interest rate;  n : term (years)
# Returns a list: NSP (net single premium), annuity, P (net annual premium)
# Check: Hour 1 toy table, n = 3, i = 5%  ->  NSP = 3336.57
@
  \pause
  \small Katër rreshta komente kursejnë një orë kërkimi pas gjashtë muajsh.
\end{frame}

% ------------------------------------------------------------
\subsection{Kontrolli i rrjedhës}
% ------------------------------------------------------------

\begin{frame}[fragile]{\texttt{if} / \texttt{else}: një vendim}
<<h4-if>>=
loading <- function(age) {
  if (age >= 60) {
    0.30          # higher expense loading for older entrants
  } else {
    0.10
  }
}
loading(45)
loading(65)
@
\end{frame}

\begin{frame}[fragile]{Gabim i zakonshëm: \texttt{if} me një vektor}
<<h4-ifvec, error=TRUE>>=
ages <- c(45, 65, 30)
loading(ages)
@
  \pause
  \begin{Gabim}\texttt{if} pranon \textbf{një} vlerë logjike. Për vektorë përdor \texttt{ifelse()}.\end{Gabim}
\end{frame}

\begin{frame}[fragile]{\texttt{ifelse()}: vendim për çdo element}
<<h4-ifelse>>=
ages <- c(45, 65, 30)
ifelse(ages >= 60, 0.30, 0.10)       # condition, value if TRUE, value if FALSE
@
  \pause
  \begin{itemize}
    \item \texttt{ifelse()} është e vektorizuar: një rezultat për çdo moshë.
    \item Lexohet si formula në Excel: \texttt{=IF(A2>=60; 0.3; 0.1)}, por për gjithë kolonën.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Zbritja dhe limiti: \texttt{pmax()} dhe \texttt{pmin()}}
<<h4-ded>>=
claims <- c(300, 1200, 4500, 9000)     # ground-up losses (EUR)
d <- 500                               # deductible (franchise)
pmax(claims - d, 0)                    # insurer pays the excess over d
pmin(pmax(claims - d, 0), 5000)        # ... capped at a limit of 5000
@
  \pause
  \small \texttt{pmax}/\texttt{pmin} = maksimumi/minimumi \textbf{element për element}. Do t'i përdorim në Javën 3 (stop-loss).
\end{frame}

\begin{frame}[label=ush4a]{Radha jote!}
  \begin{Ushtrim}[(3 minuta)]
    Dëmet: \texttt{c(250, 800, 2600, 7400, 15000)}. Zbritja 1\,000 €, limiti 10\,000 €.
    \begin{enumerate}
      \item Sa paguan siguruesi për secilin dëm?
      \item Sa paguan gjithsej?
      \item Sa dëme \textbf{nuk} paguhen fare?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjUsh4a}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{\texttt{while}: kur nuk e dimë numrin e hapave}
<<h4-while>>=
fund <- 1000; i <- 0.05; years <- 0
while (fund < 2000) {            # repeat until the fund doubles
  fund  <- fund * (1 + i)
  years <- years + 1
}
years
round(fund, 2)
log(2) / log(1.05)               # exact doubling time, for comparison
@
\end{frame}

\begin{frame}[label=gjejGab4a]{Gjej gabimin}
  \begin{Gabim}[(nga një student)]
    \ttfamily
    fund <- 1000; i <- 0; years <- 0\\
    while (fund < 2000) \{\\
    \quad fund <- fund * (1 + i)\\
    \quad years <- years + 1\\
    \}
  \end{Gabim}
  \normalfont
  \begin{enumerate}
    \item Çfarë ndodh kur e ekzekuton?
    \item Si e mbron ciklin?
  \end{enumerate}
  \shkoTe{zgjGab4a}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Leximi i të dhënave}
% ------------------------------------------------------------

\begin{frame}[fragile]{\texttt{read.csv()}: tabela e vdekshmërisë (sintetike)}
<<h4-read>>=
mt <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
dim(mt)
head(mt, 4)
@
  \small\textcolor{gray}{Të dhëna \textbf{sintetike}: Gompertz--Makeham me parametra të njohur.}
\end{frame}

\begin{frame}[fragile]{Kontrolli i parë: \texttt{str()} dhe \texttt{summary()}}
<<h4-str>>=
str(mt)
summary(mt$qx_male)
@
  \pause
  \small Pse $\max q_x = 1$? Tabela mbyllet në moshën 110: askush nuk e kalon.
\end{frame}

\begin{frame}{E vërteta pas të dhënave sintetike}
  \begin{Definicion}[(ligji Gompertz--Makeham)]
    Intensiteti i vdekjes (\emph{force of mortality}):\quad $\mu_x = A + B\,c^{x}$
  \end{Definicion}
  \pause
  \begin{itemize}
    \item Parametrat e vërtetë (meshkuj): $A=0.0005$, $B=0.000022$, $c=1.105$.
    \item Nga $\mu_x$ te $q_x$:
      \[
        q_x = 1-\exp\!\Big(-\!\int_x^{x+1}\!\mu_s\,ds\Big)
            = 1-\exp\!\Big(-A-B\,c^{x}\,\frac{c-1}{\ln c}\Big)
      \]
  \end{itemize}
  \pause
  \small $A$: vdekje ``aksidentale'', e pavarur nga mosha. $B c^x$: plakja, rritje eksponenciale.
\end{frame}

\begin{frame}[fragile]{Të dhënat vs e vërteta}
<<h4-truth>>=
gm_qx <- function(x, A = 0.0005, B = 0.000022, c = 1.105)
  1 - exp(-A - B * c^x * (c - 1) / log(c))
chk <- mt[mt$age %in% c(20, 40, 60, 80, 100), c("age", "qx_male")]
chk$qx_true <- round(gm_qx(chk$age), 6)
chk
@
  \pause
  \small Përputhje e plotë (deri në 6 shifra). Përjashtime të qëllimshme: mosha 0 dhe 110.
\end{frame}

\begin{frame}[fragile]{Gabim i zakonshëm: rruga e skedarit}
<<h4-path, error=TRUE, warning=FALSE>>=
mt2 <- read.csv("mortality_table_synthetic.csv")   # wrong folder
@
  \pause
  \begin{Gabim}\texttt{cannot open file}: skedari nuk është aty ku e kërkon R.\end{Gabim}
  \begin{Keshille}Kontrollo me \texttt{getwd()} dhe \texttt{list.files("data")}. Përdor projekt + rrugë relative.\end{Keshille}
\end{frame}

\begin{frame}{Shkronjat shqipe: kodimi (\emph{encoding})}
  \begin{itemize}
    \item<1-> Emrat e qyteteve: \emph{Durrës}, \emph{Shkodër}, \emph{Korçë}.
    \item<2-> Nëse dalin si \texttt{DurrÃ«s}, skedari u lexua me kodim të gabuar.
    \item<3-> Zgjidhja: \texttt{read.csv("file.csv", fileEncoding = "UTF-8")}.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}Ruaj gjithmonë CSV-të dhe skriptet në UTF-8.\end{Keshille}}
\end{frame}

% ------------------------------------------------------------
\subsection{Familja apply}
% ------------------------------------------------------------

\begin{frame}{Problemi: çmimi për shumë mosha}
  \centering
  \begin{tikzpicture}[>=Stealth,
      c/.style={draw=uptblue,fill=uptlight,minimum width=1.1cm,minimum height=0.65cm,font=\ttfamily\small},
      r/.style={c,fill=accent!12,draw=accent}]
    \foreach \a/\k in {30/0,40/1,50/2,60/3}{
      \node[c] (a\k) at (1.5*\k,1.6) {\a};
      \node[r] (r\k) at (1.5*\k,-0.6) {P(\a)};
      \draw[->,thick,uptmid] (a\k) -- (r\k);
    }
    \node[draw=okgreen,fill=okgreen!10,rounded corners=2pt,font=\ttfamily\small] at (2.25,0.5) {premium\_at(age)};
  \end{tikzpicture}\par
  \vspace{6pt}
  \begin{itemize}
    \item<2-> Një funksion që punon për \textbf{një} moshë.
    \item<3-> \texttt{sapply()} e zbaton për çdo element të vektorit dhe mbledh rezultatet.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Funksioni për një moshë}
<<h4-premat>>=
premium_at <- function(age, n = 10, i = 0.03, S = 100000) {
  q <- mt$qx_male[mt$age >= age][1:n]       # qx for ages age .. age+n-1
  S * epv_term(q, i, n) / annuity_due(q, i, n)
}
premium_at(40)                               # 10-year term, male aged 40
@
  \pause
  \small Moshat e tabelës fillojnë nga 0, ndaj zgjedhim me kusht dhe jo me pozicion.
\end{frame}

\begin{frame}[fragile]{\texttt{sapply()}: për çdo moshë}
<<h4-sapply>>=
ages <- seq(30, 70, by = 10)
P <- sapply(ages, premium_at)     # apply premium_at to each age
round(P, 2)
@
  \pause
  \begin{itemize}
    \item Prima vjetore neto për 10 vjet, $S=100\,000$ €, $i=3\%$ (tabela sintetike, meshkuj).
    \item Nga 30 në 70 vjeç, prima rritet rreth \Sexpr{round(P[5]/P[1])} herë.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]{Figura: prima sipas moshës}
<<h4-plotP, echo=FALSE, fig.width=6, fig.height=2.8, out.width='0.72\\textwidth'>>=
library(ggplot2)
dfP <- data.frame(age = 20:75, P = sapply(20:75, premium_at))
ggplot(dfP, aes(age, P)) +
  geom_line(colour = "#2C5AA0", linewidth = 1) +
  scale_y_log10() +
  labs(x = "Entry age", y = "Premium (EUR, log)") +
  theme_minimal(base_size = 13)
@
  \small Shkalla logaritmike: vija pothuajse e drejtë $\Rightarrow$ rritje përafërsisht eksponenciale (Gompertz).
\end{frame}

\begin{frame}[fragile]{\texttt{vapply()} dhe \texttt{Map()}}
<<h4-vapply>>=
vapply(ages, premium_at, FUN.VALUE = numeric(1))   # type-checked sapply
unlist(Map(premium_at, age = c(40, 40, 50), n = c(5, 10, 10)))
@
  \pause
  \begin{itemize}
    \item \texttt{vapply}: i njëjti si \texttt{sapply}, por kontrollon që çdo rezultat është 1 numër.
    \item \texttt{Map}: kalon \textbf{dy ose më shumë} vektorë paralelisht (mosha dhe afati).
  \end{itemize}
\end{frame}

\begin{frame}[label=ndrysho4]{Ndrysho parametrin dhe shiko}
  \begin{Ushtrim}[(në kompjuter)]
    \begin{enumerate}
      \item Llogarit primat për moshat 30--70 me $i=1\%$ në vend të 3\%.
      \item Prima rritet apo zvogëlohet? Për cilën moshë ndryshimi relativ është më i madh?
    \end{enumerate}
    Ndihmë: \texttt{sapply(ages, premium\_at, i = 0.01)}.
  \end{Ushtrim}
  \shkoTe{zgjNdrysho4}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Numrat e rastit}
% ------------------------------------------------------------

\begin{frame}[fragile]{Rastësia e riprodhueshme}
<<h4-seed>>=
set.seed(2026); runif(3)
set.seed(2026); runif(3)      # same seed -> same numbers
runif(3)                      # no reset -> new numbers
@
  \pause
  \small Kompjuteri prodhon numra \termi{pseudo-të rastit}{pseudo-random}: një algoritëm i përcaktuar nga \emph{seed}.
\end{frame}

\begin{frame}[fragile]{Gjeneratorët që do të përdorim}
<<h4-rng>>=
set.seed(2026)
rbinom(5, size = 1000, prob = 0.01)    # deaths in 5 portfolios of 1000
round(rlnorm(3, meanlog = 7, sdlog = 0.9), 2)   # claim amounts
sample(c("agent", "online", "bank"), 5, replace = TRUE)
@
  \pause
  \begin{Keshille}Një \texttt{set.seed()} në krye të skriptit mjafton. Mos e vendos brenda cikleve.\end{Keshille}
\end{frame}

% ------------------------------------------------------------
\subsection{Kurthet e R}
% ------------------------------------------------------------

\begin{frame}[fragile]{Kurthi 1: numrat me presje dhjetore}
<<h4-float>>=
0.1 + 0.2 == 0.3
print(0.1 + 0.2, digits = 17)
isTRUE(all.equal(0.1 + 0.2, 0.3))     # compare with a tolerance
@
  \pause
  \begin{Gabim}Mos krahaso numra realë me \texttt{==}. Përdor \texttt{all.equal()}.\end{Gabim}
\end{frame}

\begin{frame}[fragile]{Kurthi 1 në praktikë: nga $q_x$ te $p_x$ dhe mbrapsht}
<<h4-float2>>=
q <- 0.3
p <- 1 - q                  # survival probability
1 - p == q                  # mathematically TRUE ...
(1 - p) - q                 # ... but a tiny rounding error remains
isTRUE(all.equal(1 - p, q))
@
  \pause
  \small Një kontroll si \texttt{if (1 - p == q)} do të dështonte pa asnjë arsye reale.
\end{frame}

\begin{frame}[fragile]{Kurthi 2: \texttt{1:length(x)} kur \texttt{x} është bosh}
<<h4-seq, error=TRUE>>=
claims <- c()                         # no claims this month
1:length(claims)                      # gives 1 0 : two iterations!
seq_along(claims)                     # gives nothing: zero iterations
@
  \pause
  \begin{Keshille}Në cikle përdor \texttt{seq\_along(x)} ose \texttt{seq\_len(n)}.\end{Keshille}
\end{frame}

\begin{frame}[fragile]{Kurthi 3: \texttt{factor} $\rightarrow$ numër}
<<h4-factor>>=
age_band <- factor(c("40", "45", "50", "40"))
as.numeric(age_band)                 # WRONG: internal level codes
as.numeric(as.character(age_band))   # right: via text
@
  \pause
  \begin{Gabim}\texttt{as.numeric()} mbi një \texttt{factor} jep kodet 1, 2, 3, jo vlerat.\end{Gabim}
\end{frame}

\begin{frame}[fragile]{Kurthi 4: \texttt{T} dhe \texttt{F}}
<<h4-TF>>=
T                    # T is just a variable that starts as TRUE ...
T <- 0               # ... and anyone can overwrite it
isTRUE(T)
rm(T)                # restore
@
  \pause
  \begin{Gabim}Shkruaj gjithmonë \texttt{TRUE} dhe \texttt{FALSE} të plota.\end{Gabim}
\end{frame}

\begin{frame}[label=gjejGab4b]{Gjej gabimin: tre gabime në një skript}
  \begin{Gabim}[(nga një student)]
    \ttfamily\small
    band <- factor(c("30", "40", "50"))\\
    ages <- as.numeric(band)\\
    out <- c()\\
    for (k in 1:length(out)) out[k] <- k\\
    if (ages >= 40) print("old")
  \end{Gabim}
  \normalfont Gjej të tre gabimet.
  \vspace{4pt}

  \shkoTe{zgjGab4b}{Shiko zgjidhjen}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse \texttt{if (ages >= 60)} jep gabim kur \texttt{ages} ka 3 vlera?
    \item Si llogarit pagesën e siguruesit me zbritje \texttt{d} për një vektor dëmesh?
    \item Si krahason dy numra realë në mënyrë të sigurt?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) \texttt{if} pret një vlerë, përdor \texttt{ifelse}; (2) \texttt{pmax(x - d, 0)}; (3) \texttt{isTRUE(all.equal(a, b))}.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 4}
  \begin{itemize}
    \item Funksionet: argumente me emër, kthim i listave, asnjë variabël globale e fshehur.
    \item Rrjedha: \texttt{if} për një vlerë; \texttt{ifelse}, \texttt{pmax}, \texttt{pmin} për vektorë; \texttt{while}.
    \item Të dhënat: \texttt{read.csv} $\rightarrow$ \texttt{str} $\rightarrow$ kontroll me të vërtetën.
    \item \texttt{sapply}, \texttt{vapply}, \texttt{Map}: një funksion, shumë hyrje.
    \item Kurthet: \texttt{==} me realë, \texttt{1:length}, \texttt{factor}, \texttt{T}/\texttt{F}.
  \end{itemize}
  \vfill
  \begin{block}{Ora 5}
    Laborator II: \texttt{ggplot2} dhe \texttt{lm()} mbi tabelën e plotë: vlerësojmë ligjin Gompertz.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 4)}
  \small
  \begin{itemize}
    \item K.~Antonio, \emph{Introduction to R for actuaries}, kapitujt mbi funksionet, ciklet dhe importin e të dhënave.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015
          (kapitulli mbi tabelat e jetës; ligjet parametrike të vdekshmërisë).
    \item README i të dhënave: \texttt{mortality\_table\_synthetic.csv}, parametrat e vërtetë Gompertz--Makeham.
    \item Dokumentacioni i R: \texttt{?ifelse}, \texttt{?sapply}, \texttt{?all.equal}, \texttt{?Random}.
  \end{itemize}
\end{frame}
