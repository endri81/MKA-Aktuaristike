\subsection{Mjedisi i punës}
% ------------------------------------------------------------

\begin{frame}{R dhe RStudio: cili është ndryshimi?}
  \begin{columns}[T]
    \column{0.48\textwidth}
      \begin{block}{R}
        \begin{itemize}
          \item Gjuha dhe \textbf{motori} i llogaritjes.
          \item Falas, \emph{open source}.
          \item Shkarkohet nga CRAN.
        \end{itemize}
      \end{block}
    \column{0.48\textwidth}
      \begin{block}{RStudio}
        \begin{itemize}
          \item \textbf{Paneli i komandimit} rreth R.
          \item Editor, grafikë, ndihmë.
          \item Nuk punon pa R.
        \end{itemize}
      \end{block}
  \end{columns}
  \vspace{6pt}
  \pause
  \small Analogji: R është motori i makinës; RStudio është timoni dhe paneli.
\end{frame}

\begin{frame}{Katër panelet e RStudio}
  \centering
  \begin{tikzpicture}[
      pn/.style={draw=uptblue,fill=uptlight,minimum width=5.2cm,minimum height=2.1cm,
                 align=center,font=\small}]
    \node[pn] (s) at (0,1.4)  {\textbf{Skripti}\\kodi që ruan};
    \node[pn] (c) at (0,-1.4) {\textbf{Konsola}\\ku ekzekutohet kodi};
    \node[pn] (e) at (5.4,1.4)  {\textbf{Mjedisi}\\objektet në memorie};
    \node[pn] (f) at (5.4,-1.4) {\textbf{Skedarët / Grafikët}\\Ndihma, paketat};
    \pause
    \draw[->,very thick,accent] (s.south) -- node[left,font=\scriptsize\bfseries,text=accent]{Ctrl+Enter} (c.north);
  \end{tikzpicture}\par
  \vspace{4pt}
  \onslide<2->{\small Shkruaj gjithmonë në \textbf{skript}, jo direkt në konsolë.}
\end{frame}

\begin{frame}{Projekti në RStudio: një dosje për çdo punë}
  \centering
  \begin{tikzpicture}[grow via three points={one child at (0.5,-0.6) and two children at (0.5,-0.6) and (0.5,-1.2)},
      edge from parent path={(\tikzparentnode.south) |- (\tikzchildnode.west)},
      every node/.style={anchor=west,font=\small\ttfamily}]
    \node {mka\_java01/}
      child {node {mka\_java01.Rproj} }
      child {node {data/ \textrm{\textcolor{gray}{(CSV-të, nuk ndryshohen)}}}}
      child {node {R/ \textrm{\textcolor{gray}{(skriptet)}}}}
      child {node {output/ \textrm{\textcolor{gray}{(grafikë, tabela)}}}};
  \end{tikzpicture}\par
  \vspace{4pt}
  \pause
  \begin{Keshille}
    Me projekt, rrugët janë \textbf{relative}: \texttt{"data/file.csv"}.
    Kodi punon njësoj në çdo kompjuter.
  \end{Keshille}
\end{frame}

\begin{frame}[fragile]{Koka e çdo skripti}
<<script-header, eval=FALSE>>=
# ------------------------------------------------
# MKA - Week 1 - Toy life table
# Author: <your name>     Date: 2026-11-04
# Purpose: net single premium of a 3-year term policy
# ------------------------------------------------
set.seed(2026)     # makes any random result reproducible
library(ggplot2)   # load packages at the top, once
@
  \pause
  \small Kush e lexon skriptin pas 6 muajsh? \textbf{Ti vetë.} Shkruaj për atë person.
\end{frame}

\begin{frame}{Tri shkurtore që kursejnë orë}
  \centering
  \begin{tabular}{@{}ll@{}}
    \toprule
    Shkurtorja & Çfarë bën \\ \midrule
    \texttt{Ctrl + Enter} & ekzekuton rreshtin (ose zgjedhjen) \\
    \texttt{Ctrl + Shift + S} & ekzekuton të gjithë skriptin \\
    \texttt{Ctrl + Shift + C} & komenton / çkomenton rreshtat \\
    \bottomrule
  \end{tabular}
  \vspace{6pt}
  \begin{itemize}
    \item Në Mac: \texttt{Cmd} në vend të \texttt{Ctrl}.
  \end{itemize}
\end{frame}

\begin{frame}{Gabim i zakonshëm në ditën e parë}
  \begin{Gabim}
    \begin{itemize}
      \item Puna bëhet në konsolë dhe nuk ruhet askund.
      \item Rruga absolute: \texttt{"C:/Users/Ana/Desktop/data.csv"}.
      \item Rifillimi i R nuk bëhet kurrë: objekte të vjetra fshehin gabime.
    \end{itemize}
  \end{Gabim}
  \pause
  \begin{Keshille}
    Test i thjeshtë: \emph{Session $\rightarrow$ Restart R}, pastaj ekzekuto gjithë skriptin.
    Nëse punon, puna jote është e riprodhueshme.
  \end{Keshille}
\end{frame}

% ------------------------------------------------------------
\subsection{Përmbyllje}
% ------------------------------------------------------------

\begin{frame}{\textcolor{accent}{$\checkmark$} Checkpoint}
  \begin{enumerate}
    \item Pse eksponenti i $v$ në $A^{1}_{x:\overline{n}|}$ është $k+1$ dhe jo $k$?
    \item Nëse $l_{50}=900$ dhe $l_{52}=870$, sa është ${}_2p_{50}$?
    \item Pse një aktuar punon me skript dhe jo direkt në konsolë?
  \end{enumerate}
  \pause\vfill
  \small\textcolor{gray}{Përgjigjet: (1) pagesa në fund të vitit; (2) $870/900=0.9667$; (3) riprodhueshmëria.}
\end{frame}

\begin{frame}{Përmbledhje e Orës 1}
  \begin{itemize}
    \item Çmimi = probabilitet $\times$ aktualizim $\times$ shumë, i mbledhur mbi vitet.
    \item $d_x=l_x-l_{x+1}$, $q_x=d_x/l_x$, ${}_tp_x=l_{x+t}/l_x$, $v=1/(1+i)$.
    \item Shembulli: prima e vetme neto $= 3\,336.57$ € (pa ndihmën e PC = me R).
    \item R: \textbf{skript} + \textbf{projekt} + \textbf{vektorizim}.
  \end{itemize}
  \vfill
  \begin{block}{Ora 2}
    Gjuha R nga brenda: objektet, tipet, vektorët, indeksimi.
  \end{block}
\end{frame}

\begin{frame}{Burime (Ora 1)}
  \small
  \begin{itemize}
    \item Programi i lëndës MFM2SII09, FIMIF--UPT, 2025--2026.
    \item A.~Charpentier (ed.), \emph{Computational Actuarial Science with R}, CRC Press, 2015
          (kapitulli mbi tabelat e jetës dhe sigurimet e jetës).
    \item K.~Antonio, \emph{Introduction to R for actuaries}, kapitujt 1--2 (R dhe RStudio).
    \item README i të dhënave të kursit: \texttt{mortality\_table\_synthetic.csv}
          (sintetike, Gompertz--Makeham).
  \end{itemize}
\end{frame}
