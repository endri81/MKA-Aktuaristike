\begin{frame}{Objektivat e ditës}
  Në fund të ditës do të jesh në gjendje:
  \begin{enumerate}
    \item<1-> të punosh në RStudio me një \termi{projekt}{project} të riprodhueshëm; \LO{S2}
    \item<2-> të krijosh dhe indeksosh vektorë dhe \termi{korniza të dhënash}{data frames}; \LO{K1}
    \item<3-> të shkruash funksionin tënd të parë aktuarial; \LO{S2}
    \item<4-> të llogaritësh $l_x$, $d_x$, ${}_tp_x$ dhe një vlerë aktuale nga zero; \LO{S2}
    \item<5-> të vizatosh kurba me \Rkey{ggplot2}; \LO{S2}
    \item<6-> të përdorësh \Rkey{lm()} nga libraria \Rkey{stats}. \LO{K1}
  \end{enumerate}
\end{frame}

\begin{frame}{Objektivat e kësaj ore}
  \begin{enumerate}
    \item<1-> Të kuptosh \textbf{pse} R në punën aktuariale.
    \item<2-> Të njohësh kursin: temat, vlerësimin, literaturën, të dhënat.
    \item<3-> Të rifreskosh: $l_x$, $d_x$, $q_x$, $p_x$, ${}_tp_x$, $v$.
    \item<4-> Të llogaritësh \textbf{pa ndihmën e PC} çmimin e një sigurimi 3-vjeçar.
    \item<5-> Të shohësh të njëjtin rezultat në R.
  \end{enumerate}
\end{frame}

