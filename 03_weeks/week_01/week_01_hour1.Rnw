\begin{frame}[label=ush1]{Radha jote!}
  \begin{Ushtrim}[(2 minuta, me letër)]
    Nga grafiku: $l_{40}=1000$, $l_{41}=990$, $l_{42}=978$, $l_{43}=963$.
    \begin{enumerate}
      \item Llogarit $d_{40}$, $d_{41}$, $d_{42}$.
      \item Llogarit $q_{41}$ me 4 shifra pas presjes.
      \item Llogarit ${}_3p_{40}$.
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjUsh1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Vlera në kohë e parasë}
  \begin{itemize}
    \item<1-> 100 € sot vlejnë më shumë se 100 € pas një viti.
    \item<2-> Pse? Sepse 100 € sot, të investuara me interes $i$, bëhen $100(1+i)$.
  \end{itemize}
  \onslide<3->{
  \begin{Definicion}[(faktori i aktualizimit, \emph{discount factor})]
    \[
      v=\frac{1}{1+i}
      \qquad\Rightarrow\qquad
      \text{vlera sot e 1 € pas } t \text{ vitesh} = v^t
    \]
  \end{Definicion}}
\end{frame}

