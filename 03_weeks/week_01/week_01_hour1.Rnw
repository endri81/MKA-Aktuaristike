% ------------------------------------------------------------
\subsection{Rifreskim}
% ------------------------------------------------------------

\begin{frame}{Tabela e jetës: ideja}
  \begin{itemize}
    \item<1-> Imagjino një grup prej 1\,000 personash, të gjithë \textbf{40 vjeç} sot.
    \item<2-> Çdo vit, disa prej tyre vdesin.
    \item<3-> Tabela e jetës tregon \textbf{sa mbeten gjallë} në çdo moshë.
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}
    Tabela e jetës është thjesht një \textbf{numërim}: sa hyjnë, sa dalin.
  \end{Keshille}}
\end{frame}

\begin{frame}{Përkufizimet: $l_x$ dhe $d_x$}
  \begin{Definicion}[(të gjallët dhe të vdekurit)]
    \begin{itemize}
      \item $l_x$ = numri i të gjallëve në moshën e saktë $x$.
      \item $d_x$ = numri i atyre që vdesin midis moshës $x$ dhe $x+1$.
    \end{itemize}
  \end{Definicion}
  \pause
  \[
    d_x \;=\; l_x - l_{x+1}
  \]
  \pause
  \small Pse? Kush ishte gjallë në $x$ dhe nuk është më në $x+1$, ka vdekur gjatë vitit.
\end{frame}

\begin{frame}{Përkufizimet: $q_x$ dhe $p_x$}
  \begin{Definicion}[(probabilitetet njëvjeçare)]
    \[
      q_x=\frac{d_x}{l_x}
      \qquad\qquad
      p_x = 1-q_x=\frac{l_{x+1}}{l_x}
    \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item $q_x$: probabiliteti që një person $x$ vjeç të vdesë brenda vitit.
    \item $p_x$: probabiliteti që të mbijetojë deri në $x+1$.
  \end{itemize}
  \pause
  \begin{Gabim}
    $q_x$ \textbf{nuk} është ``përqindja e vdekjeve në popullsi''.
    Është probabilitet \emph{me kusht}: personi është gjallë në moshën $x$.
  \end{Gabim}
\end{frame}

\begin{frame}{Mbijetesa për $t$ vjet: ${}_tp_x$}
  \begin{Definicion}
    ${}_tp_x$ = probabiliteti që një person $x$ vjeç të jetë gjallë në moshën $x+t$.
  \end{Definicion}
  \begin{align*}
    {}_tp_x &= \frac{l_{x+t}}{l_x} \\
    \onslide<2->{&= \frac{l_{x+1}}{l_x}\cdot\frac{l_{x+2}}{l_{x+1}}\cdots\frac{l_{x+t}}{l_{x+t-1}}\\}
    \onslide<3->{&= p_x\,p_{x+1}\cdots p_{x+t-1}}
  \end{align*}
  \onslide<4->{\small Pse? Për të mbijetuar 3 vjet, duhet të mbijetosh \textbf{çdo} vit, një nga një.}
\end{frame}

