  \end{tikzpicture}\par
  \vspace{4pt}
  \pause
  \small Tre pagesa të mundshme. Vetëm \textbf{njëra} mund të ndodhë.
\end{frame}

% ------------------------------------------------------------
\subsection{Shembull pa PC}
% ------------------------------------------------------------

\begin{frame}{Tabela jonë e vogël}
  \centering
  \begin{tabular}{@{}ccccc@{}}
    \toprule
    $x$ & $l_x$ & $d_x$ & $q_x$ & $p_x$ \\ \midrule
    40 & 1000 & 10 & 0.010000 & 0.990000 \\
    41 & 990  & 12 & 0.012121 & 0.987879 \\
    42 & 978  & 15 & 0.015337 & 0.984663 \\
    43 & 963  & -- & -- & -- \\
    \bottomrule
  \end{tabular}
  \vspace{8pt}
  \pause
  \begin{itemize}
    \item Interesi: $i=5\%$. Shuma e siguruar: $S=100\,000$ €.
    \item Klienti: $x=40$. Afati: $n=3$ vjet.
  \end{itemize}
\end{frame}

\begin{frame}[label=parashikoP3]{Hapi 1: mbijetesa 3-vjeçare}
  \begin{Parashiko}
    Para se ta llogarisim: ${}_3p_{40}$ është afër 0.90, 0.96, apo 0.99?
  \end{Parashiko}
  \pause
  \[
    {}_3p_{40}=\frac{l_{43}}{l_{40}}=\frac{963}{1000}=0.963
  \]
  \pause
  \small Kontroll: $0.99\times0.987879\times0.984663 = 0.963$. \textcolor{okgreen}{$\checkmark$}
\end{frame}

\begin{frame}{Hapi 2: faktorët e aktualizimit}
  \centering
  \begin{tabular}{@{}cccc@{}}
    \toprule
    Viti & $k$ & $v^{\,k+1}$ & $d_{40+k}/l_{40}$ \\ \midrule
    1 & 0 & 0.952381 & 0.010 \\
    2 & 1 & 0.907029 & 0.012 \\
    3 & 2 & 0.863838 & 0.015 \\
    \bottomrule
  \end{tabular}
  \vspace{6pt}
  \pause
  \begin{Gabim}
    Eksponenti është $k+1$, jo $k$: pagesa bëhet në \textbf{fund} të vitit.
  \end{Gabim}
\end{frame}

\begin{frame}{Hapi 3: shumëzo dhe mblidh}
  \begin{align*}
    A^{1}_{40:\overline{3}|}
    &= 0.952381\cdot0.010 + 0.907029\cdot0.012 + 0.863838\cdot0.015 \\
    \onslide<2->{&= 0.009524 + 0.010884 + 0.012958 \\}
    \onslide<3->{&= 0.033366}
  \end{align*}
  \onslide<4->{
  \[
    \text{Prima e vetme neto}=S\cdot A^{1}_{40:\overline{3}|}
    =100\,000\times0.033366\approx\boxed{3\,336.57\text{ €}}
  \]}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Klienti paguan \textbf{sot} rreth 3\,337 € për mbulim 100\,000 €.
    \item<2-> Pse kaq pak? Probabiliteti i vdekjes në 3 vjet është vetëm $1-0.963=3.7\%$.
    \item<3-> Pse më pak se $3.7\% \times 100\,000 = 3\,700$? Sepse pagesa vjen në të ardhmen: aktualizimi.
    \item<4-> Kjo është prima \textbf{neto}: pa shpenzime, pa marzh fitimi.
  \end{itemize}
  \onslide<5->{
  \begin{Keshille}Gjithmonë bëj një \textbf{kontroll të arsyeshmërisë}: a ka kuptim numri?\end{Keshille}}
\end{frame}

\begin{frame}[label=gjejGab1]{Gjej gabimin}
  \begin{Gabim}[(nga një student)]
    \[
      A^{1}_{40:\overline{3}|} = 1\cdot0.010 + 0.952381\cdot0.012 + 0.907029\cdot0.015 = 0.035034
    \]
    \[
      \Rightarrow \text{prima} = 3\,503.40 \text{ €}
    \]
  \end{Gabim}
  \begin{enumerate}
    \item Ku është gabimi?
    \item Pse rezultati është \textbf{më i madh} se 3\,336.57 €?
  \end{enumerate}
  \shkoTe{zgjGab1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Nga prima e vetme te prima vjetore\Zgj}
  \begin{itemize}
    \item<1-> Klientët zakonisht paguajnë \textbf{çdo vit}, në fillim të vitit, nëse janë gjallë.
    \item<2-> Vlera aktuale e 1 € në vit (\emph{annuity-due}):
      \[
        \ddot a_{40:\overline{3}|}=\frac{l_{40}+l_{41}v+l_{42}v^2}{l_{40}}
        =\frac{1000+942.86+887.07}{1000}=2.829932
      \]
    \item<3-> Prima vjetore neto:
      \[
        P=\frac{3\,336.57}{2.829932}\approx 1\,179.03 \text{ €}
      \]
  \end{itemize}
  \onslide<4->{\small\textcolor{gray}{Këtë do ta formalizojmë në Javën 7.}}
\end{frame}

% ------------------------------------------------------------
\subsection{Pamje e parë e R}
% ------------------------------------------------------------

\begin{frame}[fragile]{E njëjta llogaritje në R}
<<toy-code, eval=FALSE>>=
lx <- c(1000, 990, 978, 963)  # survivors at ages 40..43
dx <- -diff(lx)               # deaths in each year
i  <- 0.05                    # interest rate
v  <- 1 / (1 + i)             # discount factor
A  <- sum(v^(1:3) * dx / lx[1])   # EPV of 1 paid at end of year of death
100000 * A                    # net single premium
@
  \pause
  \small Gjashtë rreshta. Çdo rresht = një hap nga llogaritja pa ndihmën e PC.
\end{frame}

\begin{frame}[fragile]{Rezultati}
<<toy-run, echo=FALSE>>=
lx <- c(1000, 990, 978, 963)
dx <- -diff(lx)
i  <- 0.05
v  <- 1 / (1 + i)
A  <- sum(v^(1:3) * dx / lx[1])
dx
100000 * A
@
  \pause
  \begin{itemize}
    \item $d_x = (10, 12, 15)$: njësoj si në llogaritjen pa ndihmën e PC. \textcolor{okgreen}{$\checkmark$}
    \item Prima $= 3\,336.57$ €: njësoj si në llogaritjen pa ndihmën e PC. \textcolor{okgreen}{$\checkmark$}
  \end{itemize}
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> \Rkey{diff()} llogarit $l_{x+1}-l_x$ për \textbf{të gjitha} moshat njëherësh.
    \item<2-> \Rkey{v\^{}(1:3)} jep $v, v^2, v^3$ me një komandë.
    \item<3-> Kjo quhet \termi{vektorizim}{vectorisation}: pa cikle, pa qeliza.
    \item<4-> Me 100 mosha, kodi mbetet \textbf{po aq i shkurtër}.
  \end{itemize}
  \onslide<5->{
  \begin{Keshille}Vektorizimi është ideja më e rëndësishme e sotme. E shohim në detaje në Orën 2.\end{Keshille}}
\end{frame}

\begin{frame}[label=ndrysho1]{Ndrysho parametrin dhe shiko}
  \begin{Ushtrim}[(në kompjuter)]
    \begin{enumerate}
      \item Ndrysho rreshtin \texttt{i <- 0.05} në \texttt{i <- 0.03}.
      \item Parashiko: prima rritet apo zvogëlohet?
      \item Ekzekuto kodin. Sa del prima?
    \end{enumerate}
  \end{Ushtrim}
  \shkoTe{zgjNdrysho1}{Shiko zgjidhjen}
\end{frame}

\begin{frame}[fragile]{Një shije e Orës 5: tabela e plotë (të dhëna sintetike)}
<<lx-preview-code, eval=FALSE>>=
library(ggplot2)
mt <- read.csv("week_01_data/mortality_table_synthetic.csv")
ggplot(mt, aes(x = age)) +
  geom_line(aes(y = lx_male,   colour = "Male")) +
  geom_line(aes(y = lx_female, colour = "Female")) +
  labs(x = "Age x", y = "l(x)", colour = NULL)
@
  \small\textcolor{gray}{Të dhëna \textbf{sintetike} (Gompertz--Makeham, parametra të njohur).}
\end{frame}

\begin{frame}[fragile]{Kurba $l_x$: meshkuj dhe femra}
<<lx-preview, echo=FALSE, out.width='0.78\\textwidth', fig.width=6, fig.height=3>>=
library(ggplot2)
mt <- read.csv(file.path(DATA, "mortality_table_synthetic.csv"))
ggplot(mt, aes(x = age)) +
  geom_line(aes(y = lx_male,   colour = "Male"),   linewidth = 1) +
  geom_line(aes(y = lx_female, colour = "Female"), linewidth = 1) +
  scale_colour_manual(values = c(Male = "#2C5AA0", Female = "#D97706")) +
  labs(x = "Age x", y = "l(x)", colour = NULL) +
  theme_minimal(base_size = 13) + theme(legend.position = "top")
@
\end{frame}

\begin{frame}{Çfarë na tregon?}
  \begin{itemize}
    \item<1-> Kurba fillon te 100\,000 dhe bie ngadalë deri rreth moshës 60.
    \item<2-> Pas 60 vjetësh bie shpejt: vdekshmëria rritet me moshën.
    \item<3-> Kurba e femrave qëndron \textbf{mbi} atë të meshkujve.
    \item<4-> Pyetje për Orën 5: si e matim sa shpejt rritet $q_x$?
  \end{itemize}
\end{frame}

