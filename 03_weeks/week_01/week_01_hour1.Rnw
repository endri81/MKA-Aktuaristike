\begin{frame}[label=pyetjeV]{Parashiko!}
  \begin{Parashiko}
    Interesi rritet nga 5\% në 6\%. Çfarë ndodh me $v^3$?
    \begin{enumerate}
      \item[A)] Rritet.
      \item[B)] Zvogëlohet.
      \item[C)] Nuk ndryshon.
    \end{enumerate}
    Pastaj: llogarit $v^3$ për $i=6\%$.
  \end{Parashiko}
  \shkoTe{zgjV}{Shiko zgjidhjen}
\end{frame}

\begin{frame}{Vlera aktuale e pritshme: ideja}
  \begin{itemize}
    \item<1-> Kompania paguan 100\,000 € \textbf{vetëm nëse} klienti vdes.
    \item<2-> Pagesa bëhet në \textbf{fund} të vitit të vdekjes.
    \item<3-> Pra, për çdo vit $k$ pyesim:
      \begin{itemize}
        \item sa është probabiliteti i vdekjes \textbf{në atë vit}?
        \item sa vlen sot pagesa e atij viti?
      \end{itemize}
  \end{itemize}
  \onslide<4->{
  \begin{Keshille}
    Çmimi = shuma e (probabilitet $\times$ aktualizim $\times$ shumë), për çdo vit.
  \end{Keshille}}
\end{frame}

\begin{frame}{Sigurimi i jetës me afat (\emph{term life insurance})}
  \begin{Definicion}[(vlera aktuale e pritshme, \emph{EPV})]
    Për 1 € të paguar në fund të vitit të vdekjes, brenda $n$ vitesh:
    \[
      A^{1}_{x:\overline{n}|}=\sum_{k=0}^{n-1} v^{\,k+1}\;\frac{d_{x+k}}{l_x}
    \]
  \end{Definicion}
  \pause
  \begin{itemize}
    \item $k$: viti i vdekjes (0 = viti i parë).
    \item $\dfrac{d_{x+k}}{l_x}$: probabiliteti që vdekja të ndodhë pikërisht në vitin $k+1$.
    \item $v^{\,k+1}$: pagesa ndodh në \textbf{fund} të atij viti.
  \end{itemize}
\end{frame}

\begin{frame}{Pse $d_{x+k}/l_x$?}
  \begin{align*}
    \Pr(\text{vdes në vitin } k+1)
    &= \Pr(\text{gjallë në } x+k)\cdot\Pr(\text{vdes brenda vitit}\mid\text{gjallë}) \\
    \onslide<2->{&= {}_kp_x \cdot q_{x+k} \\}
    \onslide<3->{&= \frac{l_{x+k}}{l_x}\cdot\frac{d_{x+k}}{l_{x+k}} \\}
    \onslide<4->{&= \frac{d_{x+k}}{l_x}}
  \end{align*}
  \onslide<5->{\small Shënim: kjo probabilitet shkruhet edhe ${}_{k|}q_x$ (vdekje e shtyrë).}
\end{frame}

