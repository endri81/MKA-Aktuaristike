\begin{frame}{Pse jo vetëm Excel?}
  \begin{itemize}
    \item<1-> Një formulë e gabuar në një qelizë \textbf{nuk duket}.
    \item<2-> Nuk ka histori: kush ndryshoi çfarë, kur?
    \item<3-> 10\,000 polica $\times$ 1\,000 skenarë: Excel ngadalësohet.
    \item<4-> Auditori pyet: ``Si e llogaritët?'' Përgjigja duhet të jetë \textbf{e riprodhueshme}.
  \end{itemize}
  \onslide<5->{
  \begin{Keshille}
    Një skript R \textbf{është} dokumentimi i llogaritjes.
  \end{Keshille}}
\end{frame}

\begin{frame}[label=tps1]{Mendo -- diskuto me shokun -- ndaj (\emph{think--pair--share})}
  \begin{Ushtrim}[(3 minuta)]
    \begin{enumerate}
      \item \textbf{Mendo} (1 min): kujto një rast kur një tabelë Excel të dha rezultat të gabuar.
      \item \textbf{Diskuto} (1 min): me shokun ngjitur — ku ishte gabimi?
      \item \textbf{Ndaj} (1 min): dy çifte tregojnë para klasës.
    \end{enumerate}
  \end{Ushtrim}
  \pause
  \small Pse? Sepse e njëjta lloj gabimi në një kompani sigurimi
  kushton para dhe besueshmëri.
\end{frame}

\begin{frame}{Ku përdoret R në praktikën aktuariale?}
  \begin{itemize}
    \item<1-> \textbf{Tarifimi} (\emph{pricing}): sa kushton një policë?
    \item<2-> \textbf{Rezervat teknike} (\emph{technical reserves}): sa para duhet të mbajmë për dëmet e ardhshme?
    \item<3-> \textbf{Solvency II}: sa kapital duhet për skenarë të këqij?
    \item<4-> \textbf{IFRS 17}: si raportohen kontratat e sigurimit në bilanc?
    \item<5-> \textbf{Raportimi te rregullatori}: në Shqipëri, Autoriteti i Mbikëqyrjes Financiare (AMF).
  \end{itemize}
  \onslide<6->{\small\textcolor{gray}{Në të gjitha rastet: të dhëna $\rightarrow$ model $\rightarrow$ numër $\rightarrow$ vendim.}}
\end{frame}

