% ------------------------------------------------------------
\subsection{Problemi}
% ------------------------------------------------------------

\begin{frame}{Një pyetje nga kompania e sigurimit}
  \begin{itemize}
    \item<1-> Je aktuar i ri në një shoqëri sigurimesh jete në Tiranë.
    \item<2-> Drejtori të pyet:
  \end{itemize}
  \onslide<3->{
  \begin{Shembull}[(pyetja e ditës)]
    \centering\large
    ``Sa duhet të paguajë \textbf{sot} një klient \textbf{40 vjeç}\\
    për një sigurim jete \textbf{3-vjeçar} me shumë \textbf{100\,000 €}?''
  \end{Shembull}}
  \onslide<4->{
  \begin{Keshille}
    Mbaje mend këtë pyetje. Do t'i përgjigjemi \textbf{pa ndihmën e PC} në këtë orë,
    dhe \textbf{me R} në 6 rreshta kodi.
  \end{Keshille}}
\end{frame}

\begin{frame}{Çfarë na duhet për t'iu përgjigjur?}
