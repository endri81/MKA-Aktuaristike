\begin{frame}[fragile]{Instalimi dhe ngarkimi}
<<h5-install, eval=FALSE>>=
install.packages("ggplot2")   # once per computer (needs internet)
library(ggplot2)              # once per session, at the top of the script
@
<<h5-version>>=
packageVersion("ggplot2")     # which version am I using?
R.version.string
@
  \pause
  \small Shëno versionet në raport: rezultatet mund të ndryshojnë pak nga një version në tjetrin.
\end{frame}

