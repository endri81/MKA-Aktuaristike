% ============================================================
%  Java 1 · Ora 6 — Zgjidhjet (shtojca)
% ============================================================

<<h6sol-setup, include=FALSE>>=
hld <- read.csv(file.path(DATA, "albania_lifetables_HLD_1950_2011.csv"), check.names = FALSE)
alb <- hld[hld$TypeLT == 4, c("Year1", "Sex", "Age", "AgeInt", "q(x)")]
names(alb) <- c("year", "sex", "age", "n", "nqx")
mp <- read.csv(file.path(DATA, "motor_portfolio_synthetic.csv"))
cl <- read.csv(file.path(DATA, "individual_claims_synthetic.csv"))
epv_term <- function(qx, i = 0.05, n = length(qx)) {
  v <- 1 / (1 + i); kpx <- c(1, cumprod(1 - qx))[1:n]; sum(v^(1:n) * kpx * qx[1:n]) }
annuity_due <- function(qx, i = 0.05, n = length(qx)) {
  v <- 1 / (1 + i); kpx <- c(1, cumprod(1 - qx))[1:n]; sum(v^(0:(n - 1)) * kpx) }
@

\begin{frame}[label=zgjCovid]{Një përgjigje: COVID dhe tabelat e pensioneve}
  \begin{itemize}
    \item \textbf{Pro}: të dhënat janë reale; ulja e jetëgjatësisë ul detyrimet e fondit.
    \item \textbf{Kundër}: rënia ishte e përkohshme (2024 është mbi 2019). Një fond pensioni shikon trendin
          afatgjatë; nëse e ul jetëgjatësinë, rrezikon rezerva të pamjaftueshme.
    \item Praktika e zakonshme: vitet e pandemisë marrin peshë të reduktuar ose përjashtohen nga kalibrimi i trendit.
  \end{itemize}
  \vfill\kthehu{pyetjeCovid}
\end{frame}

\begin{frame}[fragile,label=zgjUsh6a]{Zgjidhja: Radha jote! (femrat 2011)}
<<sol-fem>>=
nq <- function(s) alb$nqx[alb$year == 2011 & alb$sex == s & alb$age == 40]
q_f <- 1 - (1 - nq(2))^(1 / 5);  q_m <- 1 - (1 - nq(1))^(1 / 5)
P <- function(q) 100000 * epv_term(rep(q, 5), 0.03) / annuity_due(rep(q, 5), 0.03)
round(c(q_female = q_f, P_female = P(q_f), P_male = P(q_m)), 5)
round(100 * (1 - P(q_f) / P(q_m)), 1)        # % cheaper for women
@
  \vfill\kthehu{ush6a}
\end{frame}

\begin{frame}[fragile,label=zgjSev]{Zgjidhja: Parashiko (ashpërsia)}
<<sol-sev>>=
pos <- mp$n_claims > 0
sum(mp$claim_amount_eur[pos]) / sum(mp$n_claims[pos])
@
  \begin{itemize}
    \item \textbf{Jo} saktësisht 900: është vlerësim nga një mostër e kufizuar dëmesh.
    \item Drejtimi (më shumë apo më pak) është i rastësishëm. Me më shumë dëme, vlerësimi afrohet te 900.
  \end{itemize}
  \vfill\kthehu{pyetjeSev}
\end{frame}

\begin{frame}[fragile,label=zgjNdrysho6]{Zgjidhja: Ndrysho parametrin (pragu)}
<<sol-thr>>=
share <- function(u) c(threshold = u,
                       pct_claims = round(100 * mean(cl$amount_eur > u), 2),
                       pct_cost   = round(100 * sum(cl$amount_eur[cl$amount_eur > u]) /
                                          sum(cl$amount_eur), 1))
t(sapply(c(10000, 20000, 50000), share))
@
  \small Pragu më i lartë: shumë më pak dëme, por ende një pjesë e madhe e kostos. Ky është ``bishti i rëndë''.
  \vfill\kthehu{ndrysho6}
\end{frame}
