\begin{frame}[fragile,label=sU7]{Zgjidhja U7}
  \begin{itemize}
    \item $\dfrac{\mu_{60}}{\mu_{50}}=c^{10}=2.75$ \;$\Rightarrow$\; $c=2.75^{1/10}\approx1.1065$.
    \item $B=\mu_{50}/c^{50}\approx 2.54\times10^{-5}$.
    \item $\mu_{70}=\mu_{60}\,c^{10}=0.0110\times2.75=0.03025$.
  \end{itemize}
<<sol7-u7>>=
cc <- (0.011 / 0.004)^(1 / 10)
round(cc, 4)                       # c
signif(0.004 / cc^50, 3)           # B
0.011 * cc^10                      # mu70
@
  \vfill\kthehu{qU7}
\end{frame}

\begin{frame}[fragile,label=sU8]{Zgjidhja U8}
  \begin{itemize}
    \item $N\sim\text{Bin}(1000,\,0.02)$: \; $E[N]=20$, \; $\mathrm{sd}(N)=\sqrt{1000\cdot0.02\cdot0.98}\approx4.43$.
  \end{itemize}
<<sol7-u8>>=
set.seed(2026)
deaths <- rbinom(10000, size = 1000, prob = 0.02)
round(c(mean = mean(deaths), sd = sd(deaths),
        p_over_30_sim = mean(deaths > 30),
        p_over_30_exact = 1 - pbinom(30, 1000, 0.02)), 4)
@
  \vfill\kthehu{qU8}
\end{frame}

\begin{frame}[fragile,label=sGab7]{Zgjidhja: raundi i shpejtë}
  \begin{enumerate}
    \item \texttt{NA} në \texttt{qx}: kontrollo të dhënat \textbf{para} llogaritjes: \texttt{stopifnot(!anyNA(qx))}.
    \item \texttt{v\^{}(0:3)}: sigurimi paguhet në fund të vitit $\Rightarrow$ \texttt{v\^{}(1:4)}.
    \item \texttt{A == NA} jep \texttt{NA}, dhe \texttt{if (NA)} jep gabim $\Rightarrow$ \texttt{is.na(A)}.
  \end{enumerate}
<<sol7-gab, error=TRUE>>=
A <- NA
if (A == NA) print("missing data")
@
  \vfill\kthehu{qGab7}
\end{frame}
